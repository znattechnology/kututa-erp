# Copiar para /opt/kututa/copias/r2.env e fazer chmod 600. Nunca vai para o git.
# Cloudflare › R2 › Manage API tokens › Create API token:
#   permissão «Object Read & Write», limitada ao bucket abaixo.
R2_ACCOUNT_ID=fc0cfcd5098d0414eee8b09f4602ea3d
R2_BUCKET=kututa-copias
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Dias que cada cópia fica guardada.
RETENCAO_DIARIA=30
RETENCAO_MENSAL=365
RETENCAO_LOCAL=3
