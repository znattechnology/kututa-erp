# Copiar para /opt/kututa/healthchecks.env e fazer chmod 600. Nunca vai para o git.
# URLs de ping dos checks em https://healthchecks.io (Projeto › Check › «Ping URL»).
#   kututa-vigia:  Period 5 minutes, Grace 10 minutes
#   kututa-copias: Cron «30 2 * * *», fuso UTC, Grace 2 hours
HC_VIGIA=https://hc-ping.com/
HC_COPIAS=https://hc-ping.com/

# Limites (opcionais)
# DISCO_MAX=85
# RAM_MIN_MB=300
# CERT_DIAS=14
# COPIA_MAX_HORAS=26
