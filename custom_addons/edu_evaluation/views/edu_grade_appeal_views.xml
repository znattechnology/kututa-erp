<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_grade_appeal_list" model="ir.ui.view">
        <field name="name">edu.grade.appeal.list</field>
        <field name="model">edu.grade.appeal</field>
        <field name="arch" type="xml">
            <list string="Reapreciações">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="original_score"/>
                <field name="new_score"/>
                <field name="state" widget="badge" decoration-success="state == 'granted'" decoration-danger="state == 'denied'"/>
            </list>
        </field>
    </record>
    <record id="edu_grade_appeal_form" model="ir.ui.view">
        <field name="name">edu.grade.appeal.form</field>
        <field name="model">edu.grade.appeal</field>
        <field name="arch" type="xml">
            <form string="Reapreciação">
                <header>
                    <button name="action_review" type="object" string="Pôr em apreciação" invisible="state != 'pending'"/>
                    <button name="action_grant" type="object" string="Deferir" class="btn-primary" invisible="state not in ('pending', 'review')"/>
                    <button name="action_deny" type="object" string="Indeferir" invisible="state not in ('pending', 'review')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="grade_id" options="{'no_create': True}" readonly="id"/>
                            <field name="student_id"/>
                            <field name="subject_id"/>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="original_score"/>
                            <field name="new_score" readonly="state not in ('pending', 'review')"/>
                            <field name="decided_by_id" invisible="not decided_by_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="decision"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_edu_grade_appeal" model="ir.actions.act_window">
        <field name="name">Reapreciações</field>
        <field name="res_model">edu.grade.appeal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="edu_rdec_form" model="ir.ui.view">
        <field name="name">edu.rdec.form</field>
        <field name="model">edu.rdec</field>
        <field name="arch" type="xml">
            <form string="RDEC">
                <header>
                    <button name="action_fill_areas" type="object" string="Carregar as áreas"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="enrollment_id" options="{'no_create': True}"/>
                            <field name="trimester_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="subject_id"/>
                            <field name="level"/>
                            <field name="observations"/>
                        </list>
                    </field>
                    <group string="Apreciação global"><field name="appreciation" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="edu_rdec_list" model="ir.ui.view">
        <field name="name">edu.rdec.list</field>
        <field name="model">edu.rdec</field>
        <field name="arch" type="xml">
            <list string="RDEC">
                <field name="class_id"/>
                <field name="student_id"/>
                <field name="trimester_id"/>
            </list>
        </field>
    </record>
    <record id="action_edu_rdec" model="ir.actions.act_window">
        <field name="name">RDEC (iniciação)</field>
        <field name="res_model">edu.rdec</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
