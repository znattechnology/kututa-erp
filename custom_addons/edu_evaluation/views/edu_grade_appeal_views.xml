<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_grade_appeal_list" model="ir.ui.view">
        <field name="name">edu.grade.appeal.list</field>
        <field name="model">edu.grade.appeal</field>
        <field name="arch" type="xml">
            <list string="Reapreciações" decoration-muted="state in ('denied', 'rejected')" decoration-danger="late">
                <field name="request_date"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="trimester_id"/>
                <field name="answer_deadline"/>
                <field name="late" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'granted'" decoration-danger="state in ('denied', 'rejected')"
                       decoration-warning="state in ('pending', 'review', 'appealed')"/>
            </list>
        </field>
    </record>
    <record id="edu_grade_appeal_form" model="ir.ui.view">
        <field name="name">edu.grade.appeal.form</field>
        <field name="model">edu.grade.appeal</field>
        <field name="arch" type="xml">
            <form string="Reapreciação">
                <header>
                    <button name="action_admit" type="object" string="Admitir" class="btn-primary" invisible="state != 'pending'" groups="edu_core.group_edu_manager"/>
                    <button name="action_reject" type="object" string="Indeferir liminarmente" invisible="state != 'pending'" groups="edu_core.group_edu_manager"/>
                    <button name="action_grant" type="object" string="Deferir" class="btn-primary" invisible="state not in ('review', 'appealed')" groups="edu_core.group_edu_manager"/>
                    <button name="action_deny" type="object" string="Sem provimento" invisible="state not in ('review', 'appealed')" groups="edu_core.group_edu_manager"/>
                    <button name="action_notify" type="object" string="Interessado informado" invisible="state not in ('granted', 'denied', 'rejected') or notified_date"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,review,granted"/>
                </header>
                <sheet>
                    <group>
                        <group string="Pedido">
                            <field name="enrollment_id" options="{'no_create': True}" readonly="id"/>
                            <field name="student_id"/>
                            <field name="subject_id" options="{'no_create': True}" readonly="id"/>
                            <field name="trimester_id" options="{'no_create': True}" readonly="id"/>
                            <field name="requester_type"/>
                            <field name="requester_name"/>
                            <field name="regime" invisible="1"/>
                        </group>
                        <group string="Prazos">
                            <field name="posting_date"/>
                            <field name="request_date"/>
                            <field name="deadline_date" invisible="not deadline_date"/>
                            <field name="late" invisible="not late"/>
                            <field name="answer_deadline"/>
                            <field name="notified_date" invisible="not notified_date"/>
                        </group>
                    </group>
                    <group string="Fundamentação">
                        <field name="reason" nolabel="1" colspan="2"/>
                        <field name="attachment_ids" widget="many2many_binary" colspan="2"/>
                    </group>
                    <group string="Decisão da direcção" invisible="state != 'pending'" groups="edu_core.group_edu_manager">
                        <field name="meeting_date"/>
                        <field name="decision" string="Motivo (indeferimento liminar)" placeholder="Fora de prazo, sem fundamento…"/>
                    </group>
                    <group string="Apreciação" invisible="state == 'pending'">
                        <group>
                            <field name="admitted_date" invisible="not admitted_date"/>
                            <field name="meeting_date"/>
                            <field name="minutes_ref"/>
                        </group>
                        <group>
                            <field name="grade_id" options="{'no_create': True}" domain="[('enrollment_id', '=', enrollment_id), ('subject_id', '=', subject_id)]"
                                   readonly="state not in ('review', 'appealed')"/>
                            <field name="original_score" invisible="not grade_id"/>
                            <field name="new_score" readonly="state not in ('review', 'appealed')"/>
                            <field name="decided_by_id" invisible="not decided_by_id"/>
                        </group>
                        <field name="decision" placeholder="Deliberação (relatório que integra a acta)" colspan="2"/>
                        <field name="pedagogical_decision" placeholder="Decisão do Conselho Pedagógico" invisible="state != 'appealed' and not pedagogical_decision" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_edu_grade_appeal" model="ir.actions.act_window">
        <field name="name">Reapreciações</field>
        <field name="res_model">edu.grade.appeal</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="edu_rdec_form" model="ir.ui.view">
        <field name="name">edu.rdec.form</field>
        <field name="model">edu.rdec</field>
        <field name="arch" type="xml">
            <form string="RDEC">
                <header>
                    <button name="action_fill_areas" type="object" string="Carregar as áreas"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="enrollment_id" options="{'no_create': True}"/>
                            <field name="trimester_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="subject_id"/>
                            <field name="level"/>
                            <field name="observations"/>
                        </list>
                    </field>
                    <group string="Apreciação global"><field name="appreciation" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="edu_rdec_list" model="ir.ui.view">
        <field name="name">edu.rdec.list</field>
        <field name="model">edu.rdec</field>
        <field name="arch" type="xml">
            <list string="RDEC">
                <field name="class_id"/>
                <field name="student_id"/>
                <field name="trimester_id"/>
            </list>
        </field>
    </record>
    <record id="action_edu_rdec" model="ir.actions.act_window">
        <field name="name">RDEC (iniciação)</field>
        <field name="res_model">edu.rdec</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
