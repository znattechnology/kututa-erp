<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_time_slot_list" model="ir.ui.view">
        <field name="name">edu.time.slot.list</field>
        <field name="model">edu.time.slot</field>
        <field name="arch" type="xml">
            <list string="Tempos lectivos" editable="bottom" decoration-muted="is_break">
                <field name="shift_id"/>
                <field name="name"/>
                <field name="hour_from" widget="float_time"/>
                <field name="hour_to" widget="float_time"/>
                <field name="is_break"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="edu_time_slot_search" model="ir.ui.view">
        <field name="name">edu.time.slot.search</field>
        <field name="model">edu.time.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="shift_id"/>
                <group>
                    <filter name="group_shift" string="Turno" context="{'group_by': 'shift_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_edu_time_slot" model="ir.actions.act_window">
        <field name="name">Tempos lectivos</field>
        <field name="res_model">edu.time.slot</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_shift': 1}</field>
    </record>

    <record id="edu_shift_list_timetable" model="ir.ui.view">
        <field name="name">edu.shift.list.timetable</field>
        <field name="model">edu.shift</field>
        <field name="inherit_id" ref="edu_core.edu_shift_list"/>
        <field name="arch" type="xml">
            <field name="hour_to" position="after">
                <button name="action_generate_slots" type="object" string="Criar a grelha de tempos" icon="fa-th"/>
            </field>
        </field>
    </record>

    <menuitem id="menu_edu_time_slot" action="action_edu_time_slot" parent="edu_core.menu_edu_config" sequence="45"/>
</odoo>
