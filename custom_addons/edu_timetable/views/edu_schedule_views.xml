<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_schedule_list" model="ir.ui.view">
        <field name="name">edu.schedule.list</field>
        <field name="model">edu.schedule</field>
        <field name="arch" type="xml">
            <list string="Horários" editable="bottom">
                <field name="class_id" optional="hide" options="{'no_create': True}"/>
                <field name="academic_year_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="weekday"/>
                <field name="time_slot_id" options="{'no_create': True}"/>
                <field name="hour_from" widget="float_time" options="{'numeric': True}"/>
                <field name="hour_to" widget="float_time" options="{'numeric': True}"/>
                <field name="subject_id" options="{'no_create': True}"/>
                <field name="teacher_id" options="{'no_create': True}"/>
                <field name="room_id" options="{'no_create': True}"/>
                <field name="trimester_id" optional="hide" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="edu_schedule_form" model="ir.ui.view">
        <field name="name">edu.schedule.form</field>
        <field name="model">edu.schedule</field>
        <field name="arch" type="xml">
            <form string="Tempo do horário">
                <sheet>
                    <group>
                        <group>
                            <field name="class_id" options="{'no_create': True}"/>
                            <field name="subject_id" options="{'no_create': True}"/>
                            <field name="teacher_id" options="{'no_create': True}"/>
                            <field name="room_id" options="{'no_create': True}"/>
                            <field name="academic_year_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="weekday"/>
                            <field name="time_slot_id" options="{'no_create': True}"/>
                            <field name="hour_from" widget="float_time" options="{'numeric': True}"/>
                            <field name="hour_to" widget="float_time" options="{'numeric': True}"/>
                            <field name="trimester_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Substituições" name="replacements">
                            <field name="replacement_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="original_teacher_id" readonly="1"/>
                                    <field name="replacement_teacher_id" options="{'no_create': True}"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                        <page string="Aulas sem realização" name="exceptions">
                            <field name="exception_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="edu_schedule_search" model="ir.ui.view">
        <field name="name">edu.schedule.search</field>
        <field name="model">edu.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="class_id"/>
                <field name="teacher_id"/>
                <field name="room_id"/>
                <field name="subject_id"/>
                <filter name="current_year" string="Ano em curso" domain="[('academic_year_id.is_current', '=', True)]"/>
                <group>
                    <filter name="group_class" string="Turma" context="{'group_by': 'class_id'}"/>
                    <filter name="group_teacher" string="Professor" context="{'group_by': 'teacher_id'}"/>
                    <filter name="group_weekday" string="Dia" context="{'group_by': 'weekday'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_schedule" model="ir.actions.act_window">
        <field name="name">Tempos por turma</field>
        <field name="res_model">edu.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current_year': 1, 'search_default_group_class': 1}</field>
    </record>

    <record id="edu_schedule_replacement_list" model="ir.ui.view">
        <field name="name">edu.schedule.replacement.list</field>
        <field name="model">edu.schedule.replacement</field>
        <field name="arch" type="xml">
            <list string="Substituições">
                <field name="date"/>
                <field name="class_id"/>
                <field name="schedule_id"/>
                <field name="original_teacher_id"/>
                <field name="replacement_teacher_id"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <!-- As substituições num quadro por dia: a hora e a disciplina, a turma, quem falta e quem substitui. -->
    <record id="edu_schedule_replacement_kanban" model="ir.ui.view">
        <field name="name">edu.schedule.replacement.kanban</field>
        <field name="model">edu.schedule.replacement</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_repl_kanban" default_group_by="date:day" default_order="date, hour_from"
                    records_draggable="0" quick_create="0" group_create="0" group_delete="0" group_edit="0">
                <field name="time_label"/>
                <field name="class_label"/>
                <field name="reason"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_repl_card">
                            <div class="d-flex justify-content-between gap-2">
                                <span class="fw-semibold text-nowrap" t-out="record.time_label.raw_value"/>
                                <span class="small text-muted text-truncate" t-out="record.class_label.raw_value"/>
                            </div>
                            <div class="fw-semibold text-truncate"><field name="subject_id"/></div>
                            <div class="o_edu_repl_who small">
                                <span class="text-muted">Falta</span>
                                <span class="text-truncate text-decoration-line-through text-muted"><field name="original_teacher_id"/></span>
                                <span class="text-muted">Dá a aula</span>
                                <span class="text-truncate fw-semibold"><field name="replacement_teacher_id"/></span>
                            </div>
                            <div t-if="record.reason.raw_value" class="small text-muted text-truncate" t-out="record.reason.raw_value"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="edu_schedule_replacement_form" model="ir.ui.view">
        <field name="name">edu.schedule.replacement.form</field>
        <field name="model">edu.schedule.replacement</field>
        <field name="arch" type="xml">
            <form string="Substituição">
                <sheet>
                    <group>
                        <group string="Aula">
                            <field name="date"/>
                            <field name="filter_class_id" string="Turma" options="{'no_create': True}" placeholder="Todas"/>
                            <field name="filter_teacher_id" string="Professor(a) que falta" options="{'no_create': True}"
                                   placeholder="Todos"/>
                            <field name="weekday" invisible="1"/>
                            <field name="schedule_id" options="{'no_create': True, 'no_open': True}"
                                   context="{'edu_schedule_show_class': True}"/>
                        </group>
                        <group string="Substituto(a)">
                            <field name="free_teacher_ids" invisible="1"/>
                            <field name="replacement_teacher_id" options="{'no_create': True}"
                                   placeholder="Um professor livre a essa hora" readonly="not schedule_id"/>
                            <field name="reason"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Escolha a data e a turma ou o professor que falta: em «Aula» aparecem só os tempos desse dia.
                        Em «Substituto(a)» aparecem só os professores livres a essa hora (sem aula e sem outra
                        substituição). A aula prevista passa para o substituto, que faz a chamada e escreve o sumário.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="edu_schedule_replacement_search" model="ir.ui.view">
        <field name="name">edu.schedule.replacement.search</field>
        <field name="model">edu.schedule.replacement</field>
        <field name="arch" type="xml">
            <search>
                <field name="class_id"/>
                <field name="original_teacher_id"/>
                <field name="replacement_teacher_id"/>
                <filter name="today" string="Hoje" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="upcoming" string="De hoje em diante" domain="[('date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="date" string="Data" date="date"/>
                <group>
                    <filter name="group_original" string="Professor que falta" context="{'group_by': 'original_teacher_id'}"/>
                    <filter name="group_replacement" string="Substituto" context="{'group_by': 'replacement_teacher_id'}"/>
                    <filter name="group_class" string="Turma" context="{'group_by': 'class_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_schedule_replacement" model="ir.actions.act_window">
        <field name="name">Substituições</field>
        <field name="res_model">edu.schedule.replacement</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="edu_schedule_replacement_search"/>
        <field name="context">{'search_default_upcoming': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Não há substituições de hoje em diante</p>
            <p>Use «Novo» quando um professor falta: escolha a data, a turma ou o professor, a aula e um substituto
            livre a essa hora. O substituto faz a chamada e escreve o sumário. Para ver as passadas, tire o filtro
            «De hoje em diante».</p>
        </field>
    </record>

    <!-- Editor de horários (acção cliente): as disciplinas arrastam-se para a grelha da turma. -->
    <record id="action_edu_schedule_editor" model="ir.actions.client">
        <field name="name">Editor de horários</field>
        <field name="tag">edu_timetable.schedule_editor</field>
    </record>

    <!-- Horários das turmas: a mesma grelha, só para consultar e imprimir (como a página «Horários» do secPed). -->
    <record id="action_edu_schedule_view" model="ir.actions.client">
        <field name="name">Horários das turmas</field>
        <field name="tag">edu_timetable.schedule_editor</field>
        <field name="context">{'edu_readonly': True}</field>
    </record>

    <menuitem id="menu_edu_schedule_editor" action="action_edu_schedule_editor" parent="edu_core.menu_edu_academic" sequence="35"/>
    <menuitem id="menu_edu_schedule" action="action_edu_schedule_view" parent="edu_core.menu_edu_academic" sequence="40"/>
    <menuitem id="menu_edu_schedule_replacement" action="action_edu_schedule_replacement" parent="edu_core.menu_edu_academic" sequence="45"/>
</odoo>
