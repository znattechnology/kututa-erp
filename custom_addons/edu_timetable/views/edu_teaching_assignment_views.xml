<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_teaching_assignment_list" model="ir.ui.view">
        <field name="name">edu.teaching.assignment.list</field>
        <field name="model">edu.teaching.assignment</field>
        <field name="arch" type="xml">
            <list string="Colocação de professores" editable="bottom" decoration-warning="not qualified">
                <field name="class_id" options="{'no_create': True}"/>
                <field name="academic_year_id" column_invisible="1"/>
                <field name="subject_id" options="{'no_create': True}"/>
                <field name="teacher_id" options="{'no_create': True}"/>
                <field name="trimester_id" optional="show" options="{'no_create': True}"/>
                <field name="weekly_hours" optional="show"/>
                <field name="qualified" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="edu_teaching_assignment_search" model="ir.ui.view">
        <field name="name">edu.teaching.assignment.search</field>
        <field name="model">edu.teaching.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="teacher_id"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <filter name="current_year" string="Ano em curso" domain="[('academic_year_id.is_current', '=', True)]"/>
                <group>
                    <filter name="group_teacher" string="Professor" context="{'group_by': 'teacher_id'}"/>
                    <filter name="group_class" string="Turma" context="{'group_by': 'class_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_edu_teaching_assignment" model="ir.actions.act_window">
        <field name="name">Colocação de professores</field>
        <field name="res_model">edu.teaching.assignment</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_current_year': 1}</field>
    </record>

    <menuitem id="menu_edu_teaching_assignment" action="action_edu_teaching_assignment" parent="edu_core.menu_edu_academic" sequence="30"/>
</odoo>
