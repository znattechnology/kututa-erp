<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edu_timetable.ScheduleEditor">
        <div class="o_action o_edu_schedule_editor">
            <Layout display="this.display">
                <div class="o_edu_se_body">
                    <div class="o_edu_se_toolbar">
                        <div class="btn-group" role="tablist" aria-label="Vista">
                            <button type="button" class="btn" role="tab" t-att-aria-selected="this.state.mode === 'class'"
                                    t-att-class="this.state.mode === 'class' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.setMode('class')">Por turma</button>
                            <button type="button" class="btn" role="tab" t-att-aria-selected="this.state.mode === 'teacher'"
                                    t-att-class="this.state.mode === 'teacher' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.setMode('teacher')">Por professor</button>
                        </div>
                        <select t-if="this.state.mode === 'class'" class="form-select" aria-label="Turma"
                                t-on-change="(ev) => this.onClassChange(ev)">
                            <option value="">Escolher a turma…</option>
                            <t t-foreach="this.state.options.classes" t-as="c" t-key="c.id">
                                <option t-att-value="c.id" t-att-selected="c.id === this.state.classId" t-out="c.name"/>
                            </t>
                        </select>
                        <select t-else="" class="form-select" aria-label="Professor"
                                t-on-change="(ev) => this.onTeacherChange(ev)">
                            <option value="">Escolher o professor…</option>
                            <t t-foreach="this.state.options.teachers" t-as="p" t-key="p.id">
                                <option t-att-value="p.id" t-att-selected="p.id === this.state.teacherId" t-out="p.name"/>
                            </t>
                        </select>
                        <select t-if="this.state.options.trimesters.length" class="form-select" aria-label="Período"
                                t-on-change="(ev) => this.onTrimesterChange(ev)">
                            <option value="">Ano todo</option>
                            <t t-foreach="this.state.options.trimesters" t-as="t" t-key="t.id">
                                <option t-att-value="t.id" t-att-selected="t.id === this.state.trimesterId">Só o <t t-out="t.name"/></option>
                            </t>
                        </select>
                        <div t-if="this.state.mode === 'class' and this.state.data" class="form-check ms-1">
                            <input class="form-check-input" type="checkbox" id="o_edu_se_saturday"
                                   t-att-checked="this.state.saturday" t-on-change="(ev) => this.state.saturday = ev.target.checked"/>
                            <label class="form-check-label" for="o_edu_se_saturday">Sábado</label>
                        </div>
                        <span class="flex-grow-1"/>
                        <span t-if="this.state.options.year" class="text-muted">Ano lectivo <t t-out="this.state.options.year"/></span>
                        <button t-if="this.state.mode === 'class' and this.state.data" type="button" class="btn btn-secondary"
                                t-on-click="() => this.print()">
                            <i class="oi me-1" data-icon="print" aria-hidden="true"/>Imprimir
                        </button>
                    </div>

                    <t t-if="!this.state.data">
                        <p class="o_edu_se_empty" t-if="this.state.mode === 'class'">Escolha a turma cujo horário quer montar.</p>
                        <p class="o_edu_se_empty" t-else="">Escolha um professor para ver as aulas dele em todas as turmas.</p>
                    </t>

                    <t t-elif="this.state.mode === 'class'">
                        <t t-set="summary" t-value="this.summary"/>
                        <p class="o_edu_se_status">
                            <strong t-out="this.state.data.class.name"/>
                            <span class="text-muted">
                                <t t-if="this.state.data.class.course"> · <t t-out="this.state.data.class.course"/></t>
                                <t t-out="this.state.data.class.room ? ' · ' + this.state.data.class.room : ' · sem sala fixa'"/>
                                <t t-if="this.state.data.class.shift"> · <t t-out="this.state.data.class.shift"/></t>
                            </span>
                            <br/>
                            <t t-if="summary.planned">
                                <t t-out="summary.placed"/> de <t t-out="summary.planned"/> tempos por semana colocados
                                <span t-if="summary.missing.length" class="text-danger">
                                    — faltam <t t-out="summary.planned - summary.placed"/>: <t t-out="summary.missing.join(', ')"/></span>
                                <span t-else="" class="text-success"> — completo</span>.
                            </t>
                            <span t-if="summary.extra.length" class="text-warning"> Acima do plano: <t t-out="summary.extra.join(', ')"/>.</span>
                            <span t-if="summary.withoutTeacher" class="text-muted">
                                <t t-out="summary.withoutTeacher === 1 ? ' Uma disciplina sem professor' : ' ' + summary.withoutTeacher + ' disciplinas sem professor'"/>:
                                as aulas ficam sem professor até à colocação.</span>
                        </p>

                        <div class="o_edu_se_main">
                            <aside class="o_edu_se_subjects" aria-label="Disciplinas da turma">
                                <p t-if="!this.subjects.length" class="text-muted">A turma não tem plano curricular para a sua classe.</p>
                                <ul t-else="" class="list-unstyled m-0">
                                    <t t-foreach="this.subjects" t-as="subject" t-key="subject.id">
                                        <li>
                                            <button type="button" class="o_edu_se_subject" draggable="true"
                                                    t-att-class="{ o_selected: subject.id === this.state.selectedSubjectId }"
                                                    t-att-aria-pressed="subject.id === this.state.selectedSubjectId"
                                                    t-on-click="() => this.toggleSubject(subject)"
                                                    t-on-dragstart="(ev) => this.onDragSubject(ev, subject)"
                                                    t-on-dragend="() => this.onDragEnd()">
                                                <span class="d-flex gap-2">
                                                    <span class="flex-grow-1 text-truncate fw-bold" t-out="subject.name"/>
                                                    <span t-att-class="this.subjectState(subject)" class="text-nowrap">
                                                        <t t-out="subject.planned ? subject.placed + '/' + subject.planned : subject.placed + ', fora do plano'"/>
                                                    </span>
                                                </span>
                                                <span class="d-block text-truncate small" t-att-class="subject.teacher ? 'text-muted' : 'text-danger'"
                                                      t-out="subject.teacher or 'Sem professor'"/>
                                            </button>
                                        </li>
                                    </t>
                                </ul>
                                <p class="o_edu_se_hint">
                                    <t t-if="this.selectedSubject">A colocar <strong t-out="this.selectedSubject.name"/>: clique numa célula livre. Clique de novo na disciplina para parar.</t>
                                    <t t-else="">Arraste uma disciplina para a grelha, ou clique nela e depois numa célula livre. As aulas também se arrastam para outra célula. «2/3» são os tempos colocados face ao plano.</t>
                                </p>
                            </aside>
                            <div class="o_edu_se_grid_wrap">
                                <t t-call="edu_timetable.ScheduleEditorGrid"/>
                            </div>
                        </div>
                    </t>

                    <t t-else="">
                        <p class="o_edu_se_status">
                            <strong t-out="this.state.data.teacher.name"/>
                            <span class="text-muted"> · </span>
                            <span t-att-class="this.state.data.teacher.load > this.state.data.teacher.load_max ? 'text-danger' : 'text-muted'">
                                <t t-out="this.state.data.teacher.load"/> de <t t-out="this.state.data.teacher.load_max"/> tempos semanais</span>
                        </p>
                        <p t-if="!this.state.data.lessons.length" class="o_edu_se_empty">
                            <t t-out="this.state.data.teacher.name"/> ainda não tem aulas no horário.</p>
                        <div t-else="" class="o_edu_se_grid_wrap">
                            <t t-call="edu_timetable.ScheduleEditorGrid"/>
                        </div>
                    </t>
                </div>
            </Layout>
        </div>
    </t>

    <!-- A grelha da semana, no estilo da pauta: tempos na vertical, dias na horizontal. -->
    <t t-name="edu_timetable.ScheduleEditorGrid">
        <p t-if="!this.rows.length" class="o_edu_se_empty">
            A turma não tem turno com tempos lectivos: indique o turno da turma ou crie os tempos lectivos do turno.</p>
        <table t-else="" class="o_edu_se_grid">
            <thead>
                <tr>
                    <th class="o_edu_se_hour">Hora</th>
                    <th t-foreach="this.days" t-as="day" t-key="day.code" t-out="day.name"/>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="this.rows" t-as="row" t-key="row.from">
                    <th class="o_edu_se_hour" t-out="row.label"/>
                    <t t-foreach="row.cells" t-as="cell" t-key="cell.key">
                        <td t-if="cell.lesson" class="o_edu_se_lesson">
                            <div t-if="cell.first" t-att-draggable="this.state.mode === 'class' ? 'true' : 'false'"
                                 t-att-class="{ o_dragging: this.state.drag and this.state.drag.lessonId === cell.lesson.id }"
                                 t-on-dragstart="(ev) => this.onDragLesson(ev, cell.lesson)"
                                 t-on-dragend="() => this.onDragEnd()">
                                <t t-if="this.state.mode === 'class'">
                                    <strong t-out="cell.lesson.subject"/>
                                    <span class="d-block" t-att-class="cell.lesson.teacher ? '' : 'text-danger'"
                                          t-out="this.lessonDetail(cell.lesson)"/>
                                    <button type="button" class="btn btn-link o_edu_se_remove" title="Retirar a aula"
                                            t-att-aria-label="'Retirar ' + cell.lesson.subject"
                                            t-on-click="() => this.remove(cell.lesson)">
                                        <i class="oi" data-icon="close" aria-hidden="true"/>
                                    </button>
                                </t>
                                <a t-else="" href="#" class="o_edu_se_link" t-on-click.prevent="() => this.openClass(cell.lesson.class_id)"
                                   title="Abrir o horário da turma">
                                    <strong t-out="cell.lesson.subject"/>
                                    <span class="d-block" t-out="this.lessonDetail(cell.lesson)"/>
                                </a>
                                <span t-if="cell.lesson.trimester" class="d-block small text-muted" t-out="cell.lesson.trimester"/>
                            </div>
                        </td>
                        <td t-elif="this.state.mode === 'class'" class="o_edu_se_free"
                            t-att-class="{
                                o_ready: (this.state.drag or this.state.selectedSubjectId) and !cell.clash,
                                o_clash: cell.clash,
                                o_target: this.state.dropTarget === cell.key,
                            }"
                            t-att-title="cell.clash or ''"
                            t-on-click="() => this.onClickCell(cell)"
                            t-on-dragover="(ev) => this.onDragOver(ev, cell)"
                            t-on-dragleave="() => this.state.dropTarget = null"
                            t-on-drop="(ev) => this.onDrop(ev, cell)">
                            <span t-if="cell.clash" class="small" t-out="cell.clash"/>
                        </td>
                        <td t-else=""/>
                    </t>
                </tr>
            </tbody>
        </table>
    </t>

</templates>
