<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- O Painel da secretaria (acção cliente), como o dos Serviços Académicos do secPed: o que está por tratar, os
         números do ano, os alunos por classe, as turmas e os próximos eventos. É o primeiro menu da Secretaria
         Express, por isso a aplicação abre nele. -->
    <record id="action_secretaria_home" model="ir.actions.client">
        <field name="name">Painel</field>
        <field name="tag">edu_roles.secretaria_home</field>
    </record>
    <menuitem id="menu_secretaria_home" name="Painel" action="action_secretaria_home" parent="edu_core.menu_edu_root"
              sequence="0" groups="edu_core.group_edu_user"/>
</odoo>
