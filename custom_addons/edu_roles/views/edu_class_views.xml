<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- As turmas em cartões (com o painel dos anos lectivos à esquerda, como a lista): a designação e o curso, o
         turno e a sala, o director de turma (ou por nomear), os alunos face às vagas e o estado do horário. -->
    <record id="edu_class_kanban" model="ir.ui.view">
        <field name="name">edu.class.kanban</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_class_kanban" default_order="class_number, name">
                <field name="director_id"/>
                <field name="academic_year_id"/>
                <field name="edu_is_current"/>
                <field name="room_id"/>
                <field name="shift_id"/>
                <field name="capacity"/>
                <field name="student_count"/>
                <field name="edu_occupancy"/>
                <field name="edu_occupancy_width"/>
                <field name="edu_lessons"/>
                <field name="edu_no_teacher"/>
                <field name="edu_no_schedule"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_class_card">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="min-w-0">
                                    <field name="edu_label" class="o_edu_class_name"/>
                                    <div class="small text-muted text-truncate">
                                        <field name="course_id"/><t t-if="!record.edu_is_current.raw_value">, <field name="academic_year_id"/></t>
                                    </div>
                                </div>
                                <span t-if="record.edu_no_schedule.raw_value" class="badge text-bg-danger">Sem horário</span>
                            </div>
                            <div class="o_edu_class_facts">
                                <span t-if="record.shift_id.raw_value"><i class="oi me-1" data-icon="schedule" aria-hidden="true"/><field name="shift_id"/></span>
                                <span t-if="record.room_id.raw_value"><i class="oi me-1" data-icon="location_on" aria-hidden="true"/><field name="room_id"/></span>
                            </div>
                            <div class="small">
                                <t t-if="record.director_id.raw_value"><span class="text-muted">Director(a):</span> <field name="director_id"/></t>
                                <span t-else="" class="text-warning"><i class="oi me-1" data-icon="warning" aria-hidden="true"/>Director(a) de turma por nomear</span>
                            </div>
                            <div>
                                <div class="d-flex justify-content-between small">
                                    <span class="text-muted">Alunos</span>
                                    <span t-att-class="{'text-danger fw-semibold': record.capacity.raw_value and record.student_count.raw_value > record.capacity.raw_value}">
                                        <t t-out="record.student_count.raw_value"/> de <t t-out="record.capacity.raw_value"/>
                                    </span>
                                </div>
                                <span class="o_edu_meter" t-att-class="{'o_edu_meter_bad': record.edu_occupancy.raw_value > 100, 'o_edu_meter_warn': record.edu_occupancy.raw_value >= 90 and record.edu_occupancy.raw_value &lt;= 100}">
                                    <span t-att-style="'width: ' + record.edu_occupancy_width.raw_value + '%'"/>
                                </span>
                            </div>
                            <div class="small text-muted">
                                <t t-if="record.edu_lessons.raw_value">
                                    <i class="oi me-1" data-icon="calendar_today" aria-hidden="true"/><t t-out="record.edu_lessons.raw_value"/> tempos por semana
                                    <span t-if="record.edu_no_teacher.raw_value" class="text-warning">, <t t-out="record.edu_no_teacher.raw_value"/> sem professor</span>
                                </t>
                                <t t-elif="!record.edu_no_schedule.raw_value">Estágio: sem grelha semanal</t>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="edu_core.action_edu_class" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- As salas em cartões: o código, o tipo, a lotação, o edifício e o equipamento, o uso semanal pelos horários
         deste ano, as turmas que lá têm aulas em cada turno (com o aviso quando a turma é maior do que a sala) e os
         turnos em que estão livres. -->
    <record id="edu_room_kanban" model="ir.ui.view">
        <field name="name">edu.room.kanban</field>
        <field name="model">edu.room</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_room_kanban">
                <field name="code"/>
                <field name="room_type"/>
                <field name="building_id"/>
                <field name="floor"/>
                <field name="has_projector"/>
                <field name="has_ac"/>
                <field name="edu_usage"/>
                <field name="edu_week_used"/>
                <field name="edu_week_total"/>
                <field name="edu_week_width"/>
                <field name="edu_free_shifts"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_room_card">
                            <div class="d-flex align-items-start gap-3">
                                <span class="o_edu_room_code" t-out="record.code.raw_value or '—'"/>
                                <div class="flex-grow-1 min-w-0">
                                    <field name="name" class="o_edu_room_name"/>
                                    <div class="small text-muted"><field name="room_type"/>, <field name="capacity"/> lugares</div>
                                </div>
                            </div>
                            <div class="o_edu_room_facts">
                                <span t-if="record.building_id.raw_value"><i class="oi me-1" data-icon="location_on" aria-hidden="true"/><field name="building_id"/><t t-if="record.floor.raw_value">, piso <field name="floor"/></t></span>
                                <span t-if="record.has_projector.raw_value"><i class="oi me-1" data-icon="videocam" aria-hidden="true"/>Projector</span>
                                <span t-if="record.has_ac.raw_value"><i class="oi me-1" data-icon="ac_unit" aria-hidden="true"/>Ar condicionado</span>
                            </div>
                            <div t-if="record.edu_week_total.raw_value">
                                <div class="d-flex justify-content-between small">
                                    <span class="text-muted">Uso semanal</span>
                                    <span><t t-out="record.edu_week_used.raw_value"/> de <t t-out="record.edu_week_total.raw_value"/> tempos</span>
                                </div>
                                <span class="o_edu_meter"><span t-att-style="'width: ' + record.edu_week_width.raw_value + '%'"/></span>
                            </div>
                            <ul t-if="record.edu_usage.raw_value and record.edu_usage.raw_value.length" class="o_edu_room_usage">
                                <li t-foreach="record.edu_usage.raw_value" t-as="use" t-key="use.id"
                                    t-att-title="use.label + ': ' + use.lessons + ' aulas por semana, ' + use.students + ' alunos'">
                                    <span class="text-muted" t-out="use.shift"/>
                                    <span class="fw-semibold text-truncate" t-out="use.label"/>
                                    <span t-att-class="use.over ? 'text-danger fw-semibold' : 'text-muted'">
                                        <t t-out="use.lessons"/> aulas<t t-if="use.over">, <t t-out="use.students"/> alunos</t>
                                    </span>
                                </li>
                            </ul>
                            <p t-else="" class="mb-0 small text-muted">Sem aulas no horário este ano.</p>
                            <div t-if="record.edu_free_shifts.raw_value" class="small text-success">
                                <i class="oi me-1" data-icon="check_circle" aria-hidden="true"/>Livre: <t t-out="record.edu_free_shifts.raw_value"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="edu_core.action_edu_room" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Professores por disciplina em cartões (as turmas à esquerda): a disciplina, a turma e os tempos, o período, o
         professor (com a fotografia, troca-se no próprio cartão) ou «Por atribuir», a carga do professor face ao
         limite e o aviso de quem não está habilitado. A lista editável fica. -->
    <record id="edu_teaching_assignment_kanban" model="ir.ui.view">
        <field name="name">edu.teaching.assignment.kanban</field>
        <field name="model">edu.teaching.assignment</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_assign_kanban" default_order="subject_id" records_draggable="0" quick_create="0"
                    group_create="0" group_delete="0" group_edit="0">
                <header>
                    <button name="%(action_edu_class_missing_teachers)d" type="action" string="Disciplinas sem professor"
                            icon="person_search" display="always"/>
                    <button name="action_print_assignments" type="object" string="Imprimir" icon="print" display="always"/>
                </header>
                <field name="teacher_id"/>
                <field name="class_id"/>
                <field name="trimester_id"/>
                <field name="weekly_hours"/>
                <field name="teacher_load_label"/>
                <field name="teacher_load_over"/>
                <field name="qualified"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_assign_card" t-att-class="{'o_edu_assign_missing': !record.teacher_id.raw_value}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <field name="subject_id" class="o_edu_assign_subject"/>
                                <span class="small text-muted text-nowrap"><t t-out="record.weekly_hours.raw_value"/> tempos</span>
                            </div>
                            <div class="small text-muted">
                                <field name="class_id"/><t t-if="record.trimester_id.raw_value">, <field name="trimester_id"/></t>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <field name="teacher_id" widget="many2one_avatar_employee" options="{'no_create': True}"/>
                                <span t-if="record.teacher_id.raw_value" class="small text-truncate" t-out="record.teacher_id.value"/>
                                <span t-else="" class="small text-warning"><i class="oi me-1" data-icon="warning" aria-hidden="true"/>Por atribuir</span>
                            </div>
                            <div t-if="record.teacher_id.raw_value" class="o_edu_assign_notes">
                                <span t-att-class="{'text-danger fw-semibold': record.teacher_load_over.raw_value}">
                                    Carga: <t t-out="record.teacher_load_label.raw_value"/>
                                </span>
                                <span t-if="!record.qualified.raw_value" class="text-warning"><i class="oi me-1" data-icon="warning" aria-hidden="true"/>Não habilitado(a)</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- As turmas do ano em curso à esquerda: uma turma mostra as suas disciplinas (sem colunas para o lado). -->
    <record id="edu_teaching_assignment_search_panel" model="ir.ui.view">
        <field name="name">edu.teaching.assignment.search.panel</field>
        <field name="model">edu.teaching.assignment</field>
        <field name="inherit_id" ref="edu_timetable.edu_teaching_assignment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel view_types="kanban,list">
                    <field name="class_id" select="one" icon="groups" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>
    <record id="edu_timetable.action_edu_teaching_assignment" model="ir.actions.act_window">
        <field name="view_mode">kanban,list</field>
        <field name="context">{'search_default_current_year': 1}</field>
    </record>
</odoo>
