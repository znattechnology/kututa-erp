<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Os cursos em cartões: o código, o nível, a coordenação, a duração e o plano em vigor, o que o curso exige
         (estágio, PAP, exames) e os números deste ano (turmas, alunos, vagas e alunos por classe). A lista e o
         formulário ficam como estavam. -->
    <record id="edu_course_kanban" model="ir.ui.view">
        <field name="name">edu.course.kanban</field>
        <field name="model">edu.course</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_course_kanban">
                <field name="code"/>
                <field name="coordination_id"/>
                <field name="curriculum_id"/>
                <field name="requires_internship"/>
                <field name="requires_final_project"/>
                <field name="has_national_exam"/>
                <field name="has_special_exam"/>
                <field name="edu_class_count"/>
                <field name="edu_student_count"/>
                <field name="edu_occupancy"/>
                <field name="edu_per_class"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_course_card">
                            <div class="d-flex align-items-start gap-3">
                                <span class="o_edu_course_code" t-out="record.code.raw_value or '—'"/>
                                <div class="flex-grow-1 min-w-0">
                                    <field name="name" class="o_edu_course_name"/>
                                    <div class="small text-muted"><field name="level_id"/>, <field name="duration_years"/> anos</div>
                                </div>
                            </div>
                            <div class="small">
                                <div t-if="record.coordination_id.raw_value"><span class="text-muted">Coordenação:</span> <field name="coordination_id"/></div>
                                <div t-if="record.curriculum_id.raw_value"><span class="text-muted">Plano:</span> <field name="curriculum_id"/></div>
                                <div t-else="" class="text-warning"><i class="oi me-1" data-icon="warning" aria-hidden="true"/>Sem plano curricular</div>
                            </div>
                            <ul class="o_edu_course_tags">
                                <li t-if="record.requires_internship.raw_value">Estágio</li>
                                <li t-if="record.requires_final_project.raw_value">PAP</li>
                                <li t-if="record.has_national_exam.raw_value">Exame nacional</li>
                                <li t-if="record.has_special_exam.raw_value">Exame especial</li>
                            </ul>
                            <div t-if="record.edu_per_class.raw_value and record.edu_per_class.raw_value.length" class="o_edu_course_classes">
                                <div t-foreach="record.edu_per_class.raw_value" t-as="row" t-key="row.label" class="o_edu_course_class"
                                     t-att-title="row.label + ' classe: ' + row.students + ' alunos em ' + row.classes + (row.classes === 1 ? ' turma' : ' turmas')">
                                    <span class="o_edu_course_class_label" t-out="row.label"/>
                                    <span class="o_edu_course_class_track"><span t-att-style="'width: ' + row.width + '%'"/></span>
                                    <span class="o_edu_course_class_value" t-out="row.students"/>
                                </div>
                            </div>
                            <div class="o_edu_course_counts">
                                <span><i class="oi me-1" data-icon="groups" aria-hidden="true"/><t t-out="record.edu_class_count.raw_value === 1 ? '1 turma' : record.edu_class_count.raw_value + ' turmas'"/></span>
                                <span><i class="oi me-1" data-icon="school" aria-hidden="true"/><t t-out="record.edu_student_count.raw_value === 1 ? '1 aluno' : record.edu_student_count.raw_value + ' alunos'"/></span>
                                <span t-if="record.edu_class_count.raw_value" t-att-class="{'text-danger': record.edu_occupancy.raw_value > 100}">
                                    <i class="oi me-1" data-icon="pie_chart" aria-hidden="true"/><t t-out="record.edu_occupancy.raw_value"/>% das vagas
                                </span>
                                <span t-else="" class="text-muted">Sem turmas este ano</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="edu_core.action_edu_course" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Os planos curriculares em cartões: o curso, o nível e as classes; por classe, os tempos semanais e as
         disciplinas, numa barra pelas componentes (a cor de cada uma, com a legenda); as disciplinas e as turmas
         deste ano. A lista e o formulário (com a matriz do plano) ficam como estavam. -->
    <record id="edu_curriculum_kanban" model="ir.ui.view">
        <field name="name">edu.curriculum.kanban</field>
        <field name="model">edu.curriculum</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_plan_kanban">
                <field name="course_id"/>
                <field name="class_from"/>
                <field name="class_to"/>
                <field name="is_national"/>
                <field name="edu_years"/>
                <field name="edu_subject_count"/>
                <field name="edu_class_count"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_plan_card">
                            <div>
                                <div class="o_edu_plan_name"><t t-if="record.course_id.raw_value"><field name="course_id"/></t><t t-else=""><field name="name"/></t></div>
                                <div class="small text-muted">
                                    <field name="level_id"/>, <t t-out="record.class_from.raw_value"/>ª a <t t-out="record.class_to.raw_value"/>ª classe<t t-if="record.is_national.raw_value">, plano nacional</t>
                                </div>
                            </div>
                            <ul class="o_edu_plan_legend" aria-label="Componentes">
                                <li><span class="o_edu_plan_key o_edu_subj_1"/>Sociocultural</li>
                                <li><span class="o_edu_plan_key o_edu_subj_2"/>Científica</li>
                                <li><span class="o_edu_plan_key o_edu_subj_3"/>Técnica</li>
                                <li><span class="o_edu_plan_key o_edu_subj_4"/>Estágio</li>
                            </ul>
                            <div class="o_edu_plan_years">
                                <div t-foreach="record.edu_years.raw_value" t-as="year" t-key="year.id" class="o_edu_plan_year">
                                    <div class="d-flex justify-content-between small">
                                        <span class="fw-semibold" t-out="year.label"/>
                                        <span class="text-muted"><t t-out="year.hours"/> tempos, <t t-out="year.subjects"/> disciplinas</span>
                                    </div>
                                    <span class="o_edu_plan_bar" t-att-style="'width: ' + year.width + '%'">
                                        <span t-foreach="year.parts" t-as="part" t-key="part.key" t-att-class="part.css"
                                              t-att-style="'flex-grow: ' + part.hours" t-att-title="part.label + ': ' + part.hours + ' tempos'"/>
                                    </span>
                                </div>
                                <p t-if="!record.edu_years.raw_value.length" class="mb-0 small text-warning">Ainda sem anos nem disciplinas.</p>
                            </div>
                            <div class="o_edu_plan_counts">
                                <span><i class="oi me-1" data-icon="menu_book" aria-hidden="true"/><field name="edu_subject_count"/> disciplinas</span>
                                <span><i class="oi me-1" data-icon="groups" aria-hidden="true"/><t t-out="record.edu_class_count.raw_value === 1 ? '1 turma' : record.edu_class_count.raw_value + ' turmas'"/> este ano</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="edu_core.action_edu_curriculum" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- As disciplinas em cartões, uma coluna por componente de formação (com a cor da componente): o código, as
         classes e os tempos semanais nos planos, os cursos que a têm, e os professores e as turmas deste ano (com
         o aviso das turmas sem professor). A lista e o formulário ficam como estavam. -->
    <record id="edu_subject_kanban" model="ir.ui.view">
        <field name="name">edu.subject.kanban</field>
        <field name="model">edu.subject</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_subject_kanban" default_order="name" records_draggable="0" quick_create="0"
                    group_create="0" group_delete="0" group_edit="0">
                <field name="code"/>
                <field name="is_national_exam"/>
                <field name="edu_classes_label"/>
                <field name="edu_hours_label"/>
                <field name="edu_course_count"/>
                <field name="edu_teacher_count"/>
                <field name="edu_class_count"/>
                <field name="edu_missing_count"/>
                <field name="edu_component_css"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_subject_card" t-att-class="record.edu_component_css.raw_value">
                            <div class="d-flex align-items-start gap-2">
                                <span class="o_edu_subject_code" t-out="record.code.raw_value or '—'"/>
                                <div class="flex-grow-1 min-w-0">
                                    <field name="name" class="o_edu_subject_name"/>
                                    <div class="small text-muted">
                                        <t t-if="record.edu_classes_label.raw_value"><t t-out="record.edu_classes_label.raw_value"/> classe</t>
                                        <t t-else="">Fora dos planos</t>
                                        <t t-if="record.edu_hours_label.raw_value">, <t t-out="record.edu_hours_label.raw_value"/> tempos</t>
                                    </div>
                                </div>
                                <span t-if="record.is_national_exam.raw_value" class="badge text-bg-light">Exame nacional</span>
                            </div>
                            <div class="o_edu_subject_counts">
                                <span><i class="oi me-1" data-icon="school" aria-hidden="true"/><t t-out="record.edu_course_count.raw_value === 1 ? '1 curso' : record.edu_course_count.raw_value + ' cursos'"/></span>
                                <span><i class="oi me-1" data-icon="groups" aria-hidden="true"/><t t-out="record.edu_class_count.raw_value === 1 ? '1 turma' : record.edu_class_count.raw_value + ' turmas'"/></span>
                                <span><i class="oi me-1" data-icon="person" aria-hidden="true"/><t t-out="record.edu_teacher_count.raw_value === 1 ? '1 professor' : record.edu_teacher_count.raw_value + ' professores'"/></span>
                            </div>
                            <div t-if="record.edu_missing_count.raw_value" class="small text-warning">
                                <i class="oi me-1" data-icon="warning" aria-hidden="true"/><t t-out="record.edu_missing_count.raw_value === 1 ? '1 turma sem professor' : record.edu_missing_count.raw_value + ' turmas sem professor'"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="edu_core.action_edu_subject" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'group_by': 'component'}</field>
    </record>
</odoo>
