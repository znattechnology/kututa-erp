<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Menu da Secretaria Express com as secções do secPed (perfil ADMIN_SERVICOS). As pastas que já existiam
        mudam de nome em vez de se duplicarem; os itens do Odoo sem equivalente no secPed ficam no fim da secção
        onde a secretaria os procura. Carrega depois de data/menu_groups.xml (muda alguns grupos).
    -->

    <!-- Acções novas -->
    <record id="view_edu_trimester_list" model="ir.ui.view">
        <field name="name">edu.trimester.list.secretaria</field>
        <field name="model">edu.trimester</field>
        <field name="arch" type="xml">
            <list string="Trimestres" decoration-bf="is_current" decoration-muted="state == 'closed'">
                <field name="academic_year_id"/>
                <field name="name"/>
                <field name="number" optional="hide"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current" widget="boolean_toggle"/>
                <field name="state" widget="badge" decoration-success="state == 'open'"/>
            </list>
        </field>
    </record>
    <record id="action_edu_trimester" model="ir.actions.act_window">
        <field name="name">Trimestres</field>
        <field name="res_model">edu.trimester</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_edu_trimester_list"/>
        <field name="context">{'group_by': 'academic_year_id'}</field>
    </record>

    <record id="view_edu_class_director_list" model="ir.ui.view">
        <field name="name">edu.class.list.directors</field>
        <field name="model">edu.class</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Directores de turma" editable="bottom" create="false" delete="false">
                <field name="complete_name" string="Turma" readonly="1"/>
                <field name="shift_id" readonly="1" optional="show"/>
                <field name="director_id" options="{'no_create': True}"/>
            </list>
        </field>
    </record>
    <record id="action_edu_class_directors" model="ir.actions.act_window">
        <field name="name">Directores de turma</field>
        <field name="res_model">edu.class</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_edu_class_director_list"/>
        <field name="context">{'search_default_current_year': 1}</field>
    </record>

    <record id="action_edu_enrollment_new" model="ir.actions.act_window">
        <field name="name">Nova matrícula</field>
        <field name="res_model">edu.enrollment</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <record id="action_edu_enrollment_dropped" model="ir.actions.act_window">
        <field name="name">Cancelamentos</field>
        <field name="res_model">edu.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'dropped')]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Não há matrículas anuladas.</p>
            <p>Para anular uma matrícula, abra-a e use «Anular a matrícula».</p>
        </field>
    </record>

    <record id="action_edu_student_cards" model="ir.actions.act_window">
        <field name="name">Emissão de cartões</field>
        <field name="res_model">edu.student</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Não há alunos.</p>
            <p>Seleccione os alunos e use Imprimir › Cartão de estudante.</p>
        </field>
    </record>

    <record id="action_edu_student_history" model="ir.actions.act_window">
        <field name="name">Histórico do aluno</field>
        <field name="res_model">edu.subject.result</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'group_by': ['student_id', 'academic_year_id']}</field>
    </record>

    <record id="action_edu_internship_new" model="ir.actions.act_window">
        <field name="name">Novo estágio</field>
        <field name="res_model">edu.internship</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="action_edu_guardian_new" model="ir.actions.act_window">
        <field name="name">Criar encarregado</field>
        <field name="res_model">edu.guardian</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <record id="view_edu_student_guardian_list" model="ir.ui.view">
        <field name="name">edu.student.guardian.list.secretaria</field>
        <field name="model">edu.student.guardian</field>
        <field name="arch" type="xml">
            <list string="Vínculos" editable="top">
                <field name="student_id" options="{'no_create': True}"/>
                <field name="guardian_id" options="{'no_create': True}"/>
                <field name="relationship"/>
                <field name="is_primary"/>
                <field name="is_emergency" optional="show"/>
                <field name="can_pickup" optional="show"/>
                <field name="can_access_portal" optional="hide"/>
                <field name="receive_notifications" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_edu_student_guardian" model="ir.actions.act_window">
        <field name="name">Vincular a aluno</field>
        <field name="res_model">edu.student.guardian</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_edu_student_guardian_list"/>
    </record>

    <!-- A secretaria não lê as fichas do RH: a lista de docentes usa o perfil público (editam-se no RH). -->
    <record id="view_edu_teacher_public_list" model="ir.ui.view">
        <field name="name">hr.employee.public.list.teachers</field>
        <field name="model">hr.employee.public</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Docentes">
                <field name="name"/>
                <field name="edu_specialization"/>
                <field name="edu_coordination_id"/>
                <field name="work_phone" optional="show"/>
                <field name="work_email" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_edu_teacher_public" model="ir.actions.act_window">
        <field name="name">Docentes</field>
        <field name="res_model">hr.employee.public</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_edu_teacher_public_list"/>
        <field name="domain">[('edu_is_teacher', '=', True)]</field>
    </record>

    <!-- Secções -->
    <menuitem id="menu_section_config" name="Configuração académica" parent="edu_core.menu_edu_root" sequence="10"/>
    <menuitem id="menu_section_courses" name="Cursos e turmas" parent="edu_core.menu_edu_root" sequence="20"/>
    <menuitem id="menu_section_teachers" name="Docentes" parent="edu_core.menu_edu_root" sequence="30"/>
    <menuitem id="menu_section_card" name="Cartão de estudante" parent="edu_core.menu_edu_root" sequence="50"/>
    <menuitem id="menu_section_guardians" name="Encarregados" parent="edu_core.menu_edu_root" sequence="100"/>

    <record id="edu_core.menu_edu_students" model="ir.ui.menu">
        <field name="name">Matrículas</field>
        <field name="sequence">40</field>
        <field name="group_ids" eval="[(6, 0, [ref('edu_core.group_edu_user')])]"/>
    </record>
    <record id="edu_core.menu_edu_academic" model="ir.ui.menu">
        <field name="name">Horários</field>
        <field name="sequence">60</field>
    </record>
    <record id="edu_exam.menu_edu_exam" model="ir.ui.menu">
        <field name="sequence">70</field>
    </record>
    <record id="edu_evaluation.menu_edu_evaluation" model="ir.ui.menu">
        <field name="name">Histórico académico</field>
        <field name="sequence">80</field>
    </record>
    <record id="edu_records.menu_edu_records" model="ir.ui.menu">
        <field name="name">Estágios</field>
        <field name="sequence">90</field>
    </record>
    <record id="edu_fees.menu_edu_fees" model="ir.ui.menu">
        <field name="sequence">110</field>
    </record>
    <record id="edu_core.menu_edu_config" model="ir.ui.menu">
        <field name="sequence">900</field>
    </record>

    <!-- Configuração académica (a secretaria cria e altera; só a direcção apaga) -->
    <record id="edu_core.menu_edu_academic_year" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_config"/>
        <field name="name">Anos lectivos</field>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[(6, 0, [ref('edu_core.group_edu_user')])]"/>
    </record>
    <menuitem id="menu_edu_trimester" name="Trimestres" parent="menu_section_config" sequence="20"
              action="action_edu_trimester" groups="edu_core.group_edu_user"/>
    <record id="edu_core.menu_edu_shift" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_config"/>
        <field name="name">Turnos lectivos</field>
        <field name="sequence">30</field>
        <field name="group_ids" eval="[(6, 0, [ref('edu_core.group_edu_user')])]"/>
    </record>
    <record id="edu_timetable.menu_edu_time_slot" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_config"/>
        <field name="sequence">35</field>
        <field name="group_ids" eval="[(6, 0, [ref('edu_core.group_edu_user')])]"/>
    </record>
    <record id="edu_core.menu_edu_coordination" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_config"/>
        <field name="sequence">40</field>
        <field name="group_ids" eval="[(6, 0, [ref('edu_core.group_edu_user')])]"/>
    </record>

    <!-- Cursos e turmas; Disciplinas e Alunos ficam soltos -->
    <record id="edu_core.menu_edu_course" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_courses"/>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[(6, 0, [ref('edu_core.group_edu_user')])]"/>
    </record>
    <record id="edu_core.menu_edu_class" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_courses"/>
        <field name="sequence">20</field>
    </record>
    <record id="edu_core.menu_edu_room" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_courses"/>
        <field name="sequence">30</field>
        <field name="group_ids" eval="[(6, 0, [ref('edu_core.group_edu_user')])]"/>
    </record>
    <record id="edu_core.menu_edu_curriculum" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_courses"/>
        <field name="name">Currículo</field>
        <field name="sequence">40</field>
        <field name="group_ids" eval="[(6, 0, [ref('edu_core.group_edu_user')])]"/>
    </record>
    <record id="edu_core.menu_edu_subject" model="ir.ui.menu">
        <field name="parent_id" ref="edu_core.menu_edu_root"/>
        <field name="sequence">25</field>
        <field name="group_ids" eval="[(6, 0, [ref('edu_core.group_edu_user')])]"/>
    </record>
    <record id="edu_people.menu_edu_student" model="ir.ui.menu">
        <field name="parent_id" ref="edu_core.menu_edu_root"/>
        <field name="sequence">35</field>
    </record>

    <!-- Docentes -->
    <record id="edu_people.menu_edu_teacher" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_teachers"/>
        <field name="name">Lista de docentes</field>
        <field name="sequence">10</field>
        <field name="action" ref="action_edu_teacher_public"/>
    </record>
    <record id="edu_timetable.menu_edu_teaching_assignment" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_teachers"/>
        <field name="name">Professores por disciplina</field>
        <field name="sequence">20</field>
    </record>
    <menuitem id="menu_edu_class_directors" name="Directores de turma" parent="menu_section_teachers" sequence="30"
              action="action_edu_class_directors" groups="edu_core.group_edu_user"/>

    <!-- Matrículas -->
    <record id="edu_enrollment.menu_edu_application" model="ir.ui.menu">
        <field name="sequence">10</field>
    </record>
    <record id="edu_enrollment.menu_edu_enrollment" model="ir.ui.menu">
        <field name="name">Lista de matrículas</field>
        <field name="sequence">20</field>
    </record>
    <menuitem id="menu_edu_enrollment_new" name="Nova matrícula" parent="edu_core.menu_edu_students" sequence="30"
              action="action_edu_enrollment_new" groups="edu_core.group_edu_user"/>
    <menuitem id="menu_edu_enrollment_dropped" name="Cancelamentos" parent="edu_core.menu_edu_students" sequence="40"
              action="action_edu_enrollment_dropped" groups="edu_core.group_edu_user"/>
    <record id="edu_enrollment.menu_edu_transfer" model="ir.ui.menu">
        <field name="sequence">50</field>
    </record>
    <record id="edu_enrollment.menu_edu_enrollment_renewal" model="ir.ui.menu">
        <field name="sequence">60</field>
    </record>

    <!-- Cartão de estudante -->
    <menuitem id="menu_edu_student_cards" name="Emissão de cartões" parent="menu_section_card" sequence="10"
              action="action_edu_student_cards" groups="edu_core.group_edu_user"/>

    <!-- Horários (e a assiduidade, que no Odoo a secretaria também trata) -->
    <record id="edu_timetable.menu_edu_schedule_editor" model="ir.ui.menu">
        <field name="sequence">5</field>
    </record>
    <record id="edu_timetable.menu_edu_schedule" model="ir.ui.menu">
        <field name="name">Tempos por turma</field>
        <field name="sequence">10</field>
    </record>
    <record id="edu_timetable.menu_edu_schedule_replacement" model="ir.ui.menu">
        <field name="sequence">20</field>
    </record>
    <record id="edu_attendance.menu_edu_lesson" model="ir.ui.menu">
        <field name="sequence">30</field>
    </record>
    <record id="edu_attendance.menu_edu_lesson_generate" model="ir.ui.menu">
        <field name="sequence">40</field>
    </record>
    <record id="edu_attendance.menu_edu_lesson_attendance" model="ir.ui.menu">
        <field name="sequence">50</field>
    </record>
    <record id="edu_attendance.menu_edu_absence_summary" model="ir.ui.menu">
        <field name="sequence">60</field>
    </record>

    <!-- Exames -->
    <record id="edu_exam.menu_edu_exam_period" model="ir.ui.menu">
        <field name="name">Calendário de provas</field>
        <field name="sequence">10</field>
    </record>
    <record id="edu_exam.menu_edu_exam_session" model="ir.ui.menu">
        <field name="sequence">20</field>
    </record>
    <record id="edu_evaluation.menu_edu_exam_requirement" model="ir.ui.menu">
        <field name="parent_id" ref="edu_exam.menu_edu_exam"/>
        <field name="name">Exames extraordinários</field>
        <field name="sequence">30</field>
    </record>

    <!-- Histórico académico (e o resto da avaliação) -->
    <record id="edu_evaluation.menu_edu_term_result" model="ir.ui.menu">
        <field name="name">Mini-pauta</field>
        <field name="sequence">10</field>
    </record>
    <record id="edu_evaluation.menu_edu_grade_edit_permission" model="ir.ui.menu">
        <field name="name">Autorizações de notas</field>
        <field name="sequence">20</field>
    </record>
    <menuitem id="menu_edu_student_history" name="Histórico do aluno" parent="edu_evaluation.menu_edu_evaluation"
              sequence="30" action="action_edu_student_history" groups="edu_core.group_edu_user"/>
    <record id="edu_records.menu_edu_graduation" model="ir.ui.menu">
        <field name="parent_id" ref="edu_evaluation.menu_edu_evaluation"/>
        <field name="name">Diplomas e certificados</field>
        <field name="sequence">40</field>
    </record>
    <record id="edu_documents.menu_edu_document" model="ir.ui.menu">
        <field name="parent_id" ref="edu_evaluation.menu_edu_evaluation"/>
        <field name="name">Declarações</field>
        <field name="sequence">50</field>
    </record>
    <record id="edu_evaluation.menu_edu_assessment" model="ir.ui.menu">
        <field name="sequence">60</field>
    </record>
    <record id="edu_evaluation.menu_edu_subject_result" model="ir.ui.menu">
        <field name="sequence">70</field>
    </record>
    <record id="edu_documents.menu_edu_pauta_print" model="ir.ui.menu">
        <field name="sequence">80</field>
    </record>
    <record id="edu_evaluation.menu_edu_council_session" model="ir.ui.menu">
        <field name="sequence">90</field>
    </record>
    <record id="edu_evaluation.menu_edu_year_result" model="ir.ui.menu">
        <field name="sequence">100</field>
    </record>
    <record id="edu_evaluation.menu_edu_grade_appeal" model="ir.ui.menu">
        <field name="sequence">110</field>
    </record>
    <record id="edu_evaluation.menu_edu_rdec" model="ir.ui.menu">
        <field name="sequence">120</field>
    </record>

    <!-- Estágios -->
    <record id="edu_records.menu_edu_internship" model="ir.ui.menu">
        <field name="name">Lista de estágios</field>
        <field name="sequence">10</field>
    </record>
    <menuitem id="menu_edu_internship_new" name="Novo estágio" parent="edu_records.menu_edu_records" sequence="20"
              action="action_edu_internship_new" groups="edu_core.group_edu_user"/>
    <record id="edu_records.menu_edu_final_project" model="ir.ui.menu">
        <field name="name">Trabalho de fim de curso</field>
        <field name="sequence">30</field>
    </record>

    <!-- Encarregados -->
    <record id="edu_people.menu_edu_guardian" model="ir.ui.menu">
        <field name="parent_id" ref="menu_section_guardians"/>
        <field name="name">Lista de encarregados</field>
        <field name="sequence">10</field>
    </record>
    <menuitem id="menu_edu_guardian_new" name="Criar encarregado" parent="menu_section_guardians" sequence="20"
              action="action_edu_guardian_new" groups="edu_core.group_edu_user"/>
    <menuitem id="menu_edu_student_guardian" name="Vincular a aluno" parent="menu_section_guardians" sequence="30"
              action="action_edu_student_guardian" groups="edu_core.group_edu_user"/>
</odoo>
