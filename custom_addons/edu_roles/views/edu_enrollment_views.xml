<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- As matrículas em cartões, com as turmas à esquerda (uma turma mostra os seus alunos, sem colunas para o
         lado): o aluno com a fotografia, o n.º de matrícula e o n.º de ordem, a turma, o tipo, o estado e os
         documentos em falta (com o aviso do prazo de 60 dias). A lista e o formulário ficam como estavam. -->
    <record id="edu_enrollment_kanban" model="ir.ui.view">
        <field name="name">edu.enrollment.kanban</field>
        <field name="model">edu.enrollment</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_enroll_kanban" default_order="class_number, class_id, order_number" quick_create="0">
                <field name="state"/>
                <field name="edu_student_name"/>
                <field name="order_number"/>
                <field name="matricula_number"/>
                <field name="enrollment_type"/>
                <field name="documents_complete"/>
                <field name="documents_missing"/>
                <field name="documents_overdue"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_enroll_card" t-att-class="'o_edu_enroll_' + record.state.raw_value">
                            <div class="d-flex align-items-center gap-2">
                                <field name="student_id" widget="many2one_avatar" readonly="1"/>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold o_edu_enroll_name" t-out="record.edu_student_name.raw_value"/>
                                    <div class="small text-muted">
                                        <t t-if="record.matricula_number.raw_value">N.º <t t-out="record.matricula_number.raw_value"/></t>
                                        <t t-if="record.order_number.raw_value">, n.º de ordem <t t-out="record.order_number.raw_value"/></t>
                                    </div>
                                </div>
                                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'irregular'"
                                       decoration-info="state == 'draft'" decoration-danger="state == 'dropped'"/>
                            </div>
                            <div class="small text-muted">
                                <field name="class_id"/>, <field name="enrollment_type"/>
                            </div>
                            <div t-if="!record.documents_complete.raw_value and record.documents_missing.raw_value"
                                 class="small" t-att-class="record.documents_overdue.raw_value ? 'text-danger' : 'text-warning'">
                                <i class="oi me-1" data-icon="description" aria-hidden="true"/>
                                <t t-if="record.documents_overdue.raw_value">Fora do prazo: </t>faltam <t t-out="record.documents_missing.raw_value"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="edu_enrollment_search_panel" model="ir.ui.view">
        <field name="name">edu.enrollment.search.panel</field>
        <field name="model">edu.enrollment</field>
        <field name="inherit_id" ref="edu_enrollment.edu_enrollment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel view_types="kanban,list">
                    <field name="class_id" select="one" icon="groups" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="edu_enrollment.action_edu_enrollment" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
