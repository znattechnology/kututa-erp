<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aulas e sumários em cartões: o dia e a hora, a disciplina e a lição, o professor, o sumário e as faltas. À
         esquerda, a turma e o estado; os filtros «Por fechar» e «Sem sumário» são o trabalho da secretaria. -->
    <record id="view_edu_lesson_kanban" model="ir.ui.view">
        <field name="name">edu.lesson.kanban.secretaria</field>
        <field name="model">edu.lesson</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_lesson_kanban" create="false" delete="false" default_order="date desc, hour_from">
                <field name="state"/>
                <field name="summary"/>
                <field name="lesson_number"/>
                <field name="absent_count"/>
                <field name="edu_when_label"/>
                <field name="edu_class_label"/>
                <field name="edu_overdue"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_lesson_card">
                            <div class="d-flex justify-content-between gap-2">
                                <span class="fw-semibold text-nowrap" t-out="record.edu_when_label.raw_value"/>
                                <span class="small text-muted text-truncate" t-out="record.edu_class_label.raw_value"/>
                            </div>
                            <div class="d-flex justify-content-between gap-2">
                                <span class="fw-semibold text-truncate"><field name="subject_id"/></span>
                                <span t-if="record.lesson_number.raw_value" class="small text-muted text-nowrap">Lição <t t-out="record.lesson_number.raw_value"/></span>
                            </div>
                            <div class="small text-muted text-truncate"><i class="oi me-1" data-icon="person" aria-hidden="true"/><field name="teacher_id"/></div>
                            <div t-if="record.summary.raw_value" class="small o_edu_lesson_summary" t-out="record.summary.raw_value"/>
                            <div t-elif="record.state.raw_value === 'done'" class="small text-warning"><i class="oi me-1" data-icon="warning" aria-hidden="true"/>Sem sumário</div>
                            <div class="d-flex flex-wrap align-items-center gap-1 mt-auto">
                                <span t-if="record.edu_overdue.raw_value" class="badge text-bg-warning">Por fechar</span>
                                <span t-elif="record.state.raw_value === 'done'" class="badge text-bg-success">Dada</span>
                                <span t-elif="record.state.raw_value === 'cancelled'" class="badge text-bg-light">Não realizada</span>
                                <span t-else="" class="badge text-bg-info">Prevista</span>
                                <span t-if="record.absent_count.raw_value" class="small text-danger ms-auto">
                                    <t t-out="record.absent_count.raw_value"/> <t t-out="record.absent_count.raw_value === 1 ? 'falta' : 'faltas'"/>
                                </span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edu_lesson_search_secretaria" model="ir.ui.view">
        <field name="name">edu.lesson.search.secretaria</field>
        <field name="model">edu.lesson</field>
        <field name="inherit_id" ref="edu_attendance.edu_lesson_search"/>
        <field name="arch" type="xml">
            <filter name="no_summary" position="after">
                <filter name="overdue" string="Por fechar"
                        domain="[('state', '=', 'scheduled'), ('date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="week" string="Esta semana"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(weeks=-1, days=1, weekday=0)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
            </filter>
            <xpath expr="//search" position="inside">
                <searchpanel view_types="kanban,list">
                    <field name="class_id" select="one" icon="groups" enable_counters="1"/>
                    <field name="state" select="one" icon="check_circle" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <!-- Na secretaria, as aulas são só para consulta: o sumário e a chamada são do professor (área do professor). -->
    <record id="view_edu_lesson_list_readonly" model="ir.ui.view">
        <field name="name">edu.lesson.list.readonly</field>
        <field name="model">edu.lesson</field>
        <field name="inherit_id" ref="edu_attendance.edu_lesson_list"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
            </list>
        </field>
    </record>
    <record id="view_edu_lesson_form_readonly" model="ir.ui.view">
        <field name="name">edu.lesson.form.readonly</field>
        <field name="model">edu.lesson</field>
        <field name="inherit_id" ref="edu_attendance.edu_lesson_form"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </form>
            <xpath expr="//header/button[@name='action_open_roll_call']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_done']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_reset']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-info mb-0 rounded-0" role="status">
                    Só para consulta: o sumário e a chamada são do professor. As faltas justificam-se em «Presenças».
                </div>
            </xpath>
        </field>
    </record>

    <record id="edu_attendance.action_edu_lesson" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_edu_lesson_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_edu_lesson_list_readonly')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_edu_lesson_form_readonly')})]"/>
        <field name="context">{'search_default_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Não há aulas nesta escolha</p>
            <p>Só para consulta: as aulas geram-se a partir do horário («Gerar aulas») e é o professor, na sua área, que
            faz a chamada, escreve o sumário e dá a aula por dada. Aqui acompanham-se as aulas por fechar, as dadas sem
            sumário e as faltas. Tire o filtro «Esta semana» para ver as outras.</p>
        </field>
    </record>

    <!-- Justificação de faltas em cartões, para a secretaria e os directores de turma (quem marca as faltas é o
         professor, na chamada). Um cartão por falta; «Justificar» abre a justificação do período já com o aluno e o
         dia, porque um atestado cobre muitas vezes várias aulas. À esquerda, a turma e o estado. -->
    <record id="view_edu_lesson_attendance_kanban" model="ir.ui.view">
        <field name="name">edu.lesson.attendance.kanban</field>
        <field name="model">edu.lesson.attendance</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_absence_kanban" create="false" delete="false" default_order="date desc, student_id">
                <header>
                    <button name="%(edu_attendance.action_edu_absence_justify)d" type="action" string="Justificar um período"
                            class="btn-primary" display="always"/>
                </header>
                <field name="state"/>
                <field name="can_justify"/>
                <field name="justification"/>
                <field name="justified_by_id"/>
                <field name="edu_student_name"/>
                <field name="edu_when_label"/>
                <field name="edu_class_label"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_absence_card">
                            <div class="d-flex align-items-center gap-2">
                                <field name="student_id" widget="many2one_avatar" readonly="1"/>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold text-truncate" t-out="record.edu_student_name.raw_value"/>
                                    <div class="small text-muted" t-out="record.edu_class_label.raw_value"/>
                                </div>
                            </div>
                            <div class="small">
                                <span class="fw-semibold" t-out="record.edu_when_label.raw_value"/>
                                <span class="text-muted"> · <field name="subject_id"/></span>
                            </div>
                            <div t-if="record.state.raw_value === 'excused'" class="small text-muted text-truncate">
                                <t t-out="record.justification.raw_value"/>
                                <t t-if="record.justified_by_id.raw_value"> · por <field name="justified_by_id"/></t>
                            </div>
                            <div class="d-flex align-items-center gap-1 mt-auto">
                                <span t-if="record.state.raw_value === 'absent'" class="badge text-bg-danger">Por justificar</span>
                                <span t-else="" class="badge text-bg-success">Justificada</span>
                                <button t-if="record.state.raw_value === 'absent' and record.can_justify.raw_value"
                                        name="action_edu_justify" type="object" class="btn btn-sm btn-primary ms-auto">Justificar</button>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edu_lesson_attendance_search_panel" model="ir.ui.view">
        <field name="name">edu.lesson.attendance.search.panel</field>
        <field name="model">edu.lesson.attendance</field>
        <field name="inherit_id" ref="edu_attendance.edu_lesson_attendance_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel view_types="kanban,list">
                    <field name="class_id" select="one" icon="groups" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="edu_attendance.action_edu_lesson_attendance" model="ir.actions.act_window">
        <field name="view_mode">kanban,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_edu_lesson_attendance_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('edu_attendance.edu_lesson_attendance_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Não há faltas por justificar</p>
            <p>As faltas marcam-nas os professores na chamada. Justificam-nas a secretaria e o director de turma do
            aluno: «Justificar» num cartão, ou «Justificar um período» para um atestado de vários dias.</p>
        </field>
    </record>

    <!-- Resumo de faltas em cartões: um por aluno e disciplina, com as injustificadas que contam numa barra face ao
         limite (verde, amarela em risco, vermelha reprovado) e «Ver as faltas». À esquerda, a turma e o trimestre. -->
    <record id="view_edu_absence_summary_kanban" model="ir.ui.view">
        <field name="name">edu.absence.summary.kanban</field>
        <field name="model">edu.absence.summary</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_abs_kanban" create="false" delete="false" default_order="class_id, order_number">
                <field name="status"/>
                <field name="excused"/>
                <field name="late"/>
                <field name="lessons"/>
                <field name="edu_student_name"/>
                <field name="edu_class_label"/>
                <field name="edu_meter"/>
                <field name="edu_meter_label"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_abs_card">
                            <div class="d-flex align-items-center gap-2">
                                <field name="student_id" widget="many2one_avatar" readonly="1"/>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold text-truncate" t-out="record.edu_student_name.raw_value"/>
                                    <div class="small text-muted" t-out="record.edu_class_label.raw_value"/>
                                </div>
                                <span t-if="record.status.raw_value === 'failed'" class="badge text-bg-danger">Reprovado por faltas</span>
                                <span t-elif="record.status.raw_value === 'at_risk'" class="badge text-bg-warning">Em risco</span>
                            </div>
                            <div class="small"><span class="fw-semibold"><field name="subject_id"/></span> · <field name="trimester_id"/></div>
                            <div class="o_edu_abs_meter" role="meter" t-att-aria-valuenow="record.edu_meter.raw_value" aria-valuemin="0" aria-valuemax="100"
                                 t-att-aria-label="record.edu_meter_label.raw_value">
                                <span t-attf-class="o_edu_abs_bar o_edu_abs_{{ record.status.raw_value }}" t-attf-style="width: {{ record.edu_meter.raw_value }}%"/>
                            </div>
                            <div class="small" t-out="record.edu_meter_label.raw_value"/>
                            <div class="d-flex align-items-center gap-3 small text-muted mt-auto">
                                <span t-out="record.lessons.raw_value + (record.lessons.raw_value === 1 ? ' aula' : ' aulas')"/>
                                <span t-if="record.excused.raw_value" t-out="record.excused.raw_value + (record.excused.raw_value === 1 ? ' justificada' : ' justificadas')"/>
                                <span t-if="record.late.raw_value" t-out="record.late.raw_value + (record.late.raw_value === 1 ? ' atraso' : ' atrasos')"/>
                                <button name="action_edu_open_absences" type="object" class="btn btn-sm btn-link ms-auto p-0">Ver as faltas</button>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edu_absence_summary_search_panel" model="ir.ui.view">
        <field name="name">edu.absence.summary.search.panel</field>
        <field name="model">edu.absence.summary</field>
        <field name="inherit_id" ref="edu_attendance.edu_absence_summary_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel view_types="kanban,list,pivot">
                    <field name="class_id" select="one" icon="groups" enable_counters="1"/>
                    <field name="trimester_id" select="one" icon="calendar_today"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="edu_attendance.action_edu_absence_summary" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,pivot</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_edu_absence_summary_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('edu_attendance.edu_absence_summary_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('edu_attendance.edu_absence_summary_pivot')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nenhum aluno em risco de reprovar por faltas</p>
            <p>O resumo conta as faltas injustificadas por aluno e disciplina face ao limite da lei: no ensino geral, 3,
            4 ou 5 por trimestre, conforme os tempos semanais (Decreto Executivo 424/25); no técnico, o triplo dos
            tempos semanais no ano (Despacho 60/08). Tire o filtro «Em risco ou reprovados» para ver todos.</p>
        </field>
    </record>

    <!-- Sessões de exame em cartões, por dia e hora: o dia e a hora, a disciplina, as turmas, a sala e o vigilante (a
         amarelo o que falta). À esquerda, a época. As provas marcam-se no Calendário de provas. -->
    <record id="view_edu_exam_session_kanban" model="ir.ui.view">
        <field name="name">edu.exam.session.kanban</field>
        <field name="model">edu.exam.session</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_exs_kanban" default_order="date, hour_from">
                <header>
                    <button name="action_print_listing" type="object" string="Imprimir" icon="print" display="always"/>
                </header>
                <field name="state"/>
                <field name="kind"/>
                <field name="seat_count"/>
                <field name="room_label"/>
                <field name="supervisor_label"/>
                <field name="edu_time_label"/>
                <field name="edu_class_label"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_exs_card">
                            <div class="d-flex justify-content-between gap-2">
                                <span class="fw-semibold" t-out="record.edu_time_label.raw_value"/>
                                <span t-if="record.state.raw_value === 'done'" class="badge text-bg-success">Realizada</span>
                                <span t-elif="record.state.raw_value === 'cancelled'" class="badge text-bg-light">Anulada</span>
                            </div>
                            <div class="fw-semibold text-truncate"><field name="subject_id"/></div>
                            <div class="small text-muted text-truncate" t-out="record.edu_class_label.raw_value"/>
                            <div class="o_edu_exs_who small">
                                <span class="text-muted">Sala</span>
                                <span t-if="record.room_label.raw_value" class="text-truncate" t-out="record.room_label.raw_value"/>
                                <span t-else="" class="text-warning">Por definir</span>
                                <span class="text-muted">Vigia</span>
                                <span t-if="record.supervisor_label.raw_value" class="text-truncate" t-out="record.supervisor_label.raw_value"/>
                                <span t-else="" class="text-warning">Por definir</span>
                            </div>
                            <div t-if="['resit', 'extraordinary', 'improvement', 'completion'].includes(record.kind.raw_value)"
                                 class="small text-muted" t-out="record.seat_count.raw_value + (record.seat_count.raw_value === 1 ? ' aluno' : ' alunos')"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edu_exam_session_list_print" model="ir.ui.view">
        <field name="name">edu.exam.session.list.print</field>
        <field name="model">edu.exam.session</field>
        <field name="inherit_id" ref="edu_exam.edu_exam_session_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <header>
                    <button name="action_print_listing" type="object" string="Imprimir" icon="print" display="always"/>
                </header>
            </list>
        </field>
    </record>

    <record id="view_edu_exam_session_search_panel" model="ir.ui.view">
        <field name="name">edu.exam.session.search.panel</field>
        <field name="model">edu.exam.session</field>
        <field name="inherit_id" ref="edu_exam.edu_exam_session_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel view_types="kanban,list">
                    <field name="period_id" select="one" icon="calendar_today" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="edu_exam.action_edu_exam_session" model="ir.actions.act_window">
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_edu_exam_session_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('edu_exam.edu_exam_session_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('edu_exam.edu_exam_session_form')})]"/>
    </record>

    <!-- Exames especiais (recurso, extraordinário, melhoria) em cartões: o aluno, a disciplina e o exame, a nota
         anterior, a convocatória e, depois, a nota e o resultado. «Lançar a nota» abre uma janela pequena. À
         esquerda, a disciplina e o exame. -->
    <record id="view_edu_exam_requirement_kanban" model="ir.ui.view">
        <field name="name">edu.exam.requirement.kanban</field>
        <field name="model">edu.exam.requirement</field>
        <field name="arch" type="xml">
            <kanban class="o_edu_req_kanban" create="false" delete="false" default_order="subject_id, class_id">
                <header>
                    <button name="action_print_listing" type="object" string="Imprimir" icon="print" display="always"/>
                </header>
                <field name="state"/>
                <field name="kind"/>
                <field name="previous"/>
                <field name="score"/>
                <field name="resulting"/>
                <field name="passed"/>
                <field name="edu_student_name"/>
                <field name="edu_class_label"/>
                <field name="edu_session_label"/>
                <templates>
                    <t t-name="card">
                        <main class="o_edu_req_card">
                            <div class="d-flex align-items-center gap-2">
                                <field name="student_id" widget="many2one_avatar" readonly="1"/>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-semibold text-truncate" t-out="record.edu_student_name.raw_value"/>
                                    <div class="small text-muted" t-out="record.edu_class_label.raw_value"/>
                                </div>
                            </div>
                            <div class="fw-semibold o_edu_req_subject"><field name="subject_id"/></div>
                            <div class="small text-muted">Nota anterior: <field name="previous"/></div>
                            <div t-if="record.state.raw_value === 'pending'" class="small">
                                <t t-if="record.edu_session_label.raw_value">
                                    <i class="oi me-1 text-muted" data-icon="calendar_today" aria-hidden="true"/>Prova: <t t-out="record.edu_session_label.raw_value"/>
                                </t>
                                <span t-else="" class="text-warning"><i class="oi me-1" data-icon="warning" aria-hidden="true"/>Sem convocatória</span>
                            </div>
                            <div t-else="" class="small">
                                Exame <strong><field name="score"/></strong> · Fica com <strong><field name="resulting"/></strong>
                            </div>
                            <div class="d-flex align-items-center gap-1 mt-auto">
                                <span t-if="record.kind.raw_value === 'resit'" class="badge text-bg-info">Recurso</span>
                                <span t-elif="record.kind.raw_value === 'improvement'" class="badge text-bg-info">Melhoria</span>
                                <span t-else="" class="badge text-bg-info">Extraordinário</span>
                                <t t-if="record.state.raw_value === 'done'">
                                    <span t-if="record.passed.raw_value" class="badge text-bg-success">Aprovado</span>
                                    <span t-else="" class="badge text-bg-danger">Reprovado</span>
                                </t>
                                <button t-if="record.state.raw_value === 'pending'" name="action_edu_open_record" type="object"
                                        class="btn btn-sm btn-primary ms-auto">Lançar a nota</button>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_edu_exam_requirement_record_form" model="ir.ui.view">
        <field name="name">edu.exam.requirement.form.record</field>
        <field name="model">edu.exam.requirement</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Lançar a nota do exame">
                <group>
                    <group>
                        <field name="student_id" readonly="1"/>
                        <field name="subject_id" readonly="1"/>
                        <field name="kind" readonly="1"/>
                        <field name="previous" readonly="1"/>
                    </group>
                    <group>
                        <field name="score" readonly="state == 'done'"/>
                        <field name="date" readonly="state == 'done'"/>
                        <field name="state" invisible="1"/>
                    </group>
                </group>
                <div class="text-muted small">
                    No recurso e no extraordinário a nota do exame substitui a anterior; na melhoria fica a mais alta. A
                    pauta e a decisão do ano actualizam-se ao lançar.
                </div>
                <footer>
                    <button name="action_record" type="object" string="Lançar a nota" class="btn-primary" close="1"
                            invisible="state == 'done'"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_edu_exam_requirement_search_panel" model="ir.ui.view">
        <field name="name">edu.exam.requirement.search.panel</field>
        <field name="model">edu.exam.requirement</field>
        <field name="inherit_id" ref="edu_exam.edu_exam_requirement_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <searchpanel view_types="kanban,list">
                    <field name="subject_id" select="one" icon="menu_book" enable_counters="1"/>
                    <field name="kind" select="one" icon="list_alt" enable_counters="1"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="edu_evaluation.action_edu_exam_requirement" model="ir.actions.act_window">
        <field name="view_mode">kanban,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_edu_exam_requirement_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('edu_evaluation.edu_exam_requirement_list')})]"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
