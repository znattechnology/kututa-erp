<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A minha docência: o espaço do professor -->
    <record id="action_my_classes" model="ir.actions.act_window">
        <field name="name">As minhas turmas</field>
        <field name="res_model">edu.class</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('assignment_ids.teacher_id.user_id', '=', uid), ('director_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_current_year': 1, 'create': False}</field>
    </record>
    <record id="action_my_lessons" model="ir.actions.act_window">
        <field name="name">As minhas aulas</field>
        <field name="res_model">edu.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('teacher_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_scheduled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sem aulas por dar</p>
            <p>Abra a chamada, marque as faltas, escreva o sumário e dê a aula por dada.</p>
        </field>
    </record>
    <record id="action_my_assessments" model="ir.actions.act_window">
        <field name="name">Avaliações contínuas (MAC)</field>
        <field name="res_model">edu.assessment</field>
        <field name="view_mode">list,form</field>
        <!-- Só o ensino geral tem MAC (DE 424/25); no técnico a NPP lança-se na grelha «Notas da turma». -->
        <field name="domain">[('assessment_type', '=', 'continuous'), ('class_id.level_id.subsystem', '!=', 'technical'), ('class_id.assignment_ids.teacher_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_current_year': 1, 'default_assessment_type': 'continuous'}</field>
    </record>
    <record id="action_my_schedule" model="ir.actions.act_window">
        <field name="name">O meu horário</field>
        <field name="res_model">edu.schedule</field>
        <field name="view_mode">list</field>
        <field name="domain">[('teacher_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_current_year': 1, 'search_default_group_weekday': 1, 'create': False, 'edit': False}</field>
    </record>
    <record id="action_my_supervisions" model="ir.actions.act_window">
        <field name="name">As minhas vigilâncias</field>
        <field name="res_model">edu.exam.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('room_ids.supervisor_ids.user_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <!-- Painel do Professor: uma aplicação própria, como a Secretaria Express (o professor não usa os menus da
         secretaria). O conselho de turma é do director de turma. -->
    <record id="action_teacher_absences" model="ir.actions.act_window">
        <field name="name">Justificação de faltas</field>
        <field name="res_model">edu.lesson.attendance</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', 'in', ('absent', 'excused')), ('lesson_state', '=', 'done')]</field>
        <field name="context">{'search_default_absent': 1, 'search_default_my_direction': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Não há faltas por justificar nas turmas que dirige</p>
            <p>O director de turma justifica as faltas dos seus alunos, falta a falta ou um período inteiro.</p>
        </field>
    </record>

    <!-- O Painel (o dia e as turmas), as orientações e a conta, como no secPed. -->
    <record id="action_teacher_home" model="ir.actions.client">
        <field name="name">Painel</field>
        <field name="tag">edu_roles.teacher_home</field>
    </record>
    <record id="action_teacher_calendar" model="ir.actions.act_window">
        <field name="name">Calendário académico</field>
        <field name="res_model">edu.calendar.event</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{'search_default_current_year': 1, 'create': False, 'edit': False, 'delete': False}</field>
    </record>
    <record id="action_teacher_profile" model="ir.actions.server">
        <field name="group_ids" eval="[(4, ref('edu_core.group_edu_teacher'))]"/>
        <field name="name">O meu perfil</field>
        <field name="model_id" ref="model_edu_teacher_home"/>
        <field name="state">code</field>
        <field name="code">action = model.action_my_profile()</field>
    </record>
    <record id="action_teacher_payslips" model="ir.actions.server">
        <field name="group_ids" eval="[(4, ref('edu_core.group_edu_teacher'))]"/>
        <field name="name">Os meus recibos</field>
        <field name="model_id" ref="model_edu_teacher_home"/>
        <field name="state">code</field>
        <field name="code">action = model.action_my_payslips()</field>
    </record>
    <record id="action_teacher_time_off" model="ir.actions.server">
        <field name="group_ids" eval="[(4, ref('edu_core.group_edu_teacher'))]"/>
        <field name="name">Férias e ausências</field>
        <field name="model_id" ref="model_edu_teacher_home"/>
        <field name="state">code</field>
        <field name="code">action = model.action_my_time_off()</field>
    </record>

    <menuitem id="menu_edu_teacher_root" name="Painel do Professor" sequence="2" groups="edu_core.group_edu_teacher"
              action="action_teacher_home" web_icon="edu_roles,static/description/icon_teacher.png"/>
    <menuitem id="menu_teacher_home" name="Painel" action="action_teacher_home" parent="menu_edu_teacher_root" sequence="1"/>
    <!-- O menu segue o do professor no secPed. A mini-pauta, o conselho de turma, a justificação de faltas (do director),
         a MAC (ensino geral) e o RDEC (iniciação) abrem-se dentro da turma, em «Turmas e notas». -->
    <!-- Ensino -->
    <menuitem id="menu_teacher_classes" name="Ensino" parent="menu_edu_teacher_root" sequence="10"/>
    <menuitem id="menu_teacher_grade_grid" name="Turmas e notas" action="edu_evaluation.action_edu_grade_grid"
              parent="menu_teacher_classes" sequence="10"/>
    <menuitem id="menu_my_schedule" name="Meu horário" action="action_my_schedule" parent="menu_teacher_classes" sequence="40"/>
    <menuitem id="menu_my_supervisions" name="Vigilâncias" action="action_my_supervisions" parent="menu_teacher_classes" sequence="50"/>
    <menuitem id="menu_teacher_calendar" name="Calendário académico" action="action_teacher_calendar"
              parent="menu_teacher_classes" sequence="60"/>
    <menuitem id="menu_my_lessons" name="Presenças" action="action_my_lessons" parent="menu_teacher_classes" sequence="70"/>
    <menuitem id="menu_teacher_absence_summary" name="Relatório de faltas" action="edu_attendance.action_edu_absence_summary"
              parent="menu_teacher_classes" sequence="80"/>
    <!-- Formação técnica (só numa escola com o ensino técnico) -->
    <menuitem id="menu_teacher_training" name="Formação técnica" parent="menu_edu_teacher_root" sequence="30"/>
    <menuitem id="menu_teacher_orientations" name="Orientações" action="edu_records.action_edu_orientations"
              parent="menu_teacher_training" sequence="10"/>
    <!-- Comunicação -->
    <menuitem id="menu_teacher_communication" name="Comunicação" parent="menu_edu_teacher_root" sequence="40"/>
    <menuitem id="menu_teacher_messages" name="Mensagens" action="mail.action_discuss" parent="menu_teacher_communication" sequence="10"/>
    <!-- Conta -->
    <menuitem id="menu_teacher_account" name="Conta" parent="menu_edu_teacher_root" sequence="50"/>
    <menuitem id="menu_teacher_profile" name="Meu perfil" action="action_teacher_profile" parent="menu_teacher_account" sequence="10"/>
    <menuitem id="menu_teacher_payslips" action="action_teacher_payslips" parent="menu_teacher_account" sequence="20"/>
    <menuitem id="menu_teacher_time_off" action="action_teacher_time_off" parent="menu_teacher_account" sequence="30"/>
    <!-- O conselho de turma (menu do módulo das avaliações) deixa o menu do professor: abre-se na turma. -->
    <record id="edu_evaluation.menu_edu_council_session" model="ir.ui.menu">
        <field name="parent_id" ref="edu_evaluation.menu_edu_evaluation"/>
        <field name="active" eval="False"/>
    </record>
    <!-- Os grupos antigos («Aulas», «Exames») juntam-se em «Ensino», como no secPed. -->
    <menuitem id="menu_teacher_lessons" name="Aulas" parent="menu_edu_teacher_root" sequence="90" active="False"/>
    <menuitem id="menu_teacher_exams" name="Exames" parent="menu_edu_teacher_root" sequence="91" active="False"/>
    <!-- O antigo «A minha docência» (dentro da Secretaria Express) dá lugar ao painel. -->
    <menuitem id="menu_edu_teaching" name="A minha docência" parent="edu_core.menu_edu_root" sequence="1" active="False"/>
</odoo>
