<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A minha docência: o espaço do professor -->
    <record id="action_my_classes" model="ir.actions.act_window">
        <field name="name">As minhas turmas</field>
        <field name="res_model">edu.class</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('assignment_ids.teacher_id.user_id', '=', uid), ('director_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_current_year': 1, 'create': False}</field>
    </record>
    <record id="action_my_lessons" model="ir.actions.act_window">
        <field name="name">As minhas aulas</field>
        <field name="res_model">edu.lesson</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('teacher_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_scheduled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sem aulas por dar</p>
            <p>Abra a chamada, marque as faltas, escreva o sumário e dê a aula por dada.</p>
        </field>
    </record>
    <record id="action_my_assessments" model="ir.actions.act_window">
        <field name="name">Avaliações contínuas (MAC)</field>
        <field name="res_model">edu.assessment</field>
        <field name="view_mode">list,form</field>
        <!-- Só o ensino geral tem MAC (DE 424/25); no técnico a NPP lança-se na grelha «Notas da turma». -->
        <field name="domain">[('assessment_type', '=', 'continuous'), ('class_id.level_id.subsystem', '!=', 'technical'), ('class_id.assignment_ids.teacher_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_current_year': 1, 'default_assessment_type': 'continuous'}</field>
    </record>
    <record id="action_my_schedule" model="ir.actions.act_window">
        <field name="name">O meu horário</field>
        <field name="res_model">edu.schedule</field>
        <field name="view_mode">list</field>
        <field name="domain">[('teacher_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_current_year': 1, 'search_default_group_weekday': 1, 'create': False, 'edit': False}</field>
    </record>
    <record id="action_my_supervisions" model="ir.actions.act_window">
        <field name="name">As minhas vigilâncias</field>
        <field name="res_model">edu.exam.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('room_ids.supervisor_ids.user_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
    </record>

    <!-- Painel do Professor: uma aplicação própria, como a Secretaria Express (o professor não usa os menus da
         secretaria). O conselho de turma é do director de turma. -->
    <record id="action_teacher_absences" model="ir.actions.act_window">
        <field name="name">Justificação de faltas</field>
        <field name="res_model">edu.lesson.attendance</field>
        <field name="view_mode">list</field>
        <field name="domain">[('state', 'in', ('absent', 'excused')), ('lesson_state', '=', 'done')]</field>
        <field name="context">{'search_default_absent': 1, 'search_default_my_direction': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Não há faltas por justificar nas turmas que dirige</p>
            <p>O director de turma justifica as faltas dos seus alunos, falta a falta ou um período inteiro.</p>
        </field>
    </record>

    <menuitem id="menu_edu_teacher_root" name="Painel do Professor" sequence="2" groups="edu_core.group_edu_teacher"
              web_icon="edu_roles,static/description/icon_teacher.png"/>
    <menuitem id="menu_teacher_lessons" name="Aulas" parent="menu_edu_teacher_root" sequence="10"/>
    <menuitem id="menu_my_lessons" action="action_my_lessons" parent="menu_teacher_lessons" sequence="10"/>
    <menuitem id="menu_my_schedule" action="action_my_schedule" parent="menu_teacher_lessons" sequence="20"/>
    <menuitem id="menu_teacher_classes" name="Turmas e notas" parent="menu_edu_teacher_root" sequence="20"/>
    <menuitem id="menu_teacher_grade_grid" name="Notas da turma" action="edu_evaluation.action_edu_grade_grid"
              parent="menu_teacher_classes" sequence="5"/>
    <menuitem id="menu_my_classes" action="action_my_classes" parent="menu_teacher_classes" sequence="10"/>
    <menuitem id="menu_my_assessments" action="action_my_assessments" parent="menu_teacher_classes" sequence="20"/>
    <menuitem id="menu_teacher_direction" name="Direcção de turma" parent="menu_edu_teacher_root" sequence="30"/>
    <record id="edu_evaluation.menu_edu_council_session" model="ir.ui.menu">
        <field name="parent_id" ref="menu_teacher_direction"/>
        <field name="sequence">10</field>
    </record>
    <menuitem id="menu_teacher_absences" name="Justificação de faltas" action="action_teacher_absences"
              parent="menu_teacher_direction" sequence="20"/>
    <menuitem id="menu_teacher_absence_summary" name="Mapa de faltas" action="edu_attendance.action_edu_absence_summary"
              parent="menu_teacher_direction" sequence="30"/>
    <menuitem id="menu_teacher_rdec" name="RDEC (iniciação)" action="edu_evaluation.action_edu_rdec"
              parent="menu_teacher_direction" sequence="40"/>
    <menuitem id="menu_teacher_exams" name="Exames" parent="menu_edu_teacher_root" sequence="40"/>
    <menuitem id="menu_my_supervisions" action="action_my_supervisions" parent="menu_teacher_exams" sequence="10"/>
    <!-- O antigo «A minha docência» (dentro da Secretaria Express) dá lugar ao painel. -->
    <menuitem id="menu_edu_teaching" name="A minha docência" parent="edu_core.menu_edu_root" sequence="1" active="False"/>
</odoo>
