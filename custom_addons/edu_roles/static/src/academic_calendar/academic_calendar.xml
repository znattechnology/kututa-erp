<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edu_roles.AcademicCalendarPage">
        <div class="o_action o_edu_academic_calendar">
            <Layout display="this.display">
                <div class="o_edu_ca_body" t-if="this.state.data">
                    <header class="o_edu_ca_head">
                        <div>
                            <h1 class="o_edu_ca_title"><t t-out="this.manage ? 'Calendário escolar' : 'Calendário académico'"/><t t-if="this.state.data.year">, <t t-out="this.state.data.year"/></t></h1>
                            <p class="mb-0 text-muted" t-out="this.subtitle"/>
                        </div>
                        <div t-if="this.manage" class="o_edu_ca_actions">
                            <button type="button" class="btn btn-secondary" t-on-click="() => this.openList()">
                                <i class="oi me-1" data-icon="view_list" aria-hidden="true"/>Ver em lista
                            </button>
                            <button type="button" class="btn btn-primary" t-att-disabled="!this.state.data.year_id" t-on-click="() => this.newEvent()">
                                <i class="oi me-1" data-icon="add" aria-hidden="true"/>Novo evento
                            </button>
                        </div>
                    </header>
                    <div t-if="this.filters" class="btn-group flex-wrap align-self-start" role="group" aria-label="Filtro">
                        <button t-foreach="this.filters" t-as="f" t-key="f.key" type="button" class="btn"
                                t-att-class="f.key === this.state.filter ? 'btn-primary' : 'btn-secondary'"
                                t-att-aria-pressed="f.key === this.state.filter ? 'true' : 'false'"
                                t-on-click="() => this.setFilter(f.key)" t-out="f.label"/>
                    </div>

                    <!-- Onde estamos no ano: o trimestre e o que vem a seguir, com quanto falta -->
                    <div class="o_edu_kpis o_edu_ca_kpis">
                        <t t-set="tri" t-value="this.trimester"/>
                        <div class="o_edu_kpi">
                            <span class="o_edu_kpi_label"><t t-out="tri and !tri.current ? 'Próximo trimestre' : 'Trimestre em curso'"/></span>
                            <t t-if="tri and tri.current">
                                <span class="o_edu_kpi_value o_edu_ca_kpi_name" t-out="tri.name"/>
                                <span class="o_edu_meter mt-1 w-100"><span t-att-style="'width: ' + tri.width + '%'"/></span>
                                <span class="o_edu_kpi_detail">Semana <t t-out="tri.week"/> de <t t-out="tri.weeks"/>, <t t-out="tri.left === 0 ? 'acaba hoje' : tri.left === 1 ? 'falta 1 dia' : 'faltam ' + tri.left + ' dias'"/></span>
                            </t>
                            <t t-elif="tri">
                                <span class="o_edu_kpi_value o_edu_ca_kpi_name" t-out="tri.name"/>
                                <span class="o_edu_kpi_detail">Começa <t t-out="tri.until === 1 ? 'amanhã' : 'daqui a ' + tri.until + ' dias'"/></span>
                            </t>
                            <t t-else=""><span class="o_edu_kpi_value">—</span><span class="o_edu_kpi_detail">Sem trimestres no calendário</span></t>
                        </div>
                        <button t-foreach="this.overview" t-as="item" t-key="item.key" type="button" class="o_edu_kpi"
                                t-att-disabled="!item.event" t-on-click="() => this.choose(item.event.start)">
                            <span class="o_edu_kpi_label"><span class="o_edu_ca_dot me-1" t-att-class="item.event ? this.typeClass(item.event) : 'o_edu_ca_t_' + item.key" aria-hidden="true"/><t t-out="item.label"/></span>
                            <t t-if="item.event">
                                <span class="o_edu_ca_kpi_event text-truncate w-100" t-att-title="item.event.name" t-out="item.event.name"/>
                                <span class="o_edu_kpi_detail"><t t-out="this.whenLabel(item.event)"/>, <t t-out="this.span(item.event)"/></span>
                            </t>
                            <t t-else=""><span class="o_edu_kpi_value">—</span><span class="o_edu_kpi_detail" t-out="item.empty"/></t>
                        </button>
                    </div>

                    <!-- O mês e a navegação -->
                    <div class="o_edu_ca_toolbar">
                        <h2 class="o_edu_ca_month" aria-live="polite" t-out="this.monthTitle"/>
                        <div class="o_edu_ca_nav">
                            <label t-if="this.hasCommemorative" class="o_edu_ca_toggle">
                                <input type="checkbox" class="form-check-input" t-att-checked="this.state.commemorative"
                                       t-on-change="(ev) => this.toggleCommemorative(ev)"/>
                                Datas comemorativas
                            </label>
                            <button type="button" class="btn btn-secondary" aria-label="Mês anterior" t-on-click="() => this.shift(-1)">
                                <i class="oi" data-icon="chevron_left" aria-hidden="true"/>
                            </button>
                            <button type="button" class="btn btn-secondary" t-on-click="() => this.goToday()">Hoje</button>
                            <button type="button" class="btn btn-secondary" aria-label="Mês seguinte" t-on-click="() => this.shift(1)">
                                <i class="oi" data-icon="chevron_right" aria-hidden="true"/>
                            </button>
                        </div>
                    </div>

                    <div class="o_edu_ca_layout">
                        <!-- O mês -->
                        <div class="o_edu_ca_main">
                            <div class="o_edu_ca_card o_edu_ca_grid">
                                <div t-foreach="this.weekdays" t-as="w" t-key="w" class="o_edu_ca_weekday" t-out="w"/>
                                <button t-foreach="this.cells" t-as="cell" t-key="cell.key" type="button" class="o_edu_ca_cell"
                                        t-att-class="{'o_edu_ca_out': !cell.inMonth, 'o_edu_ca_sunday': cell.sunday, 'o_edu_ca_selected': cell.selected}"
                                        t-att-aria-pressed="cell.selected ? 'true' : 'false'" t-att-aria-label="cell.label"
                                        t-on-click="() => this.choose(cell.key)">
                                    <span class="o_edu_ca_daynum" t-att-class="{'o_edu_ca_today': cell.today}" t-out="cell.day"/>
                                    <t t-foreach="cell.events" t-as="event" t-key="event.id">
                                        <span t-if="event.commemorative" class="o_edu_ca_plain" t-att-title="event.name" t-out="event.name"/>
                                        <span t-else="" class="o_edu_ca_chip" t-att-class="this.typeClass(event)" t-att-title="event.name" t-out="event.name"/>
                                    </t>
                                    <span t-if="cell.more" class="o_edu_ca_plain">e mais <t t-out="cell.more"/></span>
                                </button>
                            </div>
                            <ul class="o_edu_ca_legend" aria-label="Legenda">
                                <li t-foreach="this.types" t-as="type" t-key="type.key">
                                    <span class="o_edu_ca_dot" t-att-class="'o_edu_ca_t_' + type.key" aria-hidden="true"/>
                                    <t t-out="type.label"/>
                                </li>
                            </ul>
                        </div>

                        <!-- O dia escolhido e os próximos -->
                        <aside class="o_edu_ca_aside">
                            <section aria-labelledby="o_edu_ca_day_title">
                                <h3 id="o_edu_ca_day_title" class="o_edu_ca_h3">
                                    <t t-out="this.selectedTitle"/>
                                    <span t-if="this.state.selected === this.today" class="o_edu_ca_today_tag">hoje</span>
                                </h3>
                                <p t-if="!this.selectedEvents.length" class="o_edu_ca_card mb-0 text-muted">
                                    Nada marcado neste dia.
                                    <button t-if="this.manage and this.state.data.year_id" type="button" class="btn btn-link p-0 align-baseline" t-on-click="() => this.newEvent()">Juntar um evento</button>
                                </p>
                                <ul t-else="" class="o_edu_ca_card o_edu_ca_list">
                                    <li t-foreach="this.selectedEvents" t-as="event" t-key="event.id">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <span t-out="event.name"/>
                                            <button t-if="this.canEdit(event)" type="button" class="btn btn-link btn-sm p-0" t-att-aria-label="'Editar ' + event.name" t-att-title="'Editar ' + event.name" t-on-click="() => this.openEvent(event)">
                                                <i class="oi" data-icon="edit" aria-hidden="true"/>
                                            </button>
                                        </div>
                                        <div class="o_edu_ca_meta">
                                            <span class="o_edu_ca_dot" t-att-class="this.typeClass(event)" aria-hidden="true"/>
                                            <t t-out="this.typeLabel(event)"/><t t-if="event.end !== event.start">, <t t-out="this.span(event)"/></t>
                                        </div>
                                        <div t-if="event.description" class="o_edu_ca_meta" t-out="event.description"/>
                                    </li>
                                </ul>
                            </section>
                            <section aria-labelledby="o_edu_ca_next_title">
                                <h3 id="o_edu_ca_next_title" class="o_edu_ca_h3">Próximos eventos</h3>
                                <p t-if="!this.upcoming.length" class="o_edu_ca_card mb-0 text-muted">Não há eventos marcados até ao fim do ano lectivo.</p>
                                <ul t-else="" class="o_edu_ca_card o_edu_ca_list">
                                    <li t-foreach="this.upcoming" t-as="event" t-key="event.id">
                                        <button type="button" class="o_edu_ca_next" t-on-click="() => this.choose(event.start)">
                                            <span class="o_edu_ca_dot mt-1" t-att-class="this.typeClass(event)" aria-hidden="true"/>
                                            <span class="min-w-0">
                                                <span class="d-block text-truncate" t-out="event.name"/>
                                                <span class="o_edu_ca_meta"><t t-out="this.span(event)"/>, <t t-out="this.typeLabelInline(event)"/></span>
                                                <span class="o_edu_ca_when" t-att-class="{'o_edu_ca_when_soon': this.daysUntil(event.start) &lt;= 1}" t-out="this.whenLabel(event)"/>
                                            </span>
                                        </button>
                                    </li>
                                </ul>
                            </section>
                        </aside>
                    </div>
                </div>
            </Layout>
        </div>
    </t>
</templates>
