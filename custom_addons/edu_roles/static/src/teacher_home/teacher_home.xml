<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edu_roles.TeacherHome">
        <div class="o_action o_edu_teacher_home">
            <Layout display="this.display">
                <div class="o_edu_th_body" t-if="this.state.data">
                    <t t-set="d" t-value="this.state.data"/>
                    <header class="o_edu_th_head">
                        <h1 class="o_edu_th_title" t-out="this.greeting"/>
                        <p class="mb-0 text-muted">
                            <t t-out="d.today"/>.
                            <t t-if="d.has_employee"> <t t-out="this.headline"/></t>
                        </p>
                    </header>

                    <div t-if="!d.has_employee" class="o_edu_th_card">
                        O seu utilizador ainda não está ligado a uma ficha de professor. Peça à secretaria para o associar.
                    </div>

                    <t t-else="">
                    <!-- Os números principais -->
                    <t t-set="db" t-value="d.dashboard"/>
                    <!-- O que pede atenção, antes de tudo (como nos painéis do aluno e do encarregado) -->
                    <t t-set="warnings" t-value="this.warnings"/>
                    <section t-if="warnings.length" class="o_edu_th_card o_edu_th_attention" aria-labelledby="o_edu_th_attention">
                        <h2 id="o_edu_th_attention" class="o_edu_th_h2 mb-1">O que pede atenção</h2>
                        <ul class="o_edu_th_warnings">
                            <li t-foreach="warnings" t-as="w" t-key="w.key">
                                <button type="button" class="o_edu_th_warning" t-on-click="() => this.openAction(w.action)">
                                    <span class="o_edu_th_icon" aria-hidden="true"><i class="oi" t-att-data-icon="w.icon"/></span>
                                    <span class="flex-grow-1" t-att-class="{'text-danger': w.bad}" t-out="w.text"/>
                                    <i class="oi text-muted" data-icon="chevron_right" aria-hidden="true"/>
                                </button>
                            </li>
                        </ul>
                    </section>
                    <p t-else="" class="mb-0 text-muted"><i class="oi me-1 text-success" data-icon="check_circle" aria-hidden="true"/>Está tudo em dia: aulas registadas e nenhum aluno no limite de faltas.</p>
                    <div class="o_edu_kpis">
                        <button type="button" class="o_edu_kpi" t-on-click="() => this.openAction('edu_roles.action_teacher_schedule')">
                            <span class="o_edu_kpi_label">Carga semanal</span>
                            <span class="o_edu_kpi_value" t-att-class="{'text-danger': this.overLoad}"><t t-out="db.load.count"/><small class="fs-6 fw-normal text-muted"> de <t t-out="db.load.limit"/> tempos</small></span>
                            <span class="o_edu_meter mt-1 w-100" t-att-class="{'o_edu_meter_bad': this.overLoad}"><span t-att-style="'width: ' + this.loadWidth + '%'"/></span>
                        </button>
                        <button type="button" class="o_edu_kpi" t-on-click="() => this.openAction('edu_roles.action_teacher_attendance')">
                            <span class="o_edu_kpi_label">Aulas por registar</span>
                            <span class="o_edu_kpi_value" t-att-class="{'text-warning': db.pending_lessons}" t-out="db.pending_lessons"/>
                            <span class="o_edu_kpi_detail">
                                <t t-if="db.pending_lessons"><i class="oi me-1" data-icon="warning" aria-hidden="true"/>Chamada e sumário por fazer</t>
                                <t t-else="">Todas as aulas dadas estão registadas</t>
                            </span>
                        </button>
                        <button t-if="!db.expected and db.rdec_total" type="button" class="o_edu_kpi" t-on-click="() => this.openRdec(db.rdec[0].class_id)">
                            <span class="o_edu_kpi_label">RDEC completos<t t-if="db.trimester"> no <t t-out="db.trimester"/></t></span>
                            <span class="o_edu_kpi_value"><t t-out="this.rdecPercent"/>%</span>
                            <span class="o_edu_kpi_detail"><t t-out="db.rdec_done"/> de <t t-out="db.rdec_total"/> crianças</span>
                        </button>
                        <button t-else="" type="button" class="o_edu_kpi" t-on-click="() => this.openAction('edu_evaluation.action_edu_grade_grid')">
                            <span class="o_edu_kpi_label">Notas lançadas<t t-if="db.trimester"> no <t t-out="db.trimester"/></t></span>
                            <t t-if="db.expected">
                                <span class="o_edu_kpi_value"><t t-out="this.gradedPercent"/>%</span>
                                <span class="o_edu_kpi_detail"><t t-out="db.graded"/> de <t t-out="db.expected"/> classificações</span>
                            </t>
                            <t t-else=""><span class="o_edu_kpi_value">—</span><span class="o_edu_kpi_detail">Sem turmas neste trimestre</span></t>
                        </button>
                        <button type="button" class="o_edu_kpi" t-on-click="() => this.openAction('edu_roles.action_teacher_absence_report')">
                            <span class="o_edu_kpi_label">Alunos em risco por faltas</span>
                            <span class="o_edu_kpi_value" t-att-class="{'text-danger': db.failed, 'text-warning': !db.failed and db.at_risk}" t-out="db.at_risk + db.failed"/>
                            <span class="o_edu_kpi_detail">
                                <t t-if="db.failed"><i class="oi me-1" data-icon="warning" aria-hidden="true"/><t t-out="db.failed === 1 ? '1 já passou o limite' : db.failed + ' já passaram o limite'"/></t>
                                <t t-elif="db.at_risk">A uma falta do limite</t>
                                <t t-else="">Nas suas disciplinas</t>
                            </span>
                        </button>
                    </div>

                    <div class="o_edu_th_grid">
                        <div class="o_edu_th_main">
                            <!-- O dia -->
                            <section class="o_edu_th_card">
                                <h2 class="o_edu_th_h2">
                                    <t t-if="d.lessons_day">Próximas aulas: <t t-out="d.lessons_day"/></t>
                                    <t t-else="">Aulas de hoje</t>
                                </h2>
                                <t t-set="tags" t-value="this.lessonTags"/>
                                <p t-if="!d.lessons.length" class="mb-0 text-muted">
                                    Não tem aulas no horário nas próximas duas semanas.
                                </p>
                                <ul t-else="" class="o_edu_th_list">
                                    <li t-foreach="d.lessons" t-as="l" t-key="l.schedule_id + '-' + l.date"
                                        t-att-class="{'o_edu_th_now': tags[l.schedule_id + '-' + l.date] === 'now', 'o_edu_th_next': tags[l.schedule_id + '-' + l.date] === 'next'}">
                                        <span class="o_edu_th_time" t-out="l.hours"/>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">
                                                <t t-out="l.subject"/>
                                                <span t-if="tags[l.schedule_id + '-' + l.date] === 'now'" class="o_edu_th_tag">Agora</span>
                                                <span t-elif="tags[l.schedule_id + '-' + l.date] === 'next'" class="o_edu_th_tag o_edu_th_tag_soft">A seguir</span>
                                            </div>
                                            <div class="small text-muted"><t t-out="l.class"/><t t-if="l.room">, <t t-out="l.room"/></t></div>
                                        </div>
                                        <span class="badge" t-att-class="this.stateClass(l)" t-out="this.stateLabel(l)"/>
                                        <!-- A chamada faz-se no dia da aula: uma aula futura ainda não se abre. -->
                                        <button t-if="l.today or l.state !== 'scheduled'" type="button" class="btn btn-sm" t-att-class="l.state === 'scheduled' and l.today ? 'btn-primary' : 'btn-secondary'"
                                                t-att-disabled="this.state.busy" t-on-click="() => this.openLesson(l)">
                                            <t t-out="l.state === 'scheduled' ? 'Chamada e sumário' : 'Ver a aula'"/>
                                        </button>
                                    </li>
                                </ul>
                            </section>

                            <!-- Iniciação: o RDEC do trimestre em cada turma -->
                            <section t-if="db.rdec.length" class="o_edu_th_card" aria-labelledby="o_edu_th_chart_rdec">
                                <h2 id="o_edu_th_chart_rdec" class="o_edu_th_h2">RDEC do <t t-out="db.trimester or 'trimestre'"/></h2>
                                <ul class="o_edu_chart_legend">
                                    <li><span class="o_edu_chart_key o_edu_stack_pos"/>Completos</li>
                                    <li><span class="o_edu_chart_key o_edu_stack_partial"/>Em curso</li>
                                    <li><span class="o_edu_chart_key o_edu_stack_missing"/>Por avaliar</li>
                                </ul>
                                <ul class="o_edu_stacks">
                                    <li t-foreach="db.rdec" t-as="r" t-key="r.class_id">
                                        <button type="button" class="o_edu_th_stack_btn" t-on-click="() => this.openRdec(r.class_id)"
                                                t-att-title="r.label + ': ' + r.done + ' completos, ' + r.progress + ' em curso, ' + r.todo + ' por avaliar'">
                                            <span class="o_edu_stack_head"><span t-out="r.label"/><span class="text-nowrap text-muted"><t t-out="r.total"/> crianças</span></span>
                                            <span class="o_edu_stack">
                                                <span t-if="r.done" class="o_edu_stack_pos" t-att-style="'flex-grow: ' + r.done"/>
                                                <span t-if="r.progress" class="o_edu_stack_partial" t-att-style="'flex-grow: ' + r.progress"/>
                                                <span t-if="r.todo" class="o_edu_stack_missing" t-att-style="'flex-grow: ' + r.todo"/>
                                            </span>
                                            <span class="small text-muted"><t t-out="r.done"/> completos, <t t-out="r.progress"/> em curso, <t t-out="r.todo"/> por avaliar</span>
                                        </button>
                                    </li>
                                </ul>
                            </section>

                            <!-- As notas do trimestre por turma e disciplina -->
                            <section t-if="db.grades.length or !db.rdec.length" class="o_edu_th_card" aria-labelledby="o_edu_th_chart_grades">
                                <div class="d-flex flex-wrap justify-content-between gap-2">
                                    <h2 id="o_edu_th_chart_grades" class="o_edu_th_h2">Notas do <t t-out="db.trimester or 'trimestre'"/> nas suas turmas</h2>
                                    <button t-if="db.grades.length" type="button" class="btn btn-link p-0 align-self-start" t-on-click="() => this.openAction('edu_evaluation.action_edu_grade_grid')">Lançar notas</button>
                                </div>
                                <p t-if="!db.grades.length" class="mb-0 text-muted">Ainda não tem turmas com alunos neste trimestre.</p>
                                <t t-else="">
                                    <ul class="o_edu_chart_legend">
                                        <li><span class="o_edu_chart_key o_edu_stack_pos"/>Positivas</li>
                                        <li><span class="o_edu_chart_key o_edu_stack_neg"/>Negativas</li>
                                        <li><span class="o_edu_chart_key o_edu_stack_missing"/>Sem nota</li>
                                    </ul>
                                    <ul class="o_edu_stacks">
                                        <li t-foreach="db.grades" t-as="g" t-key="g.id">
                                            <button type="button" class="o_edu_th_stack_btn" t-on-click="() => this.openGrades({ id: g.class_id })"
                                                    t-att-title="g.label + ': ' + g.positives + ' positivas, ' + g.negatives + ' negativas, ' + g.missing + ' sem nota'">
                                                <span class="o_edu_stack_head">
                                                    <span t-out="g.label"/>
                                                    <span class="text-nowrap">
                                                        <t t-if="g.average">média <span class="fw-semibold" t-att-class="{'text-danger': !g.average_pos}" t-out="g.average"/></t>
                                                        <span t-else="" class="text-muted">sem notas</span>
                                                    </span>
                                                </span>
                                                <span class="o_edu_stack">
                                                    <span t-if="g.positives" class="o_edu_stack_pos" t-att-style="'flex-grow: ' + g.positives"/>
                                                    <span t-if="g.negatives" class="o_edu_stack_neg" t-att-style="'flex-grow: ' + g.negatives"/>
                                                    <span t-if="g.missing" class="o_edu_stack_missing" t-att-style="'flex-grow: ' + g.missing"/>
                                                </span>
                                                <span class="small text-muted">
                                                    <t t-out="g.positives"/> positivas, <t t-out="g.negatives"/> negativas<t t-if="g.missing">, <t t-out="g.missing"/> sem nota</t>
                                                </span>
                                            </button>
                                        </li>
                                    </ul>
                                </t>
                            </section>

                            <!-- As turmas -->
                            <section class="o_edu_th_card">
                                <h2 class="o_edu_th_h2">As minhas turmas</h2>
                                <p t-if="!d.classes.length" class="mb-0 text-muted">
                                    Não tem turmas atribuídas este ano lectivo. As turmas aparecem quando a secretaria lhe atribui disciplinas
                                    ou a direcção de uma turma.
                                </p>
                                <ul t-else="" class="o_edu_th_list">
                                    <li t-foreach="d.classes" t-as="c" t-key="c.id">
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold"><t t-out="c.name"/>
                                                <span t-if="c.directs" class="badge text-bg-info ms-1">Director(a) de turma</span>
                                            </div>
                                            <div class="small text-muted"><t t-out="c.course"/>, <t t-out="c.students"/> alunos</div>
                                        </div>
                                        <button t-if="c.preschool" type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.openRdec(c.id)">RDEC</button>
                                        <button t-elif="c.mine.length" type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.openGrades(c)">Notas</button>
                                        <button t-if="c.directs and !c.preschool" type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.openCouncil(c)">Conselho de turma</button>
                                    </li>
                                </ul>
                            </section>
                        </div>

                        <aside class="o_edu_th_side">
                            <!-- A assiduidade nas suas aulas -->
                            <section class="o_edu_th_card" aria-labelledby="o_edu_th_chart_attendance">
                                <h2 id="o_edu_th_chart_attendance" class="o_edu_th_h2">Presenças nas suas aulas</h2>
                                <p t-if="!db.attendance.length" class="mb-0 text-muted">Ainda não há aulas dadas com chamada este ano.</p>
                                <ul t-else="" class="o_edu_meters">
                                    <li t-foreach="db.attendance" t-as="a" t-key="a.id" t-att-title="a.label + ': ' + a.rate + '% de presenças em ' + a.lessons + ' marcações'">
                                        <div class="d-flex justify-content-between gap-2 small">
                                            <span t-out="a.label"/>
                                            <span class="o_edu_th_num text-nowrap"><t t-out="a.rate"/>%</span>
                                        </div>
                                        <span class="o_edu_meter"><span t-att-style="'width: ' + a.rate + '%'"/></span>
                                    </li>
                                </ul>
                            </section>
                            <section class="o_edu_th_card">
                                <div class="d-flex flex-wrap justify-content-between gap-2">
                                    <h2 class="o_edu_th_h2">Vigilâncias</h2>
                                    <button t-if="d.supervisions.length" type="button" class="btn btn-link p-0 align-self-start" t-on-click="() => this.openAction('edu_roles.action_teacher_supervisions')">Ver todas</button>
                                </div>
                                <p t-if="!d.supervisions.length" class="mb-0 text-muted">Não tem vigilâncias marcadas.</p>
                                <ul t-else="" class="o_edu_th_plain">
                                    <li t-foreach="d.supervisions" t-as="s" t-key="s_index" class="o_edu_th_supervision">
                                        <div class="min-w-0">
                                            <div class="fw-semibold" t-out="s.subject"/>
                                            <div class="small text-muted"><t t-out="s.date"/>, <t t-out="s.hours"/><t t-if="s.rooms">, <t t-out="s.rooms"/></t></div>
                                        </div>
                                        <span class="o_edu_th_when" t-att-class="{'o_edu_th_when_soon': s.days &lt;= 1}" t-out="this.whenLabel(s.days)"/>
                                    </li>
                                </ul>
                            </section>
                            <section class="o_edu_th_card">
                                <h2 class="o_edu_th_h2">Atalhos</h2>
                                <div class="o_edu_th_links">
                                    <button t-foreach="this.shortcuts" t-as="link" t-key="link.action" type="button" class="o_edu_th_link" t-on-click="() => this.openAction(link.action)">
                                        <span class="o_edu_th_icon" aria-hidden="true"><i class="oi" t-att-data-icon="link.icon"/></span>
                                        <span t-out="link.label"/>
                                    </button>
                                </div>
                            </section>
                        </aside>
                    </div>
                    </t>
                </div>
            </Layout>
        </div>
    </t>

</templates>
