<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edu_roles.GuardiansPage">
        <div class="o_action o_edu_guardians">
            <Layout display="this.display">
                <div class="o_edu_gd_body">

                    <!-- Lista -->
                    <t t-if="this.state.mode === 'list'">
                        <div class="o_edu_gd_intro">
                            <div>
                                <h2 class="o_edu_gd_h2">Encarregados de educação</h2>
                                <p class="o_edu_gd_lead">Quem responde por cada aluno, como se contacta e de que alunos é encarregado. O principal recebe as facturas das propinas.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-secondary" t-on-click="() => this.openLink(null)">
                                    <i class="oi me-1" data-icon="link" aria-hidden="true"/>Vincular a um aluno
                                </button>
                                <button type="button" class="btn btn-primary" t-on-click="() => this.openNew()">
                                    <i class="oi me-1" data-icon="add" aria-hidden="true"/>Novo encarregado
                                </button>
                            </div>
                        </div>
                        <t t-set="k" t-value="this.kpis"/>
                        <div class="o_edu_kpis">
                            <div class="o_edu_kpi">
                                <span class="o_edu_kpi_label">Alunos com encarregado</span>
                                <span class="o_edu_kpi_value"><t t-out="k.covered"/><small class="fs-6 fw-normal text-muted"> de <t t-out="k.students"/></small></span>
                                <span class="o_edu_meter w-100" t-att-title="k.pct + '%'"><span t-att-style="'width: ' + k.pct + '%'"/></span>
                            </div>
                            <div class="o_edu_kpi">
                                <span class="o_edu_kpi_label">Alunos sem encarregado</span>
                                <span class="o_edu_kpi_value" t-att-class="k.missing ? 'text-danger' : 'text-success'" t-out="k.missing"/>
                                <span class="o_edu_kpi_detail" t-out="k.missing ? 'Matriculados este ano' : 'Todos têm encarregado'"/>
                            </div>
                            <div class="o_edu_kpi">
                                <span class="o_edu_kpi_label">Encarregados registados</span>
                                <span class="o_edu_kpi_value" t-out="k.guardians"/>
                                <span class="o_edu_kpi_detail">Com o telefone para contacto</span>
                            </div>
                            <div class="o_edu_kpi">
                                <span class="o_edu_kpi_label">Sem e-mail</span>
                                <span class="o_edu_kpi_value" t-att-class="k.noEmail ? 'text-warning' : ''" t-out="k.noEmail"/>
                                <span class="o_edu_kpi_detail">Não podem ter conta no portal</span>
                            </div>
                        </div>

                        <div class="o_edu_gd_bar">
                            <div role="tablist" aria-label="Ver" class="o_edu_gd_tabs">
                                <button type="button" role="tab" class="btn btn-sm" t-att-class="this.state.tab === 'guardians' ? 'btn-primary' : 'btn-secondary'"
                                        t-att-aria-selected="this.state.tab === 'guardians' ? 'true' : 'false'" t-on-click="() => this.state.tab = 'guardians'">
                                    Encarregados <span class="opacity-75" t-out="k.guardians"/>
                                </button>
                                <button type="button" role="tab" class="btn btn-sm" t-att-class="this.state.tab === 'missing' ? 'btn-primary' : 'btn-secondary'"
                                        t-att-aria-selected="this.state.tab === 'missing' ? 'true' : 'false'" t-on-click="() => this.state.tab = 'missing'">
                                    Alunos sem encarregado <span class="opacity-75" t-out="k.missing"/>
                                </button>
                            </div>
                            <input t-if="this.state.tab === 'guardians'" type="search" class="form-control o_edu_gd_search" aria-label="Procurar"
                                   placeholder="Nome, telefone, NIF ou aluno" t-att-value="this.state.query" t-on-input="(ev) => this.onQuery(ev)"/>
                        </div>

                        <!-- Encarregados -->
                        <t t-if="this.state.tab === 'guardians'">
                            <p t-if="this.summary and this.summary.alert" class="mb-0 text-danger" t-out="this.summary.alert"/>
                            <p t-if="!this.visibleRows.length" class="o_edu_gd_card mb-0 text-muted p-3">
                                <t t-if="this.state.query.trim()">Nenhum encarregado corresponde a «<t t-out="this.state.query.trim()"/>».</t>
                                <t t-else="">Ainda não há encarregados registados. «Novo encarregado» regista um e leva logo a vinculá-lo a um aluno.</t>
                            </p>
                            <div t-else="" class="o_edu_gd_card">
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover o_edu_gd_table mb-0">
                                        <thead>
                                            <tr><th>Encarregado</th><th>Contacto</th><th>Educandos</th><th><span class="visually-hidden">Acções</span></th></tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="this.pagedRows" t-as="r" t-key="r.id" t-att-class="{ o_edu_gd_alone: !r.links.length }">
                                                <td>
                                                    <button type="button" class="btn btn-link p-0 fw-semibold text-start" t-on-click="() => this.openGuardian(r)" t-out="r.name"/>
                                                    <div t-if="r.occupation" class="small text-muted" t-out="r.occupation"/>
                                                </td>
                                                <td>
                                                    <div class="text-nowrap" t-out="r.phone or '—'"/>
                                                    <div class="small text-truncate o_edu_gd_email" t-att-class="r.email ? 'text-muted' : 'text-warning'" t-out="r.email or 'Sem e-mail'"/>
                                                </td>
                                                <td>
                                                    <span t-if="!r.links.length" class="text-danger small">Nenhum aluno</span>
                                                    <div t-else="" class="o_edu_gd_students">
                                                        <span t-foreach="r.links" t-as="l" t-key="l.id" class="o_edu_gd_chip" t-att-class="{ o_primary: l.primary }"
                                                              t-att-title="l.primary ? 'Encarregado principal' : ''">
                                                            <t t-out="l.student"/> <span class="text-muted" t-out="'· ' + l.relationship.toLowerCase()"/>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td class="text-end">
                                                    <button type="button" class="btn btn-secondary btn-sm text-nowrap" t-att-aria-label="'Vincular ' + r.name + ' a um aluno'"
                                                            t-on-click="() => this.linkFrom(r)">
                                                        <i class="oi me-1" data-icon="link" aria-hidden="true"/>Vincular
                                                    </button>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="o_edu_gd_pager">
                                    <span class="small text-muted" t-out="this.pagerText"/>
                                    <button t-if="this.pagedRows.length lt this.visibleRows.length" type="button" class="btn btn-link btn-sm"
                                            t-on-click="() => this.state.shown += 50">Mostrar mais 50</button>
                                </div>
                            </div>
                        </t>

                        <!-- Alunos sem encarregado -->
                        <t t-else="">
                            <p t-if="!this.state.classes.length" class="o_edu_gd_card mb-0 text-success p-3">
                                Todos os alunos matriculados este ano têm encarregado.
                            </p>
                            <div t-else="" class="o_edu_gd_layout">
                                <aside class="o_edu_gd_panel" aria-label="Turmas">
                                    <section t-foreach="this.missClassGroups" t-as="g" t-key="g.course">
                                        <h6 class="o_edu_gd_panel_head" t-out="g.course"/>
                                        <button t-foreach="g.classes" t-as="c" t-key="c.id" type="button" class="o_edu_gd_panel_item"
                                                t-att-class="{ o_active: c.id === this.state.missClassId }" t-att-aria-pressed="c.id === this.state.missClassId"
                                                t-on-click="() => this.selectMissClass(c.id)">
                                            <span class="text-truncate flex-grow-1" t-out="c.label"/>
                                            <span class="small text-danger text-nowrap" t-out="c.missing"/>
                                        </button>
                                    </section>
                                </aside>
                                <section class="o_edu_gd_main">
                                    <p t-if="!this.missClass" class="o_edu_gd_card mb-0 text-muted p-3">
                                        Escolha a turma à esquerda: o número diz quantos alunos ainda não têm encarregado. Cada aluno
                                        vincula-se a um encarregado que já existe ou a um novo.
                                    </p>
                                    <div t-else="" class="o_edu_gd_card">
                                        <div class="o_edu_gd_card_head">
                                            <strong t-out="this.missClass.label"/>
                                            <span class="small text-muted" t-out="this.state.missStudents.length === 1 ? '1 aluno sem encarregado' : this.state.missStudents.length + ' alunos sem encarregado'"/>
                                        </div>
                                        <ul class="o_edu_gd_missing">
                                            <li t-foreach="this.state.missStudents" t-as="m" t-key="m.enrollment_id">
                                                <span class="o_edu_gd_num" t-out="m.number"/>
                                                <span class="flex-grow-1 text-truncate" t-out="m.name"/>
                                                <button type="button" class="btn btn-secondary btn-sm" t-att-aria-label="'Vincular um encarregado a ' + m.name"
                                                        t-on-click="() => this.linkStudent(m)">
                                                    <i class="oi me-1" data-icon="link" aria-hidden="true"/>Vincular
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </section>
                            </div>
                        </t>
                    </t>

                    <!-- Criar encarregado -->
                    <t t-elif="this.state.mode === 'new'">
                        <div>
                            <button type="button" class="btn btn-link px-0" t-on-click="() => this.backToList()">
                                <i class="oi me-1" data-icon="arrow_back" aria-hidden="true"/>Voltar aos encarregados
                            </button>
                            <h2 class="o_edu_gd_h2">Novo encarregado</h2>
                            <p class="o_edu_gd_lead">Depois de guardar, segue logo para o vincular a um aluno.</p>
                        </div>
                        <section class="o_edu_gd_card o_edu_gd_pad o_edu_gd_form">
                            <h3 class="o_edu_gd_h3 o_edu_gd_wide">Encarregado</h3>
                            <label class="o_edu_gd_field o_edu_gd_wide">
                                <span>Nome completo</span>
                                <input class="form-control" t-att-value="this.state.form.name" t-on-input="(ev) => this.onForm('name', ev)"/>
                            </label>
                            <label class="o_edu_gd_field">
                                <span>Telefone</span>
                                <input type="tel" class="form-control" placeholder="Ex.: 923 000 000" t-att-value="this.state.form.phone" t-on-input="(ev) => this.onForm('phone', ev)"/>
                            </label>
                            <label class="o_edu_gd_field">
                                <span>E-mail (opcional)</span>
                                <input type="email" class="form-control" t-att-value="this.state.form.email" t-on-input="(ev) => this.onForm('email', ev)"/>
                                <small class="text-muted">Sem e-mail não poderá ter conta no portal.</small>
                            </label>
                            <h3 class="o_edu_gd_h3 o_edu_gd_wide">Identificação (opcional)</h3>
                            <label class="o_edu_gd_field">
                                <span>BI ou passaporte</span>
                                <input class="form-control" t-att-value="this.state.form.id_number" t-on-input="(ev) => this.onForm('id_number', ev)"/>
                            </label>
                            <label class="o_edu_gd_field">
                                <span>NIF</span>
                                <input class="form-control" t-att-value="this.state.form.vat" t-on-input="(ev) => this.onForm('vat', ev)"/>
                                <small class="text-muted">10 dígitos, ou o número do BI. Sai nas facturas das propinas.</small>
                            </label>
                            <label class="o_edu_gd_field">
                                <span>Profissão</span>
                                <input class="form-control" t-att-value="this.state.form.occupation" t-on-input="(ev) => this.onForm('occupation', ev)"/>
                            </label>
                            <label class="o_edu_gd_field">
                                <span>Município</span>
                                <input class="form-control" t-att-value="this.state.form.city" t-on-input="(ev) => this.onForm('city', ev)"/>
                            </label>
                            <label class="o_edu_gd_field o_edu_gd_wide">
                                <span>Morada</span>
                                <input class="form-control" placeholder="Rua, bairro" t-att-value="this.state.form.street" t-on-input="(ev) => this.onForm('street', ev)"/>
                            </label>
                            <div class="o_edu_gd_wide d-flex gap-2">
                                <button type="button" class="btn btn-primary" t-att-disabled="!this.canCreate" t-on-click="() => this.create()">Guardar e vincular</button>
                                <button type="button" class="btn btn-secondary" t-on-click="() => this.backToList()">Cancelar</button>
                            </div>
                        </section>
                    </t>

                    <!-- Vincular -->
                    <t t-else="">
                        <div>
                            <button type="button" class="btn btn-link px-0" t-on-click="() => this.backToList()">
                                <i class="oi me-1" data-icon="arrow_back" aria-hidden="true"/>Voltar aos encarregados
                            </button>
                            <h2 class="o_edu_gd_h2">Vincular encarregado</h2>
                            <p class="o_edu_gd_lead">Escolha o aluno e o encarregado, e diga que relação têm e o que o encarregado pode fazer.</p>
                        </div>
                        <div class="o_edu_gd_steps">
                            <section class="o_edu_gd_card o_edu_gd_pad">
                                <h3 class="o_edu_gd_step"><span>1</span>Aluno</h3>
                                <StudentPicker t-if="!this.state.student" onPick="(row) => this.pickStudent(row)"/>
                                <t t-else="">
                                    <div class="o_edu_gd_picked">
                                        <div class="flex-grow-1">
                                            <strong t-out="this.state.student.name"/>
                                            <div class="small text-muted" t-out="this.state.student.class"/>
                                        </div>
                                        <button type="button" class="btn btn-secondary" t-on-click="() => this.otherStudent()">Outro aluno</button>
                                    </div>
                                    <p t-if="this.state.current === null" class="small text-muted mt-3 mb-0">A ler os encarregados actuais…</p>
                                    <p t-elif="!this.state.current.length" class="small text-muted mt-3 mb-0">Ainda não tem encarregado.</p>
                                    <div t-else="" class="mt-3">
                                        <div class="small text-muted mb-1">Encarregados actuais</div>
                                        <ul class="o_edu_gd_current">
                                            <li t-foreach="this.state.current" t-as="l" t-key="l.id">
                                                <span class="flex-grow-1"><t t-out="l.guardian"/> <span class="small text-muted">(<t t-out="l.relationship"/><t t-if="l.primary">, principal</t>)</span></span>
                                                <t t-if="this.state.confirmUnlink === l.id">
                                                    <span class="small">Desvincular<t t-if="l.primary and this.state.current.length > 1"> (outro passa a principal)</t>?</span>
                                                    <button type="button" class="btn btn-danger btn-sm" t-att-disabled="this.state.busy" t-on-click="() => this.removeLink(l)">Sim</button>
                                                    <button type="button" class="btn btn-secondary btn-sm" t-on-click="() => this.cancelUnlink()">Não</button>
                                                </t>
                                                <button t-else="" type="button" class="btn btn-link btn-sm text-danger" t-att-disabled="this.state.busy"
                                                        t-att-aria-label="'Desvincular ' + l.guardian" t-on-click="() => this.askUnlink(l)">Desvincular</button>
                                            </li>
                                        </ul>
                                    </div>
                                </t>
                            </section>

                            <section class="o_edu_gd_card o_edu_gd_pad">
                                <h3 class="o_edu_gd_step"><span>2</span>Encarregado</h3>
                                <div t-if="this.state.guardian" class="o_edu_gd_picked">
                                    <div class="flex-grow-1">
                                        <strong t-out="this.state.guardian.name"/>
                                        <div class="small text-muted" t-out="this.contact(this.state.guardian)"/>
                                    </div>
                                    <button type="button" class="btn btn-secondary" t-on-click="() => this.otherGuardian()">Outro encarregado</button>
                                </div>
                                <t t-else="">
                                    <div class="d-flex flex-wrap gap-2">
                                        <input type="search" class="form-control flex-grow-1 o_edu_gd_search" aria-label="Procurar encarregado" placeholder="Nome, telefone ou NIF do encarregado"
                                               t-att-value="this.state.guardianQuery" t-on-input="(ev) => this.onGuardianQuery(ev)"/>
                                        <button type="button" class="btn btn-secondary" t-on-click="() => this.openNew()">
                                            <i class="oi me-1" data-icon="add" aria-hidden="true"/>Registar novo
                                        </button>
                                    </div>
                                    <p t-if="!this.state.guardianResults.length" class="small text-muted mt-2 mb-0">
                                        <t t-if="this.state.guardianQuery.trim()">Nenhum encarregado com «<t t-out="this.state.guardianQuery.trim()"/>». Se ainda não está registado, «Registar novo».</t>
                                        <t t-else="">Ainda não há encarregados registados. «Registar novo» cria o primeiro.</t>
                                    </p>
                                    <ul t-else="" class="o_edu_gd_results">
                                        <li t-foreach="this.state.guardianResults" t-as="g" t-key="g.id">
                                            <button type="button" t-on-click="() => this.pickGuardian(g)">
                                                <span class="fw-semibold d-block text-truncate" t-out="g.name"/>
                                                <span class="small text-muted d-block text-truncate" t-out="this.guardianLine(g)"/>
                                            </button>
                                        </li>
                                    </ul>
                                </t>
                                <p t-if="this.alreadyLinked" class="small text-danger mt-2 mb-0">Este encarregado já está vinculado a <t t-out="this.state.student.name"/>.</p>
                            </section>

                            <section class="o_edu_gd_card o_edu_gd_pad">
                                <h3 class="o_edu_gd_step"><span>3</span>Relação e autorizações</h3>
                                <label class="o_edu_gd_field o_edu_gd_narrow">
                                    <span>O que é <t t-out="this.state.guardian ? this.state.guardian.name : 'o encarregado'"/> do aluno</span>
                                    <select class="form-select" t-on-change="(ev) => this.onRelationship(ev)">
                                        <option t-foreach="this.state.relationships" t-as="o" t-key="o.value" t-att-value="o.value"
                                                t-att-selected="o.value === this.state.relationship" t-out="o.label"/>
                                    </select>
                                </label>
                                <div class="o_edu_gd_auth">
                                    <label t-foreach="this.authorizations" t-as="a" t-key="a.key">
                                        <input type="checkbox" class="form-check-input" t-att-checked="this.state.options[a.key] ? 'checked' : undefined"
                                               t-on-change="() => this.toggleOption(a.key)"/>
                                        <span>
                                            <span class="d-block" t-out="a.label"/>
                                            <small t-if="a.hint" class="d-block text-muted" t-out="a.hint"/>
                                        </span>
                                    </label>
                                </div>
                                <p t-if="this.state.options.is_primary and this.currentPrimary" class="small text-warning-emphasis">
                                    <t t-out="this.currentPrimary.guardian"/> é o encarregado principal e deixa de o ser. As próximas facturas das propinas saem em nome deste<t t-if="!this.state.guardian or !this.state.guardian.vat">, se tiver NIF (sem NIF, saem em nome do aluno)</t>.
                                </p>
                                <p t-if="!this.state.options.is_primary and this.state.current and !this.state.current.length" class="small text-muted">
                                    O primeiro encarregado de um aluno fica sempre como principal.
                                </p>
                                <p t-if="this.state.options.can_access_portal and this.state.guardian and !this.state.guardian.email" class="small text-muted">
                                    Não tem e-mail, por isso ainda não pode ter conta no portal.
                                </p>
                                <div class="d-flex justify-content-end border-top pt-3">
                                    <button type="button" class="btn btn-primary" t-att-disabled="!this.canLink" t-on-click="() => this.link()">
                                        <i class="oi me-1" data-icon="link" aria-hidden="true"/><t t-out="this.linkLabel"/>
                                    </button>
                                </div>
                            </section>
                        </div>
                    </t>
                </div>
            </Layout>
        </div>
    </t>

</templates>
