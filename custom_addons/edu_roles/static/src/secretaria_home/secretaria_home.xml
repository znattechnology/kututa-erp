<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edu_roles.SecretariaHome">
        <div class="o_action o_edu_secretaria_home">
            <Layout display="this.display">
                <div class="o_edu_sh_body" t-if="this.state.data">
                    <t t-set="d" t-value="this.state.data"/>
                    <header>
                        <h1 class="o_edu_sh_title">Painel</h1>
                        <p class="mb-0 text-muted">Serviços académicos<t t-if="d.year">, <t t-out="d.year"/></t><t t-if="d.trimester">, <t t-out="d.trimester"/></t>.</p>
                    </header>

                    <section t-if="!d.has_year" class="o_edu_sh_card text-muted">
                        A escola ainda não tem um ano lectivo em curso. Marque-o em Configuração académica, Anos lectivos.
                    </section>
                    <t t-else="">
                        <t t-set="k" t-value="d.kpis"/>
                        <!-- Os números do ano -->
                        <div class="o_edu_kpis">
                            <button type="button" class="o_edu_kpi" t-on-click="() => this.open('students')">
                                <span class="o_edu_kpi_label">Alunos matriculados</span>
                                <span class="o_edu_kpi_value" t-out="k.students"/>
                                <span class="o_edu_kpi_detail">
                                    em <t t-out="k.classes"/> <t t-out="k.classes === 1 ? 'turma' : 'turmas'"/><t t-if="k.irregular">, <t t-out="k.irregular"/> com propinas em atraso</t>
                                </span>
                            </button>
                            <button type="button" class="o_edu_kpi" t-on-click="() => this.open('capacity')">
                                <span class="o_edu_kpi_label">Ocupação das vagas</span>
                                <t t-if="this.occupancy !== null">
                                    <span class="o_edu_kpi_value"><t t-out="this.occupancy"/>%</span>
                                    <span class="o_edu_meter mt-1 w-100" t-att-class="{'o_edu_meter_bad': this.occupancy > 100}"><span t-att-style="'width: ' + this.occupancyWidth + '%'"/></span>
                                    <span class="o_edu_kpi_detail"><t t-out="k.students"/> alunos em <t t-out="k.capacity"/> vagas</span>
                                </t>
                                <t t-else=""><span class="o_edu_kpi_value">—</span><span class="o_edu_kpi_detail">As turmas não têm vagas definidas</span></t>
                            </button>
                            <button type="button" class="o_edu_kpi" t-on-click="() => this.openAction('edu_evaluation.action_edu_grade_grid')">
                                <span class="o_edu_kpi_label">Notas lançadas<t t-if="d.trimester"> no <t t-out="d.trimester"/></t></span>
                                <t t-if="k.grades !== null">
                                    <span class="o_edu_kpi_value"><t t-out="k.grades"/>%</span>
                                    <span class="o_edu_meter mt-1 w-100"><span t-att-style="'width: ' + k.grades + '%'"/></span>
                                    <span class="o_edu_kpi_detail"><t t-out="k.launched"/> de <t t-out="k.expected"/> classificações</span>
                                </t>
                                <t t-else=""><span class="o_edu_kpi_value">—</span><span class="o_edu_kpi_detail">Sem alunos inscritos em disciplinas</span></t>
                            </button>
                            <div class="o_edu_kpi">
                                <span class="o_edu_kpi_label">Por tratar</span>
                                <span class="o_edu_kpi_value" t-att-class="{'text-warning': d.pending.length}" t-out="d.pending.length"/>
                                <span class="o_edu_kpi_detail">
                                    <t t-if="d.pending.length"><t t-out="d.pending.length === 1 ? 'assunto à espera' : 'assuntos à espera'"/>, abaixo</t>
                                    <t t-else="">Está tudo em dia</t>
                                </span>
                            </div>
                        </div>

                        <div class="o_edu_sh_grid">
                            <div class="o_edu_sh_main">
                                <!-- Por tratar -->
                                <section class="o_edu_sh_card" aria-labelledby="o_edu_sh_pending">
                                    <h2 id="o_edu_sh_pending" class="o_edu_sh_h2">Por tratar</h2>
                                    <p t-if="!d.pending.length" class="mb-0 text-muted">Não há nada à espera: as candidaturas, as matrículas, os documentos e as turmas estão em dia.</p>
                                    <ul t-else="" class="o_edu_sh_list">
                                        <li t-foreach="d.pending" t-as="p" t-key="p.key">
                                            <button type="button" class="o_edu_sh_pending" t-on-click="() => this.open(p.key)">
                                                <span class="o_edu_sh_count" t-att-class="{'o_edu_sh_count_urgent': p.urgent}" t-out="p.count"/>
                                                <span class="flex-grow-1">
                                                    <t t-out="p.text"/>
                                                    <span t-if="p.detail" class="text-muted"> <t t-out="p.detail"/></span>
                                                </span>
                                                <i class="oi text-muted" data-icon="chevron_right" aria-hidden="true"/>
                                            </button>
                                        </li>
                                    </ul>
                                </section>

                                <!-- As turmas -->
                                <section class="o_edu_sh_card p-0" aria-labelledby="o_edu_sh_classes">
                                    <div class="o_edu_sh_card_head">
                                        <h2 id="o_edu_sh_classes" class="o_edu_sh_h2 mb-0">As turmas</h2>
                                        <span class="small text-muted">As que têm alguma coisa por resolver primeiro.</span>
                                    </div>
                                    <p t-if="!d.classes.length" class="mb-0 px-3 pb-3 text-muted">Ainda não há turmas neste ano lectivo.</p>
                                    <div t-else="" class="o_edu_sh_scroll">
                                        <table class="table mb-0 o_edu_sh_table">
                                            <thead>
                                                <tr>
                                                    <th>Turma</th>
                                                    <th>Ocupação</th>
                                                    <th>Notas lançadas</th>
                                                    <th>Horário</th>
                                                    <th>Director de turma</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr t-foreach="this.classes" t-as="c" t-key="c.id" class="o_edu_sh_row" t-on-click="() => this.open('class', c.id)">
                                                    <td>
                                                        <div class="fw-semibold" t-out="c.name"/>
                                                        <div class="small text-muted" t-out="c.course"/>
                                                    </td>
                                                    <td class="o_edu_sh_meter_cell" t-att-title="c.students + ' alunos em ' + c.capacity + ' vagas'">
                                                        <span class="small o_edu_sh_num" t-att-class="{'text-danger': c.over}"><t t-out="c.students"/> de <t t-out="c.capacity"/></span>
                                                        <span class="o_edu_meter" t-att-class="this.occupancyClass(c)"><span t-att-style="'width: ' + c.occupancy_width + '%'"/></span>
                                                    </td>
                                                    <td class="o_edu_sh_meter_cell" t-att-title="c.launched + ' de ' + c.expected + ' classificações'">
                                                        <t t-if="c.grades !== null">
                                                            <span class="small o_edu_sh_num"><t t-out="c.grades"/>%</span>
                                                            <span class="o_edu_meter"><span t-att-style="'width: ' + c.grades + '%'"/></span>
                                                        </t>
                                                        <span t-else="" class="text-muted small">—</span>
                                                    </td>
                                                    <td class="small">
                                                        <span t-if="c.no_schedule" class="text-danger"><i class="oi me-1" data-icon="warning" aria-hidden="true"/>Sem horário</span>
                                                        <t t-elif="c.lessons">
                                                            <t t-out="c.lessons"/> tempos<span t-if="c.no_teacher" class="text-warning">, <t t-out="c.no_teacher"/> sem professor</span>
                                                        </t>
                                                        <span t-else="" class="text-muted">Estágio</span>
                                                    </td>
                                                    <td class="small">
                                                        <t t-if="c.director" t-out="c.director"/>
                                                        <span t-else="" class="text-warning">Por nomear</span>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div t-if="this.hiddenClasses" class="px-3 py-2 border-top">
                                        <button type="button" class="btn btn-link p-0" t-on-click="() => this.toggleAll()">
                                            <t t-if="this.state.all">Mostrar menos</t>
                                            <t t-else="">Ver as outras <t t-out="this.hiddenClasses"/> turmas</t>
                                        </button>
                                    </div>
                                </section>
                            </div>

                            <aside class="o_edu_sh_side">
                                <!-- Os alunos por classe -->
                                <section class="o_edu_sh_card" aria-labelledby="o_edu_sh_per_class">
                                    <h2 id="o_edu_sh_per_class" class="o_edu_sh_h2">Alunos por classe</h2>
                                    <p t-if="!d.per_class.length" class="mb-0 text-muted">Ainda não há alunos matriculados.</p>
                                    <div t-else="" class="o_edu_hbars" role="list">
                                        <div t-foreach="this.perClass" t-as="r" t-key="r.label" class="o_edu_hbar_row o_edu_sh_hbar_row" role="listitem"
                                             t-att-title="r.label + ': ' + r.count + (r.count === 1 ? ' aluno' : ' alunos')">
                                            <span class="o_edu_hbar_name" t-out="r.label"/>
                                            <span class="o_edu_hbar_track"><span t-if="r.count" class="o_edu_hbar" t-att-style="'width: ' + r.width + '%'"/></span>
                                            <span class="o_edu_hbar_value" t-out="r.count"/>
                                        </div>
                                    </div>
                                </section>

                                <!-- Os próximos eventos -->
                                <section class="o_edu_sh_card" aria-labelledby="o_edu_sh_events">
                                    <div class="d-flex justify-content-between gap-2">
                                        <h2 id="o_edu_sh_events" class="o_edu_sh_h2">Próximas duas semanas</h2>
                                        <button type="button" class="btn btn-link p-0 align-self-start" t-on-click="() => this.open('calendar')">Calendário</button>
                                    </div>
                                    <p t-if="!d.events.length" class="mb-0 text-muted">Sem eventos no calendário escolar.</p>
                                    <ul t-else="" class="o_edu_sh_list">
                                        <li t-foreach="d.events" t-as="e" t-key="e.id" class="o_edu_sh_event">
                                            <span class="o_edu_sh_date"><span t-out="e.day"/><small t-out="e.month"/></span>
                                            <span class="flex-grow-1">
                                                <span class="d-block" t-out="e.name"/>
                                                <span class="d-block small text-muted"><t t-out="e.type"/><t t-if="e.until">, até <t t-out="e.until"/></t></span>
                                            </span>
                                        </li>
                                    </ul>
                                </section>

                                <!-- Atalhos (os do secPed) -->
                                <section class="o_edu_sh_card">
                                    <h2 class="o_edu_sh_h2">Atalhos</h2>
                                    <div class="o_edu_sh_links">
                                        <button type="button" class="btn btn-link" t-on-click="() => this.openAction('edu_evaluation.action_edu_grade_grid')">Lançar e imprimir pautas</button>
                                        <button type="button" class="btn btn-link" t-on-click="() => this.openAction('edu_timetable.action_edu_schedule_editor')">Construir horários</button>
                                        <button type="button" class="btn btn-link" t-on-click="() => this.openAction('edu_timetable.action_edu_teaching_assignment')">Atribuir professores às disciplinas</button>
                                        <button type="button" class="btn btn-link" t-on-click="() => this.openAction('edu_documents.action_edu_student_history_page')">Histórico do aluno</button>
                                        <button type="button" class="btn btn-link" t-on-click="() => this.openAction('edu_documents.action_edu_document')">Documentos</button>
                                    </div>
                                </section>
                            </aside>
                        </div>
                    </t>
                </div>
            </Layout>
        </div>
    </t>
</templates>
