<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edu_roles.TeacherProfilePage">
        <div class="o_action o_edu_teacher_account">
            <Layout display="this.display">
                <div class="o_edu_ta_body" t-if="this.state.data">
                    <t t-set="d" t-value="this.state.data"/>
                    <header>
                        <h1 class="o_edu_ta_title">Meu perfil</h1>
                        <p class="mb-0 text-muted">O seu trabalho e os seus dados na escola.</p>
                    </header>
                    <section t-if="!d.has_employee" class="o_edu_ta_card">
                        O seu utilizador ainda não está ligado a uma ficha de professor. Peça à secretaria para o associar.
                    </section>
                    <t t-else="">
                        <!-- Quem é, o que faz na escola e como a escola o contacta -->
                        <section class="o_edu_ta_card o_edu_ta_me" aria-labelledby="o_edu_ta_me">
                            <span class="o_edu_ta_avatar" aria-hidden="true" t-out="this.initials(d.name)"/>
                            <div class="min-w-0 flex-grow-1">
                                <h2 id="o_edu_ta_me" class="o_edu_ta_name">
                                    <t t-out="d.name"/>
                                    <span t-if="d.directs.length" class="badge text-bg-info ms-2 align-middle fs-6 fw-normal">Director(a) de turma</span>
                                </h2>
                                <div class="text-muted" t-out="this.roleLine"/>
                                <div t-if="d.email or d.phone" class="o_edu_ta_contacts">
                                    <a t-if="d.phone" t-att-href="'tel:' + d.phone" class="o_edu_ta_contact"><i class="oi" data-icon="phone" aria-hidden="true"/><t t-out="d.phone"/></a>
                                    <a t-if="d.email" t-att-href="'mailto:' + d.email" class="o_edu_ta_contact"><i class="oi" data-icon="mail" aria-hidden="true"/><t t-out="d.email"/></a>
                                </div>
                            </div>
                        </section>

                        <div t-if="this.missing.length" class="alert alert-warning mb-0 d-flex gap-2" role="status">
                            <i class="oi" data-icon="info" aria-hidden="true"/>
                            <div>Faltam <t t-out="this.list(this.missing)"/>. Peça à secretaria para os completar.</div>
                        </div>

                        <!-- Os números do ano -->
                        <div class="o_edu_kpis o_edu_ta_kpis">
                            <div class="o_edu_kpi">
                                <span class="o_edu_kpi_label">Carga semanal</span>
                                <span class="o_edu_kpi_value" t-att-class="{'text-danger': this.overLoad}"><t t-out="d.load.count"/><small class="fs-6 fw-normal text-muted"> de <t t-out="d.load.limit"/> tempos</small></span>
                                <span class="o_edu_meter mt-1 w-100" t-att-class="{'o_edu_meter_bad': this.overLoad}"><span t-att-style="'width: ' + this.loadWidth + '%'"/></span>
                                <span t-if="d.load.notes.length" class="o_edu_kpi_detail" t-out="d.load.notes.join(', ')"/>
                            </div>
                            <div class="o_edu_kpi">
                                <span class="o_edu_kpi_label">Disciplinas</span>
                                <span class="o_edu_kpi_value" t-out="d.subjects.length"/>
                                <span class="o_edu_kpi_detail" t-out="d.year ? 'No ano lectivo ' + d.year : 'Sem ano lectivo em curso'"/>
                            </div>
                            <div class="o_edu_kpi">
                                <span class="o_edu_kpi_label">Turmas</span>
                                <span class="o_edu_kpi_value" t-out="d.classes.length"/>
                                <span class="o_edu_kpi_detail" t-out="d.directs.length ? 'Dirige ' + this.list(d.directs) : 'Não dirige turma'"/>
                            </div>
                            <div class="o_edu_kpi">
                                <span class="o_edu_kpi_label">Na escola</span>
                                <span class="o_edu_kpi_value o_edu_ta_kpi_text" t-out="d.since ? 'Desde ' + d.since : '—'"/>
                                <span class="o_edu_kpi_detail" t-out="d.since ? 'Data de admissão' : 'Data por preencher'"/>
                            </div>
                        </div>

                        <!-- O trabalho deste ano: as disciplinas e as turmas em etiquetas -->
                        <section class="o_edu_ta_card o_edu_ta_section" aria-labelledby="o_edu_ta_work">
                            <h2 id="o_edu_ta_work" class="o_edu_ta_h2 mb-0">O seu trabalho este ano</h2>
                            <p t-if="!d.subjects.length" class="mb-0 text-muted">Ainda não tem disciplinas atribuídas. As atribuições são feitas pelos Serviços Académicos.</p>
                            <t t-else="">
                                <div>
                                    <h3 class="o_edu_ta_h3">Disciplinas</h3>
                                    <ul class="o_edu_ta_tags">
                                        <li t-foreach="d.subjects" t-as="subject" t-key="subject_index" t-out="subject"/>
                                    </ul>
                                </div>
                                <div>
                                    <h3 class="o_edu_ta_h3">Turmas</h3>
                                    <ul class="o_edu_ta_tags">
                                        <li t-foreach="d.classes" t-as="c" t-key="c_index" t-att-class="{'o_edu_ta_tag_strong': d.directs.includes(c)}">
                                            <t t-out="c"/><span t-if="d.directs.includes(c)" class="ms-1 small">, dirige</span>
                                        </li>
                                    </ul>
                                </div>
                                <p t-if="d.coordination" class="mb-0"><span class="text-muted">Coordenação:</span> <t t-out="d.coordination"/></p>
                            </t>
                        </section>

                        <!-- Os dados da ficha, em grelha -->
                        <section class="o_edu_ta_section" aria-labelledby="o_edu_ta_data">
                            <h2 id="o_edu_ta_data" class="o_edu_ta_h2 mb-0">Os seus dados</h2>
                            <ul class="o_edu_ta_datafields">
                                <li t-foreach="this.fields" t-as="f" t-key="f.key" class="o_edu_ta_datafield">
                                    <span class="o_edu_ta_icon" aria-hidden="true"><i class="oi" t-att-data-icon="f.icon"/></span>
                                    <div class="min-w-0">
                                        <div class="small text-muted" t-out="f.label"/>
                                        <div t-if="f.value" class="text-break" t-out="f.value"/>
                                        <div t-else="" class="text-muted">Por preencher</div>
                                    </div>
                                </li>
                            </ul>
                            <p class="mb-0 small text-muted">Estes dados são da secretaria: se algum estiver errado, peça-lhe para o corrigir.</p>
                        </section>

                        <section class="o_edu_ta_card" aria-labelledby="o_edu_ta_security">
                            <h2 id="o_edu_ta_security" class="o_edu_ta_h2">Segurança</h2>
                            <div class="o_edu_ta_row">
                                <p class="mb-0 text-muted">Mude a palavra-passe se achar que alguém a sabe.</p>
                                <button type="button" class="btn btn-secondary" t-on-click="() => this.changePassword()">
                                    <i class="oi me-1" data-icon="lock" aria-hidden="true"/>Alterar a palavra-passe
                                </button>
                            </div>
                        </section>
                    </t>
                </div>
            </Layout>
        </div>
    </t>

    <t t-name="edu_roles.TeacherPayslipsPage">
        <div class="o_action o_edu_teacher_account">
            <Layout display="this.display">
                <div class="o_edu_ta_body" t-if="this.state.data">
                    <t t-set="d" t-value="this.state.data"/>
                    <header>
                        <h1 class="o_edu_ta_title">Recibos e férias</h1>
                        <p class="mb-0 text-muted">Os seus recibos de vencimento<t t-if="d.time_off"> e as suas férias e ausências</t>.</p>
                    </header>
                    <section t-if="!d.has_employee" class="o_edu_ta_card">
                        O seu utilizador ainda não está ligado a uma ficha de professor. Peça à secretaria para o associar.
                    </section>
                    <t t-else="">
                        <section t-if="d.time_off" aria-labelledby="o_edu_ta_leaves" class="o_edu_ta_section">
                            <div class="o_edu_ta_row">
                                <h2 id="o_edu_ta_leaves" class="o_edu_ta_h2 mb-0">Férias e ausências deste ano</h2>
                                <button type="button" class="btn btn-primary" t-on-click="() => this.requestTimeOff()">Pedir férias ou ausência</button>
                            </div>
                            <p t-if="!d.time_off.length" class="o_edu_ta_card mb-0 text-muted">Ainda não pediu férias nem ausências este ano.</p>
                            <ul t-else="" class="o_edu_ta_card o_edu_ta_list">
                                <li t-foreach="d.time_off" t-as="leave" t-key="leave.id">
                                    <span class="flex-grow-1">
                                        <span class="d-block fw-semibold" t-out="leave.type"/>
                                        <span class="d-block small text-muted"><t t-out="leave.from"/><t t-if="leave.to !== leave.from"> a <t t-out="leave.to"/></t>, <t t-out="this.days(leave)"/></span>
                                    </span>
                                    <span class="badge" t-att-class="this.leaveClass(leave)" t-out="leave.state_label"/>
                                </li>
                            </ul>
                        </section>

                        <section aria-labelledby="o_edu_ta_slips" class="o_edu_ta_section">
                            <h2 id="o_edu_ta_slips" class="o_edu_ta_h2 mb-0">Recibos de vencimento</h2>
                            <p t-if="!d.has_payroll" class="o_edu_ta_card mb-0 text-muted">O processamento salarial não está activo nesta escola.</p>
                            <p t-elif="!d.payslips.length" class="o_edu_ta_card mb-0 text-muted">
                                Ainda não há recibos fechados. Aparecem aqui quando os Recursos Humanos fecham a folha do mês.
                            </p>
                            <ul t-else="" class="o_edu_ta_card o_edu_ta_list">
                                <li t-foreach="d.payslips" t-as="slip" t-key="slip.id">
                                    <span class="flex-grow-1">
                                        <span class="d-block fw-semibold"><t t-out="slip.period"/><t t-if="slip.final"> · contas finais</t></span>
                                        <span class="d-block small text-muted">Bruto <t t-out="slip.gross"/>, descontos <t t-out="slip.deductions"/><t t-if="slip.number"> · n.º <t t-out="slip.number"/></t></span>
                                    </span>
                                    <span class="o_edu_ta_net" t-out="slip.net"/>
                                    <button type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.openPayslip(slip, true)">Ver</button>
                                    <button type="button" class="btn btn-sm btn-secondary" title="O recibo em PDF" t-on-click="() => this.openPayslip(slip, false)">PDF</button>
                                </li>
                            </ul>
                        </section>
                    </t>
                </div>
            </Layout>
        </div>
    </t>
</templates>
