<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_class_list" model="ir.ui.view">
        <field name="name">edu.class.list</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <list string="Turmas">
                <field name="academic_year_id"/>
                <field name="class_number"/>
                <field name="name"/>
                <field name="course_id"/>
                <field name="shift_id" optional="show"/>
                <field name="room_id" optional="show"/>
                <field name="capacity"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="edu_class_form" model="ir.ui.view">
        <field name="name">edu.class.form</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <form string="Turma">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title"><h1><field name="display_name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="academic_year_id" options="{'no_create': True}"/>
                            <field name="course_id" options="{'no_create': True}"/>
                            <field name="curriculum_id" options="{'no_create': True}"/>
                            <field name="curriculum_year_id" options="{'no_create': True}"/>
                            <field name="class_number"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="shift_id"/>
                            <field name="room_id"/>
                            <field name="capacity"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Disciplinas" name="subjects" invisible="not curriculum_year_id">
                            <field name="subject_line_ids" readonly="1">
                                <list>
                                    <field name="subject_id"/>
                                    <field name="weekly_hours" sum="Total"/>
                                    <field name="component"/>
                                    <field name="is_national_exam"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes"><field name="note" nolabel="1"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="edu_class_search" model="ir.ui.view">
        <field name="name">edu.class.search</field>
        <field name="model">edu.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="course_id"/>
                <field name="academic_year_id"/>
                <filter name="current_year" string="Ano em curso" domain="[('academic_year_id.is_current', '=', True)]"/>
                <group>
                    <filter name="group_year" string="Ano lectivo" context="{'group_by': 'academic_year_id'}"/>
                    <filter name="group_course" string="Curso" context="{'group_by': 'course_id'}"/>
                    <filter name="group_class" string="Classe" context="{'group_by': 'class_number'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_class" model="ir.actions.act_window">
        <field name="name">Turmas</field>
        <field name="res_model">edu.class</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current_year': 1}</field>
    </record>

    <menuitem id="menu_edu_class" action="action_edu_class" parent="menu_edu_academic" sequence="10"/>
</odoo>
