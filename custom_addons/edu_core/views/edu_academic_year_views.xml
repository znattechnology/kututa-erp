<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_academic_year_list" model="ir.ui.view">
        <field name="name">edu.academic.year.list</field>
        <field name="model">edu.academic.year</field>
        <field name="arch" type="xml">
            <list string="Anos lectivos" decoration-bf="is_current">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="class_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="is_current" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="edu_academic_year_form" model="ir.ui.view">
        <field name="name">edu.academic.year.form</field>
        <field name="model">edu.academic.year</field>
        <field name="arch" type="xml">
            <form string="Ano lectivo">
                <header>
                    <button name="action_generate_trimesters" type="object" string="Criar os trimestres" class="btn-primary" invisible="trimester_ids"/>
                    <button name="action_set_current" type="object" string="Marcar como em curso" invisible="is_current"/>
                    <button name="action_load_national_calendar" type="object" string="Carregar o calendário nacional"
                            confirm="Carregar (ou actualizar) o Calendário Escolar Nacional deste ano? Os eventos que a escola alterou ficam como estão."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_classes" type="object" class="oe_stat_button" icon="group">
                            <field name="class_count" widget="statinfo" string="Turmas"/>
                        </button>
                        <button name="action_view_calendar" type="object" class="oe_stat_button" icon="calendar_month"
                                string="Calendário"/>
                    </div>
                    <widget name="web_ribbon" title="Em curso" invisible="not is_current"/>
                    <div class="oe_title"><h1><field name="name" placeholder="2026/2027"/></h1></div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="is_current" invisible="1"/>
                        </group>
                    </group>
                    <field name="trimester_ids">
                        <list editable="bottom" decoration-muted="state == 'closed'">
                            <field name="number"/>
                            <field name="name"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="is_current" widget="boolean_toggle"/>
                            <field name="state" widget="badge" decoration-success="state == 'open'"/>
                            <button name="action_close" type="object" string="Fechar" icon="lock" invisible="state != 'open'"
                                    confirm="Fechado o trimestre, as notas só se corrigem por reapreciação. Continuar?"/>
                            <button name="action_reopen" type="object" string="Reabrir" icon="lock_open" invisible="state != 'closed'" groups="edu_core.group_edu_manager"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_edu_academic_year" model="ir.actions.act_window">
        <field name="name">Anos lectivos</field>
        <field name="res_model">edu.academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crie o ano lectivo</p>
            <p>Com as datas, os três trimestres são criados num clique e ajustam-se depois.</p>
        </field>
    </record>

    <menuitem id="menu_edu_academic_year" action="action_edu_academic_year" parent="menu_edu_config" sequence="10"/>
</odoo>
