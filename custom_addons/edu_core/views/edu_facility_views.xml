<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_campus_list" model="ir.ui.view">
        <field name="name">edu.campus.list</field>
        <field name="model">edu.campus</field>
        <field name="arch" type="xml">
            <list string="Campus" editable="bottom">
                <field name="name"/>
                <field name="address"/>
                <field name="phone"/>
                <field name="is_main"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_edu_campus" model="ir.actions.act_window">
        <field name="name">Campus</field>
        <field name="res_model">edu.campus</field>
        <field name="view_mode">list</field>
    </record>

    <record id="edu_building_list" model="ir.ui.view">
        <field name="name">edu.building.list</field>
        <field name="model">edu.building</field>
        <field name="arch" type="xml">
            <list string="Edifícios" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="campus_id"/>
                <field name="floors"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_edu_building" model="ir.actions.act_window">
        <field name="name">Edifícios</field>
        <field name="res_model">edu.building</field>
        <field name="view_mode">list</field>
    </record>

    <record id="edu_room_list" model="ir.ui.view">
        <field name="name">edu.room.list</field>
        <field name="model">edu.room</field>
        <field name="arch" type="xml">
            <list string="Salas" editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="room_type"/>
                <field name="capacity"/>
                <field name="building_id"/>
                <field name="floor" optional="hide"/>
                <field name="campus_id" optional="hide"/>
                <field name="has_projector" optional="show"/>
                <field name="has_ac" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="edu_room_search" model="ir.ui.view">
        <field name="name">edu.room.search</field>
        <field name="model">edu.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="building_id"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'room_type'}"/>
                    <filter name="group_building" string="Edifício" context="{'group_by': 'building_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_edu_room" model="ir.actions.act_window">
        <field name="name">Salas</field>
        <field name="res_model">edu.room</field>
        <field name="view_mode">list</field>
    </record>

    <record id="edu_shift_list" model="ir.ui.view">
        <field name="name">edu.shift.list</field>
        <field name="model">edu.shift</field>
        <field name="arch" type="xml">
            <list string="Turnos" editable="bottom">
                <field name="name"/>
                <field name="shift_type"/>
                <field name="hour_from" widget="float_time" options="{'numeric': True}"/>
                <field name="hour_to" widget="float_time" options="{'numeric': True}"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_edu_shift" model="ir.actions.act_window">
        <field name="name">Turnos</field>
        <field name="res_model">edu.shift</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_edu_facilities" name="Instalações" parent="menu_edu_config" sequence="50">
        <menuitem id="menu_edu_campus" action="action_edu_campus" sequence="10"/>
        <menuitem id="menu_edu_building" action="action_edu_building" sequence="20"/>
        <menuitem id="menu_edu_room" action="action_edu_room" sequence="30"/>
    </menuitem>
    <menuitem id="menu_edu_shift" action="action_edu_shift" parent="menu_edu_config" sequence="40"/>
</odoo>
