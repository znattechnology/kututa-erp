<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Certificado de habilitações do ensino superior: as UCs por ano e semestre, com os créditos, o trabalho final
         e a média final do curso pesada pelos créditos. -->
    <template id="report_certificate_higher" inherit_id="edu_documents.report_certificate">
        <xpath expr="//div[hasclass('page')]/t[@t-if='technical']" position="attributes">
            <attribute name="t-if">technical and not higher</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/t[@t-else='']" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-elif">not higher</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/t[@t-elif='not higher']" position="after">
            <t t-else="">
                <t t-set="ucs" t-value="g.uc_result_ids"/>
                <t t-set="project" t-value="g.final_project_id"/>
                <p>
                    <t t-out="company.edu_director_name"/>, <t t-out="company.edu_director_title or 'Reitor(a)'"/>
                    <t t-out="company.edu_name_of"/>, certifica que <t t-call="edu_documents.identity"/>, concluiu no ano académico
                    <t t-out="g.academic_year_id.name"/> o curso de <t t-out="g.level_id.name"/> em <t t-out="g.course_id.name"/>,
                    com <t t-out="('%g' % g.uc_credits).replace('.', ',')"/> créditos, tendo obtido as seguintes classificações:
                </p>
                <table class="edu-table o_ignore_layout_styling">
                    <thead>
                        <tr>
                            <th>Unidade curricular</th>
                            <th>Ano</th>
                            <th>Semestre</th>
                            <th>Ano académico</th>
                            <th>Créditos</th>
                            <th>Classificação</th>
                            <th>Por extenso</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="ucs" t-as="r">
                            <td t-out="r.subject_id.name"/>
                            <td class="text-center"><t t-out="r.course_year"/>.º</td>
                            <td class="text-center" t-out="'Anual' if r.semester == 'annual' else '%s.º' % r.semester"/>
                            <td class="text-center" t-out="r.academic_year_id.name"/>
                            <td class="text-center" t-out="('%g' % r.credits).replace('.', ',')"/>
                            <td class="text-center" t-out="h.num(r.final_grade)"/>
                            <td t-out="h.words(r.final_grade).capitalize()"/>
                        </tr>
                    </tbody>
                </table>
                <p t-if="project">
                    <t t-out="'Dissertação' if project.edu_kind == 'dissertation' else 'Trabalho de fim de curso'"/>:
                    «<t t-out="project.name"/>», defendido a <t t-out="h.date(project.defense_date)"/>, com a classificação de
                    <t t-out="h.grade(project.grade, 'title')"/>.
                </p>
                <p>
                    <strong>Média final do curso: <t t-out="h.grade(g.final_grade, 'title')"/></strong> (média das
                    classificações das unidades curriculares pesada pelos créditos).
                </p>
                <p><strong>OBS: O presente Certificado destina-se para <t t-out="o.purpose"/>.</strong></p>
                <p>
                    Por ser verdade e me ter sido solicitado e assim constar nos documentos que ficam arquivados nos serviços
                    académicos, mandei passar o presente Certificado, que vai por mim assinado e autenticado com o selo branco em
                    uso nesta instituição.
                </p>
            </t>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-set="higher" t-value="g.level_id.subsystem == 'higher'"/>
        </xpath>
    </template>

    <!-- Diploma: no superior, o grau conferido, o curso e quem assina (reitor e responsável académico). -->
    <template id="report_diploma_higher" inherit_id="edu_documents.report_diploma">
        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-set="higher" t-value="g.level_id.subsystem == 'higher'"/>
            <t t-set="degree" t-value="('Mestre' if g.level_id.code == 'MESTRADO' else h.by_gender(student.gender, 'Licenciado', 'Licenciada')) if higher else ''"/>
        </xpath>
        <xpath expr="//div[hasclass('edu-subtitle')]" position="attributes">
            <attribute name="t-out">'Formação Média Técnica' if g.level_id.subsystem == 'technical' else ('%s em %s' % (g.level_id.name, g.course_id.name) if higher else g.level_id.name)</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/p[1]" position="attributes">
            <attribute name="t-if">not higher</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/p[3]" position="attributes">
            <attribute name="t-if">not higher</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/p[3]" position="after">
            <t t-if="higher">
                <p>
                    <t t-out="company.edu_director_name"/>, <t t-out="company.edu_director_title or 'Reitor(a)'"/>, e
                    <t t-out="company.edu_pedagogical_director_name"/>, <t t-out="company.edu_pedagogical_title or 'responsável académico(a)'"/>,
                    <t t-out="company.edu_name_of"/>, fazem saber que <t t-call="edu_documents.identity"/>, concluiu no ano académico
                    <t t-out="g.academic_year_id.name"/> o curso de <t t-out="g.level_id.name"/> em <t t-out="g.course_id.name"/>, sendo-lhe
                    conferido o grau de <strong t-out="degree"/>, com a classificação final de
                    <strong t-out="h.grade(g.final_grade, 'title').replace('Valores', 'valores')"/>, conforme consta do processo individual
                    n.º <t t-if="student.process_number" t-out="student.process_number"/><t t-else=""><t t-set="width" t-value="60"/><t t-call="edu_documents.blank"/></t>
                    e da folha n.º <t t-if="g.page_number" t-out="g.page_number"/><t t-else=""><t t-set="width" t-value="50"/><t t-call="edu_documents.blank"/></t>
                    do Livro de Termos n.º <t t-if="g.book_number" t-out="g.book_number"/><t t-else=""><t t-set="width" t-value="50"/><t t-call="edu_documents.blank"/></t>.
                </p>
                <p>
                    Pelo que, para efeitos legais e de harmonia com a legislação em vigor, lhe mandámos passar o presente Diploma, que
                    vai por nós assinado e autenticado com o selo branco em uso nesta instituição.
                </p>
            </t>
        </xpath>
    </template>

    <!-- Cabeçalho oficial: no superior, o Ministério do Ensino Superior, Ciência, Tecnologia e Inovação. -->
    <template id="header_higher" inherit_id="edu_documents.header">
        <xpath expr="//t[@t-if='official']/div[hasclass('edu-state')][1]" position="replace">
            <div class="edu-state">República de Angola<br/><t t-if="company.edu_is_higher">Ministério do Ensino Superior, Ciência, Tecnologia e Inovação</t><t t-else="">Ministério da Educação</t></div>
        </xpath>
    </template>

    <!-- Declaração com notas no superior: as UCs aprovadas até ao ano da matrícula, com créditos e média pesada. -->
    <template id="report_declaration_grades_higher" inherit_id="edu_documents.report_declaration_grades">
        <xpath expr="//div[hasclass('page')]" position="before">
            <t t-set="higher" t-value="e.level_subsystem == 'higher'"/>
            <t t-set="ucs" t-value="e._edu_uc_transcript() if higher else False"/>
        </xpath>
        <xpath expr="//div[hasclass('page')]/p[1]" position="attributes">
            <attribute name="t-if">not higher</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/p[1]" position="after">
            <p t-if="higher"><strong><t t-out="(company.edu_director_name or '').upper()"/>, <t t-out="(company.edu_director_title or 'Reitor(a)').upper()"/> <t t-out="company.edu_name_of.upper()"/>.</strong></p>
        </xpath>
        <xpath expr="//div[hasclass('page')]/p[4]" position="attributes">
            <attribute name="t-if">not higher</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/table" position="attributes">
            <attribute name="t-if">not higher</attribute>
        </xpath>
        <xpath expr="//div[hasclass('page')]/table" position="after">
            <t t-if="higher">
                <t t-set="credits" t-value="sum(ucs.mapped('credits'))"/>
                <p>
                    Está matriculado(a) no ano académico <t t-out="e.academic_year_id.name"/> no <t t-out="e.class_number"/>.º ano do
                    curso de <t t-out="e.course_id.level_id.name"/> em <t t-out="e.course_id.name"/>, tendo obtido aprovação nas
                    seguintes unidades curriculares, num total de <t t-out="('%g' % credits).replace('.', ',')"/> créditos<t t-if="credits">, com a
                    média de <strong t-out="h.grade(sum(r.final_grade * r.credits for r in ucs) / credits)"/></t>:
                </p>
                <table class="edu-table o_ignore_layout_styling">
                    <thead><tr><th>UNIDADE CURRICULAR</th><th>ANO</th><th>ANO ACADÉMICO</th><th>CRÉDITOS</th><th>NOTA</th></tr></thead>
                    <tbody>
                        <tr t-foreach="ucs" t-as="r">
                            <td t-out="r.subject_id.name"/>
                            <td class="text-center"><t t-out="r.course_year"/>.º</td>
                            <td class="text-center" t-out="r.academic_year_id.name"/>
                            <td class="text-center" t-out="('%g' % r.credits).replace('.', ',')"/>
                            <td class="text-center" t-out="h.grade(r.final_grade)"/>
                        </tr>
                    </tbody>
                </table>
            </t>
        </xpath>
        <xpath expr="//t[@t-set='annex']" position="attributes">
            <attribute name="t-value">'Classificações na escala de 0 a 20 valores. Média pesada pelos créditos.' if higher else 'Anexo VI · Despacho n.º 60/08, de 30 de Abril · Classificações na escala de 0 a 20 valores, arredondadas às unidades.'</attribute>
        </xpath>
    </template>
</odoo>
