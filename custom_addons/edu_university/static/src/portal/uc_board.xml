<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- «Minhas notas» no ensino superior: as UCs do ano, com as provas, a MF, a situação, os exames e a nota final. -->
    <t t-name="edu_university.StudentGrades" t-inherit="edu_portal.StudentGrades" t-inherit-mode="extension">
        <xpath expr="//section[@t-elif='!g.active']" position="before">
            <t t-elif="g.higher" t-call="edu_university.Part.UcBoard"/>
        </xpath>
    </t>

    <!-- O painel: no superior, as UCs (nota final ou MF) e os créditos do curso, em vez dos trimestres. -->
    <t t-name="edu_university.StudentHome" t-inherit="edu_portal.StudentHome" t-inherit-mode="extension">
        <xpath expr="//h2[@id='o_edu_st_chart_grades']" position="replace">
            <h2 id="o_edu_st_chart_grades" class="o_edu_st_h2 mb-0">
                <t t-if="g.higher">Unidades curriculares</t>
                <t t-else="">Notas do <t t-out="g.active ? g.active.name : 'trimestre'"/></t>
            </h2>
        </xpath>
        <xpath expr="//section[@aria-labelledby='o_edu_st_chart_grades']/p[@t-elif='!g.active']" position="before">
            <t t-elif="g.higher">
                <p class="small text-muted mb-3">A nota final quando já existe; antes, a média de frequência (MF).</p>
                <div class="o_edu_hbars" role="list">
                    <div t-foreach="g.ucs.filter((u) => u.final or u.mf)" t-as="u" t-key="u.id" class="o_edu_hbar_row" role="listitem">
                        <t t-set="v" t-value="u.final or u.mf"/>
                        <span class="o_edu_hbar_name" t-out="u.name"/>
                        <span class="o_edu_hbar_track">
                            <span class="o_edu_hbar_pass" t-att-style="'left: ' + this.passLeft + '%'"/>
                            <span class="o_edu_hbar" t-att-class="{'o_edu_chart_neg': !v.pos}" t-att-style="'width: ' + (v.value * 5) + '%'"/>
                        </span>
                        <span class="o_edu_hbar_value"><t t-out="v.text"/><span class="small text-muted"> <t t-out="u.final ? 'final' : 'MF'"/></span></span>
                    </div>
                </div>
                <t t-set="ungraded" t-value="g.ucs.filter((u) => !u.final and !u.mf and u.state_key !== 'dropped')"/>
                <p t-if="ungraded.length" class="small mb-0 mt-3"><span class="text-muted">Sem nota (<t t-out="ungraded.length"/>):</span> <t t-out="this.list(ungraded.map((u) => u.name))"/>.</p>
            </t>
        </xpath>
        <xpath expr="//section[@aria-labelledby='o_edu_st_chart_trend']" position="attributes">
            <attribute name="t-if">!g.higher</attribute>
        </xpath>
        <xpath expr="//section[@aria-labelledby='o_edu_st_chart_trend']" position="after">
            <section t-if="g.higher" class="o_edu_st_card" aria-labelledby="o_edu_st_credits">
                <h2 id="o_edu_st_credits" class="o_edu_st_h2">Créditos do curso</h2>
                <p class="mb-1"><span class="fs-3 fw-semibold" t-out="g.credits_earned"/> de <t t-out="g.credits_course"/></p>
                <div class="progress" role="progressbar" t-att-aria-valuenow="g.credits_pct" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
                    <div class="progress-bar" t-att-style="'width: ' + g.credits_pct + '%'"/>
                </div>
                <p class="small text-muted mb-0 mt-2"><t t-out="g.credits_pct"/>% do curso concluído<t t-if="g.course_average">, média <t t-out="g.course_average.text"/></t>.</p>
            </section>
        </xpath>
    </t>

    <t t-name="edu_university.Part.UcBoard">
        <div class="o_edu_kpis">
            <div class="o_edu_kpi">
                <span class="o_edu_kpi_label">Créditos do curso</span>
                <span class="o_edu_kpi_value"><t t-out="g.credits_earned"/> de <t t-out="g.credits_course"/></span>
                <span class="o_edu_kpi_detail"><t t-out="g.credits_pct"/>% do curso concluído</span>
            </div>
            <div class="o_edu_kpi">
                <span class="o_edu_kpi_label">Média do curso</span>
                <span class="o_edu_kpi_value" t-att-class="{'text-danger': g.course_average and !g.course_average.pos}" t-out="this.gradeText(g.course_average)"/>
                <span class="o_edu_kpi_detail">pesada pelos créditos</span>
            </div>
            <div class="o_edu_kpi">
                <span class="o_edu_kpi_label">UCs aprovadas este ano</span>
                <span class="o_edu_kpi_value"><t t-out="g.passed_count"/> de <t t-out="g.ucs.length"/></span>
                <span class="o_edu_kpi_detail"><t t-out="g.credits_year"/> créditos inscritos</span>
            </div>
            <div class="o_edu_kpi">
                <span class="o_edu_kpi_label">Para exame</span>
                <span class="o_edu_kpi_value" t-att-class="{'text-danger': g.exam_count}" t-out="g.exam_count"/>
                <span class="o_edu_kpi_detail">admitido(a), sem nota final</span>
            </div>
        </div>
        <div t-if="g.year_result" class="alert mb-0" t-att-class="g.year_result.bad ? 'alert-danger' : (g.year_result.good ? 'alert-success' : 'alert-warning')">
            <t t-set="r" t-value="g.year_result"/>
            <span class="fw-semibold">Resultado do ano: <t t-out="r.status"/></span><t t-if="r.average">, com média de <t t-out="r.average"/></t>.
            <t t-if="r.negatives.length"> Por aprovar: <t t-out="this.list(r.negatives)"/>.</t>
        </div>
        <section t-if="!g.ucs.length" class="o_edu_st_card text-muted">Ainda não estás inscrito(a) em unidades curriculares.</section>
        <div t-else="" class="o_edu_st_card p-0 o_edu_st_scroll">
            <table class="table table-sm mb-0 o_edu_st_table">
                <thead>
                    <tr>
                        <th>Unidade curricular</th>
                        <th class="text-center">Créditos</th>
                        <th>Provas e trabalhos</th>
                        <th class="text-center" title="Média de frequência">MF</th>
                        <th>Frequência</th>
                        <th>Exames</th>
                        <th class="text-center o_edu_st_sep" title="Nota final">Final</th>
                        <th>Situação</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="g.ucs" t-as="u" t-key="u.id" t-att-class="{'text-muted': u.state_key === 'dropped'}">
                        <td>
                            <div t-out="u.name"/>
                            <div class="small text-muted"><t t-out="u.year"/>.º ano · <t t-out="u.semester"/><t t-if="u.backlog"> · em atraso</t></div>
                        </td>
                        <td class="text-center" t-out="u.credits"/>
                        <td>
                            <span t-if="!u.components.length" class="text-muted">—</span>
                            <span t-foreach="u.components" t-as="c" t-key="c_index" class="me-2 text-nowrap">
                                <span class="small text-muted" t-out="c.name + ' '"/><span t-att-class="this.gradeClass(c.value)" t-out="this.gradeText(c.value)"/>
                            </span>
                        </td>
                        <td class="text-center"><span t-att-class="this.gradeClass(u.mf, true)" t-out="this.gradeText(u.mf)"/></td>
                        <td>
                            <span t-out="u.status"/>
                            <div t-if="u.attendance !== null" class="small text-muted">presenças <t t-out="u.attendance"/>%</div>
                        </td>
                        <td>
                            <span t-if="!u.exams.length" class="text-muted">—</span>
                            <span t-foreach="u.exams" t-as="x" t-key="x_index" class="me-2 text-nowrap">
                                <span class="small text-muted" t-out="x.label + ' '"/><span t-att-class="this.gradeClass(x.value)" t-out="this.gradeText(x.value)"/>
                            </span>
                        </td>
                        <td class="text-center o_edu_st_sep"><span t-att-class="this.gradeClass(u.final, true)" t-out="this.gradeText(u.final)"/></td>
                        <td>
                            <span t-att-class="{'text-primary fw-semibold': u.state_key === 'passed', 'text-danger fw-semibold': u.state_key === 'failed'}" t-out="u.state"/>
                            <div t-if="u.source and u.final" class="small text-muted" t-out="u.source"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="small text-muted mb-0">Aprovação com <t t-out="g.pass_text"/> valores. A situação por frequência fica definitiva quando o semestre fecha.</p>
    </t>
</templates>
