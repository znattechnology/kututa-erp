<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_curriculum_form_university" model="ir.ui.view">
        <field name="name">edu.curriculum.form.university</field>
        <field name="model">edu.curriculum</field>
        <field name="inherit_id" ref="edu_core.edu_curriculum_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='year_ids']/list/field[@name='weekly_hours']" position="after">
                <field name="edu_is_higher" column_invisible="True"/>
                <field name="credits" column_invisible="not parent.edu_is_higher"/>
            </xpath>
            <xpath expr="//field[@name='year_ids']/form//field[@name='weekly_hours']" position="after">
                <field name="edu_is_higher" invisible="1"/>
                <field name="credits" invisible="not edu_is_higher"/>
            </xpath>
            <xpath expr="//field[@name='year_ids']/form//field[@name='class_number']" position="attributes">
                <attribute name="invisible">edu_is_higher</attribute>
            </xpath>
            <xpath expr="//field[@name='year_ids']/list/field[@name='class_number']" position="attributes">
                <attribute name="column_invisible">parent.edu_is_higher</attribute>
            </xpath>
            <xpath expr="//field[@name='year_ids']/form//field[@name='line_ids']/list/field[@name='weekly_hours']" position="after">
                <field name="edu_is_higher" column_invisible="True"/>
                <field name="semester" column_invisible="not parent.edu_is_higher"/>
                <field name="credits" sum="Total" column_invisible="not parent.edu_is_higher"/>
                <field name="contact_hours" sum="Total" column_invisible="not parent.edu_is_higher"/>
                <field name="uc_type" column_invisible="not parent.edu_is_higher"/>
                <field name="is_final_work" column_invisible="not parent.edu_is_higher"/>
            </xpath>
            <xpath expr="//field[@name='year_ids']/form//field[@name='line_ids']/list/field[@name='is_compulsory']" position="attributes">
                <attribute name="column_invisible">parent.edu_is_higher</attribute>
            </xpath>
            <xpath expr="//field[@name='year_ids']/form//field[@name='line_ids']/list/field[@name='is_national_exam']" position="attributes">
                <attribute name="column_invisible">parent.edu_is_higher</attribute>
            </xpath>
            <xpath expr="//field[@name='year_ids']" position="before">
                <field name="edu_is_higher" invisible="1"/>
                <div invisible="not edu_is_higher" class="mb-2">
                    <span class="fw-bold">Créditos do curso: </span><field name="total_credits" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
