<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_graduation_register_form" model="ir.ui.view">
        <field name="name">edu.graduation.register.form</field>
        <field name="model">edu.graduation.register</field>
        <field name="arch" type="xml">
            <form string="Registar conclusões">
                <group>
                    <group>
                        <field name="academic_year_id" options="{'no_create': True}"/>
                        <field name="class_id" options="{'no_create': True}"/>
                        <field name="final_class_ids" invisible="1"/>
                    </group>
                </group>
                <div class="text-muted" invisible="not message"><field name="message" nolabel="1"/></div>
                <field name="result_ids" invisible="not class_id or not result_ids" readonly="1">
                    <list>
                        <field name="order_number"/>
                        <field name="student_id"/>
                        <field name="average" string="Média final"/>
                        <field name="status"/>
                        <field name="graduation_id" string="Registado"/>
                    </list>
                </field>
                <footer>
                    <button name="action_register_all" type="object" string="Registar os que faltam" class="btn-primary"
                            invisible="not result_ids"/>
                    <button special="cancel" string="Fechar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_edu_graduation_register" model="ir.actions.act_window">
        <field name="name">Registar conclusões</field>
        <field name="res_model">edu.graduation.register</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="edu_internship_list" model="ir.ui.view">
        <field name="name">edu.internship.list</field>
        <field name="model">edu.internship</field>
        <field name="arch" type="xml">
            <list string="Estágios">
                <field name="student_id"/>
                <field name="course_id" optional="show"/>
                <field name="entity"/>
                <field name="tutor_id" optional="show"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="hours" optional="show"/>
                <field name="grade"/>
                <field name="state" widget="badge" decoration-success="state == 'passed'" decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>
    <record id="edu_internship_form" model="ir.ui.view">
        <field name="name">edu.internship.form</field>
        <field name="model">edu.internship</field>
        <field name="arch" type="xml">
            <form string="Estágio curricular">
                <header>
                    <button name="action_start" type="object" string="Marcar «a decorrer»" class="btn-primary" invisible="state != 'planned' or not id"/>
                    <button name="action_evaluate" type="object" string="Fechar com a nota" invisible="state != 'ongoing'"/>
                    <button name="action_reopen" type="object" string="Reabrir" invisible="state not in ('passed', 'failed', 'cancelled')"
                            groups="edu_core.group_edu_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,ongoing,passed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="enrollment_id" options="{'no_create': True}"/>
                            <field name="academic_year_id"/>
                            <field name="entity"/>
                            <field name="supervisor"/>
                            <field name="supervisor_contact"/>
                            <field name="tutor_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="hours"/>
                            <field name="grade"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Apreciação">
                            <field name="appraisal" placeholder="O parecer do tutor ou do supervisor sobre o estágio"/>
                        </page>
                        <page string="Relatórios entregues">
                            <field name="report_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="file" filename="file_name"/>
                                    <field name="file_name" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observações">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!-- Estágios e PAP (acções cliente), como no secPed: lista, novo por turma e ficha de acompanhamento. O professor
         abre as mesmas páginas e vê os seus orientandos. -->
    <record id="action_edu_internships" model="ir.actions.client">
        <field name="name">Estágios</field>
        <field name="tag">edu_records.training</field>
        <field name="context">{'training_kind': 'internship'}</field>
    </record>
    <record id="action_edu_internship_new_page" model="ir.actions.client">
        <field name="name">Novo estágio</field>
        <field name="tag">edu_records.training</field>
        <field name="context">{'training_kind': 'internship', 'training_new': True}</field>
    </record>
    <record id="action_edu_final_projects" model="ir.actions.client">
        <field name="name">Trabalho de fim de curso</field>
        <field name="tag">edu_records.training</field>
        <field name="context">{'training_kind': 'project'}</field>
    </record>
    <record id="action_edu_internship" model="ir.actions.act_window">
        <field name="name">Estágios curriculares</field>
        <field name="res_model">edu.internship</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="edu_final_project_list" model="ir.ui.view">
        <field name="name">edu.final.project.list</field>
        <field name="model">edu.final.project</field>
        <field name="arch" type="xml">
            <list string="PAP">
                <field name="student_id"/>
                <field name="name"/>
                <field name="advisor_id" optional="show"/>
                <field name="defense_date"/>
                <field name="grade"/>
                <field name="state" widget="badge" decoration-success="state == 'passed'" decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>
    <record id="edu_final_project_form" model="ir.ui.view">
        <field name="name">edu.final.project.form</field>
        <field name="model">edu.final.project</field>
        <field name="arch" type="xml">
            <form string="Prova de Aptidão Profissional">
                <header>
                    <button name="action_start" type="object" string="Marcar «em elaboração»" invisible="state != 'proposed' or not id"/>
                    <button name="action_submit" type="object" string="Registar a entrega" invisible="state not in ('proposed', 'ongoing') or not id"/>
                    <button name="action_evaluate" type="object" string="Registar o resultado da defesa" class="btn-primary"
                            invisible="state in ('passed', 'failed') or not id"/>
                    <button name="action_reopen" type="object" string="Reabrir" invisible="state not in ('passed', 'failed')"
                            groups="edu_core.group_edu_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="proposed,ongoing,submitted,passed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Tema da PAP"/></h1></div>
                    <group>
                        <group>
                            <field name="student_id" options="{'no_create': True}"/>
                            <field name="enrollment_id" options="{'no_create': True}"/>
                            <field name="advisor_id" options="{'no_create': True}"/>
                            <field name="jury_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="submitted_date"/>
                            <field name="defense_date"/>
                            <field name="grade"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Resumo do projecto"/>
                    <field name="note" placeholder="Observações"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_edu_final_project" model="ir.actions.act_window">
        <field name="name">Provas de Aptidão Profissional</field>
        <field name="res_model">edu.final.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="edu_graduation_list" model="ir.ui.view">
        <field name="name">edu.graduation.list</field>
        <field name="model">edu.graduation</field>
        <field name="arch" type="xml">
            <list string="Diplomas e certificados" decoration-muted="state == 'cancelled'">
                <header>
                    <button name="%(action_edu_graduation_register)d" type="action" string="Registar conclusões"
                            class="btn-primary" display="always"/>
                </header>
                <field name="student_id"/>
                <field name="diploma_number" string="Diploma n.º" optional="show"/>
                <field name="course_id"/>
                <field name="academic_year_id"/>
                <field name="final_grade" string="Média final"/>
                <field name="date" string="Concluiu"/>
                <field name="diploma_state" widget="badge" decoration-success="diploma_state == 'signed'"
                       decoration-warning="diploma_state == 'to_verify'" decoration-info="diploma_state == 'to_sign'"
                       invisible="state != 'issued'"/>
                <field name="state" widget="badge" decoration-success="state == 'issued'" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="edu_graduation_form" model="ir.ui.view">
        <field name="name">edu.graduation.form</field>
        <field name="model">edu.graduation</field>
        <field name="arch" type="xml">
            <form string="Conclusão de curso">
                <header>
                    <button name="action_compute" type="object" string="Calcular" invisible="state != 'draft'"/>
                    <button name="action_issue" type="object" string="Emitir" class="btn-primary" invisible="state != 'draft'"
                            confirm="Atribui o número de diploma. Continuar?"/>
                    <button name="action_mark_verified" type="object" string="Marcar como verificado"
                            invisible="state != 'issued' or verified_by_id"/>
                    <button name="action_mark_signed" type="object" string="Marcar como assinado"
                            invisible="state != 'issued' or not verified_by_id or signed_by_id" groups="edu_core.group_edu_manager"/>
                    <button name="action_cancel" type="object" string="Anular" invisible="state != 'issued'" groups="edu_core.group_edu_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="student_id" readonly="1"/></h1>
                        <h3 invisible="not diploma_number">Diploma n.º <field name="diploma_number" class="oe_inline"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="year_result_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="course_id"/>
                            <field name="level_id"/>
                            <field name="academic_year_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="plan_average"/>
                            <field name="internship_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="final_project_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="final_grade" class="fw-bold"/>
                            <field name="book_number"/>
                            <field name="page_number"/>
                        </group>
                    </group>
                    <group string="Validação do diploma" invisible="state != 'issued'">
                        <group>
                            <field name="diploma_state"/>
                            <field name="verified_by_id" invisible="not verified_by_id"/>
                            <field name="verified_date" invisible="not verified_date"/>
                        </group>
                        <group>
                            <field name="signed_by_id" invisible="not signed_by_id"/>
                            <field name="signed_date" invisible="not signed_date"/>
                        </group>
                        <div colspan="2" class="text-muted small">Quem marca fica registado como quem verificou ou assinou.</div>
                    </group>
                    <field name="final_result_ids">
                        <list>
                            <field name="subject_id"/>
                            <field name="academic_year_id"/>
                            <field name="final"/>
                            <field name="cfd"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="edu_graduation_search" model="ir.ui.view">
        <field name="name">edu.graduation.search</field>
        <field name="model">edu.graduation</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="diploma_number"/>
                <field name="course_id"/>
                <filter name="current_year" string="Ano em curso" domain="[('academic_year_id.is_current', '=', True)]"/>
                <separator/>
                <filter name="to_verify" string="Por verificar" domain="[('state', '=', 'issued'), ('diploma_state', '=', 'to_verify')]"/>
                <filter name="to_sign" string="Falta assinar" domain="[('state', '=', 'issued'), ('diploma_state', '=', 'to_sign')]"/>
                <filter name="signed" string="Assinados" domain="[('diploma_state', '=', 'signed')]"/>
                <filter name="draft" string="Rascunhos" domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_year" string="Ano lectivo" context="{'group_by': 'academic_year_id'}"/>
                    <filter name="group_course" string="Curso" context="{'group_by': 'course_id'}"/>
                    <filter name="group_diploma" string="Diploma" context="{'group_by': 'diploma_state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_edu_graduation" model="ir.actions.act_window">
        <field name="name">Diplomas e certificados</field>
        <field name="res_model">edu.graduation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="edu_graduation_search"/>
        <field name="context">{'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ainda não há conclusões neste ano</p>
            <p>Os alunos que concluíram o curso. Daqui imprime-se o diploma e o certificado de habilitações;
            «Registar conclusões» traz os alunos da turma da classe final que o conselho de turma deu como tendo concluído.</p>
        </field>
    </record>
    <record id="edu_course_form_training_area" model="ir.ui.view">
        <field name="name">edu.course.form.training.area</field>
        <field name="model">edu.course</field>
        <field name="inherit_id" ref="edu_core.edu_course_form"/>
        <field name="arch" type="xml">
            <field name="level_id" position="after">
                <field name="training_area"/>
            </field>
        </field>
    </record>

    <record id="edu_year_result_form_records" model="ir.ui.view">
        <field name="name">edu.year.result.form.records</field>
        <field name="model">edu.year.result</field>
        <field name="inherit_id" ref="edu_evaluation.edu_year_result_form"/>
        <field name="arch" type="xml">
            <button name="action_recompute" position="after">
                <button name="action_register_graduation" type="object" string="Registar a conclusão" invisible="status != 'graduated'"/>
            </button>
        </field>
    </record>

    <record id="edu_student_form_records" model="ir.ui.view">
        <field name="name">edu.student.form.records</field>
        <field name="model">edu.student</field>
        <field name="inherit_id" ref="edu_people.edu_student_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_history" type="object" class="oe_stat_button" icon="history" string="Histórico escolar"/>
            </div>
            <field name="enrollment_date" position="before">
                <field name="process_number"/>
            </field>
        </field>
    </record>

    <!-- Histórico do aluno, como no secPed: um ano lectivo por linha (média, assiduidade, resultado) e os termos. -->
    <record id="edu_subject_result_history_list" model="ir.ui.view">
        <field name="name">edu.subject.result.history.list</field>
        <field name="model">edu.subject.result</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Classificações" create="0" edit="0" delete="0">
                <field name="academic_year_id" column_invisible="1"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="cf"/>
                <field name="pg" optional="show"/>
                <field name="final"/>
                <field name="cfd" optional="show"/>
                <field name="passed" widget="boolean"/>
            </list>
        </field>
    </record>
    <record id="edu_student_history_form" model="ir.ui.view">
        <field name="name">edu.student.history.form</field>
        <field name="model">edu.student</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Histórico do aluno" create="0" edit="0" delete="0">
                <header/>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_view_subject_history" type="object" class="oe_stat_button" icon="list_alt"
                                string="Classificações por disciplina"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted">
                            <field name="current_class_id" readonly="1" class="d-inline"/>
                            <span invisible="not process_number"> · processo n.º <field name="process_number" readonly="1" class="d-inline"/></span>
                        </div>
                    </div>
                    <p><field name="history_summary" readonly="1"/></p>
                    <field name="year_result_ids" readonly="1" nolabel="1">
                        <list default_order="academic_year_id" decoration-muted="status == 'pending'">
                            <field name="academic_year_id"/>
                            <field name="class_id"/>
                            <field name="average" string="Média final" decoration-info="average &gt;= 10" decoration-danger="average &lt; 10"/>
                            <field name="attendance_rate" string="Assiduidade" widget="percentage" invisible="not attendance_rate"/>
                            <field name="status" string="Resultado" widget="badge" decoration-success="status in ('promoted', 'graduated', 'conditional')"
                                   decoration-danger="status == 'retained'" decoration-warning="status in ('exam', 'pending')"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_edu_records" name="Arquivo" parent="edu_core.menu_edu_root" sequence="38" groups="edu_core.group_edu_user">
        <menuitem id="menu_edu_graduation" action="action_edu_graduation" sequence="10"/>
        <menuitem id="menu_edu_internship" action="action_edu_internships" sequence="20"/>
        <menuitem id="menu_edu_final_project" action="action_edu_final_projects" sequence="30"/>
    </menuitem>
</odoo>
