<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_class_form_attendance" model="ir.ui.view">
        <field name="name">edu.class.form.attendance</field>
        <field name="model">edu.class</field>
        <field name="inherit_id" ref="edu_core.edu_class_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_lessons" type="object" class="oe_stat_button" icon="fa-book">
                    <field name="lesson_count" widget="statinfo" string="Aulas"/>
                </button>
                <button name="action_view_absences" type="object" class="oe_stat_button" icon="fa-user-times" string="Faltas"/>
            </div>
        </field>
    </record>
</odoo>
