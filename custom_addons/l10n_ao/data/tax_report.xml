<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Declaração periódica de IVA (estrutura simplificada; validar contra o modelo oficial da AGT). -->
    <record id="tax_report" model="account.report">
        <field name="name">Declaração periódica de IVA</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.ao"/>
        <field name="availability_condition">country</field>
        <field name="column_ids">
            <record id="tax_report_balance" model="account.report.column">
                <field name="name">Montante</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="tax_report_section_vendas" model="account.report.line">
                <field name="name">Operações activas (transmissões de bens e prestações de serviços)</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="tax_report_line_bt14" model="account.report.line">
                        <field name="name">Base tributável à taxa de 14%</field>
                        <field name="code">AO_BT14</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bt14_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-BT14</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_il14" model="account.report.line">
                        <field name="name">IVA liquidado à taxa de 14%</field>
                        <field name="code">AO_IL14</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_il14_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-IL14</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bt7" model="account.report.line">
                        <field name="name">Base tributável à taxa de 7%</field>
                        <field name="code">AO_BT7</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bt7_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-BT7</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_il7" model="account.report.line">
                        <field name="name">IVA liquidado à taxa de 7%</field>
                        <field name="code">AO_IL7</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_il7_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-IL7</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bt5" model="account.report.line">
                        <field name="name">Base tributável à taxa de 5%</field>
                        <field name="code">AO_BT5</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bt5_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-BT5</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_il5" model="account.report.line">
                        <field name="name">IVA liquidado à taxa de 5%</field>
                        <field name="code">AO_IL5</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_il5_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-IL5</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bt1" model="account.report.line">
                        <field name="name">Base tributável à taxa de 1% (Cabinda)</field>
                        <field name="code">AO_BT1</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bt1_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-BT1</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_il1" model="account.report.line">
                        <field name="name">IVA liquidado à taxa de 1% (Cabinda)</field>
                        <field name="code">AO_IL1</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_il1_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-IL1</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bise" model="account.report.line">
                        <field name="name">Operações isentas</field>
                        <field name="code">AO_BISE</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bise_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-BISE</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bexp" model="account.report.line">
                        <field name="name">Exportações e operações assimiladas (isentas)</field>
                        <field name="code">AO_BEXP</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bexp_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-BEXP</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bns" model="account.report.line">
                        <field name="name">Operações não sujeitas</field>
                        <field name="code">AO_BNS</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bns_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-BNS</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="tax_report_section_compras" model="account.report.line">
                <field name="name">Operações passivas (aquisições)</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="tax_report_line_bc14" model="account.report.line">
                        <field name="name">Aquisições com IVA dedutível à taxa de 14% (base)</field>
                        <field name="code">AO_BC14</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bc14_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">BC14</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_id14" model="account.report.line">
                        <field name="name">IVA dedutível à taxa de 14%</field>
                        <field name="code">AO_ID14</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_id14_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">ID14</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bc7" model="account.report.line">
                        <field name="name">Aquisições com IVA dedutível à taxa de 7% (base)</field>
                        <field name="code">AO_BC7</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bc7_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">BC7</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_id7" model="account.report.line">
                        <field name="name">IVA dedutível à taxa de 7%</field>
                        <field name="code">AO_ID7</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_id7_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">ID7</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bc5" model="account.report.line">
                        <field name="name">Aquisições com IVA dedutível à taxa de 5% (base)</field>
                        <field name="code">AO_BC5</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bc5_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">BC5</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_id5" model="account.report.line">
                        <field name="name">IVA dedutível à taxa de 5%</field>
                        <field name="code">AO_ID5</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_id5_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">ID5</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bcnd" model="account.report.line">
                        <field name="name">Aquisições com IVA não dedutível (base)</field>
                        <field name="code">AO_BCND</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bcnd_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">BCND</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bcise" model="account.report.line">
                        <field name="name">Aquisições isentas ou não sujeitas</field>
                        <field name="code">AO_BCISE</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bcise_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">BCISE</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_bal" model="account.report.line">
                        <field name="name">Serviços adquiridos no estrangeiro - autoliquidação (base)</field>
                        <field name="code">AO_BAL</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_bal_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">BAL</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_iall" model="account.report.line">
                        <field name="name">IVA autoliquidado (a favor do Estado)</field>
                        <field name="code">AO_IALL</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_iall_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-IALL</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_iald" model="account.report.line">
                        <field name="name">IVA autoliquidado dedutível</field>
                        <field name="code">AO_IALD</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_iald_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">IALD</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="tax_report_section_apuramento" model="account.report.line">
                <field name="name">Apuramento</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="tax_report_line_estado" model="account.report.line">
                        <field name="name">IVA a favor do Estado</field>
                        <field name="code">AO_ESTADO</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_estado_agg" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">AO_IL14.balance + AO_IL7.balance + AO_IL5.balance + AO_IL1.balance + AO_IALL.balance</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_sp" model="account.report.line">
                        <field name="name">IVA a favor do sujeito passivo</field>
                        <field name="code">AO_SP</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_sp_agg" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">AO_ID14.balance + AO_ID7.balance + AO_ID5.balance + AO_IALD.balance</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_line_saldo" model="account.report.line">
                        <field name="name">Imposto a pagar (+) / a recuperar (-)</field>
                        <field name="code">AO_SALDO</field>
                        <field name="expression_ids">
                            <record id="tax_report_line_saldo_agg" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">AO_ESTADO.balance - AO_SP.balance</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
