<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_l10n_ao" model="ir.ui.view">
        <field name="name">res.company.form.l10n_ao</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="l10n_ao_vat_regime" invisible="country_code != 'AO'"/>
                <field name="l10n_ao_cae_id" invisible="country_code != 'AO'" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
