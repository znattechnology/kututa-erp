<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_l10n_ao" model="ir.ui.view">
        <field name="name">account.tax.form.l10n_ao</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <page name="advanced_options" position="after">
                <page string="Angola (AGT)" name="l10n_ao" invisible="country_code != 'AO'">
                    <group>
                        <group>
                            <field name="l10n_ao_tax_type"/>
                            <field name="l10n_ao_tax_code"/>
                            <field name="l10n_ao_tax_region"/>
                        </group>
                        <group>
                            <field name="l10n_ao_exemption_id"
                                   required="l10n_ao_tax_type == 'NS' or l10n_ao_tax_code == 'ISE'"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
