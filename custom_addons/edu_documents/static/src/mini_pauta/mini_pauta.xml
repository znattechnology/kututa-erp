<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edu_documents.MiniPauta">
        <div class="o_action o_edu_mini_pauta">
            <Layout display="this.display">
                <div class="o_edu_mp_body">
                    <div class="o_edu_mp_toolbar">
                        <select class="form-select o_edu_mp_year" aria-label="Ano lectivo" t-on-change="(ev) => this.onYearChange(ev)">
                            <option t-foreach="this.state.years" t-as="y" t-key="y.id" t-att-value="y.id"
                                    t-att-selected="y.id === this.state.yearId">
                                <t t-out="y.name"/><t t-if="y.is_current"> (em curso)</t>
                            </option>
                        </select>
                        <div t-if="this.state.trimesters.length" role="tablist" aria-label="Trimestre" class="btn-group">
                            <button t-foreach="this.state.trimesters" t-as="t" t-key="t.id" type="button" role="tab"
                                    class="btn" t-att-class="t.id === this.state.trimesterId ? 'btn-primary' : 'btn-secondary'"
                                    t-att-aria-selected="t.id === this.state.trimesterId ? 'true' : 'false'"
                                    t-on-click="() => this.selectTrimester(t)">
                                <t t-out="t.name"/><span t-if="t.is_current" class="o_edu_mp_tag"> · em curso</span>
                            </button>
                        </div>
                        <span t-else="" class="text-muted">Este ano lectivo ainda não tem trimestres.</span>
                        <span class="flex-grow-1"/>
                        <button t-if="this.state.url" type="button" class="btn btn-primary" t-att-disabled="this.state.busy"
                                t-on-click="() => this.print()">
                            <i class="oi me-1" data-icon="print" aria-hidden="true"/>Imprimir
                        </button>
                    </div>

                    <div class="o_edu_mp_layout">
                        <aside class="o_edu_mp_panel" aria-label="Turmas">
                            <input type="search" class="form-control form-control-sm o_edu_mp_search" placeholder="Procurar a turma…"
                                   aria-label="Procurar a turma" t-att-value="this.state.filter"
                                   t-on-input="(ev) => this.state.filter = ev.target.value"/>
                            <p t-if="!this.classGroups.length" class="small text-muted mt-2">
                                <t t-out="this.state.classes.length ? 'Nenhuma turma.' : 'Não há turmas neste ano lectivo.'"/>
                            </p>
                            <section t-foreach="this.classGroups" t-as="g" t-key="g.course">
                                <h6 class="o_edu_mp_panel_head" t-out="g.course"/>
                                <button t-foreach="g.classes" t-as="c" t-key="c.id" type="button" class="o_edu_mp_panel_item"
                                        t-att-class="{ o_active: c.id === this.state.classId }" t-att-aria-pressed="c.id === this.state.classId"
                                        t-on-click="() => this.selectClass(c.id)">
                                    <span class="text-truncate" t-out="c.name"/>
                                    <span class="small text-muted text-nowrap" t-out="c.students"/>
                                </button>
                            </section>
                        </aside>

                        <section class="o_edu_mp_sheet">
                            <p t-if="!this.selectedClass" class="o_edu_mp_empty">
                                Escolha a turma à esquerda: a mini-pauta aparece aqui, numa folha A4 pronta a imprimir e
                                assinar (a nota de cada aluno por disciplina e as faltas justificadas e injustificadas).
                            </p>
                            <p t-elif="this.state.error" class="o_edu_mp_empty" t-out="this.state.error"/>
                            <iframe t-elif="this.state.url" class="o_edu_mp_frame" t-att-src="this.state.url"
                                    t-att-title="'Mini-pauta · ' + this.selectedClass.name" t-on-load="(ev) => this.onFrameLoad(ev)"/>
                            <p t-else="" class="o_edu_mp_empty">A preparar a mini-pauta…</p>
                        </section>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

</templates>
