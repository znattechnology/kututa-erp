<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edu_documents.Graduations">
        <div class="o_action o_edu_graduations">
            <Layout display="this.display">
                <div class="o_edu_gr_body">
                    <!-- Lista -->
                    <t t-if="this.state.mode === 'list'">
                        <div class="o_edu_gr_bar">
                            <select class="form-select o_edu_gr_select" aria-label="Ano lectivo" t-on-change="(ev) => this.onYearChange(ev)">
                                <option value="" t-att-selected="!this.state.yearId">Todos os anos</option>
                                <option t-foreach="this.state.years" t-as="y" t-key="y.id" t-att-value="y.id"
                                        t-att-selected="y.id === this.state.yearId">
                                    <t t-out="y.name"/><t t-if="y.is_current"> (em curso)</t>
                                </option>
                            </select>
                            <select class="form-select o_edu_gr_select" aria-label="Curso" t-on-change="(ev) => this.onCourseChange(ev)">
                                <option value="" t-att-selected="!this.state.courseId">Todos os cursos</option>
                                <option t-foreach="this.state.courses" t-as="c" t-key="c.id" t-att-value="c.id"
                                        t-att-selected="c.id === this.state.courseId" t-out="c.name"/>
                            </select>
                            <span class="flex-grow-1"/>
                            <button type="button" class="btn btn-primary" t-on-click="() => this.openRegister()">
                                <i class="oi me-1" data-icon="add" aria-hidden="true"/>Registar conclusões
                            </button>
                        </div>

                        <div role="tablist" aria-label="Estado do diploma" class="o_edu_gr_tabs">
                            <button t-foreach="this.tabs" t-as="tab" t-key="tab.key" type="button" role="tab" class="btn btn-sm"
                                    t-att-class="tab.key === this.state.tab ? 'btn-primary' : 'btn-secondary'"
                                    t-att-aria-selected="tab.key === this.state.tab ? 'true' : 'false'"
                                    t-on-click="() => this.state.tab = tab.key">
                                <t t-out="tab.label"/> (<t t-out="tab.count"/>)
                            </button>
                        </div>
                        <p t-if="this.summaryText" class="o_edu_gr_summary" t-out="this.summaryText"/>

                        <div t-if="!this.visibleRows.length" class="o_edu_gr_empty">
                            <t t-if="this.state.rows.length">Nenhum diploma neste estado.</t>
                            <t t-else="" t-out="this.emptyText"/>
                        </div>
                        <div t-else="" class="o_edu_gr_grid">
                            <article t-foreach="this.visibleRows" t-as="g" t-key="g.id" class="o_edu_gr_item"
                                     t-att-class="'o_edu_gr_tone_' + g.tone">
                                <header class="o_edu_gr_item_head">
                                    <div class="min-w-0">
                                        <h3 class="o_edu_gr_student" t-out="g.student"/>
                                        <div class="small text-muted">
                                            <t t-out="g.course"/><t t-if="g.course_code"> (<t t-out="g.course_code"/>)</t>
                                            · <t t-out="g.year"/>
                                        </div>
                                        <div t-if="g.diploma_number" class="small">Diploma n.º <t t-out="g.diploma_number"/></div>
                                    </div>
                                    <span class="badge" t-att-class="this.badgeClass(g.tone)" t-out="g.diploma_label"/>
                                </header>

                                <div class="o_edu_gr_facts">
                                    <div>
                                        <span class="o_edu_gr_fact_value" t-out="this.fmtAverage(g.average)"/>
                                        <span class="o_edu_gr_fact_label">classificação final</span>
                                    </div>
                                    <div>
                                        <span class="o_edu_gr_fact_value" t-out="g.date or '—'"/>
                                        <span class="o_edu_gr_fact_label">concluiu</span>
                                    </div>
                                </div>

                                <ol t-if="g.state !== 'cancelled'" class="o_edu_gr_steps" aria-label="Passos do diploma">
                                    <li t-foreach="this.steps(g)" t-as="step" t-key="step.key" t-att-class="{ o_done: step.done }">
                                        <i class="oi" t-att-data-icon="step.done ? 'check_circle' : 'radio_button_unchecked'" aria-hidden="true"/>
                                        <span>
                                            <span t-out="step.label"/>
                                            <span t-if="step.done and step.detail" class="d-block small text-muted" t-out="step.detail"/>
                                        </span>
                                    </li>
                                </ol>

                                <footer class="o_edu_gr_actions">
                                    <button t-if="g.state === 'draft'" type="button" class="btn btn-sm btn-primary"
                                            t-att-disabled="this.state.busy" t-on-click="() => this.rowAction('issue', g)"
                                            title="Dá o número do diploma">Emitir</button>
                                    <t t-if="g.state === 'issued'">
                                        <button t-if="!g.verified" type="button" class="btn btn-sm btn-primary"
                                                t-att-disabled="this.state.busy" t-on-click="() => this.rowAction('verify', g)">Verificar</button>
                                        <button t-elif="!g.signed and this.state.isManager" type="button" class="btn btn-sm btn-primary"
                                                t-att-disabled="this.state.busy" t-on-click="() => this.rowAction('sign', g)">Assinar</button>
                                        <button type="button" class="btn btn-sm btn-secondary" t-att-disabled="this.state.busy"
                                                t-on-click="() => this.printDocument(g, 'diploma')" t-att-aria-label="'Diploma de ' + g.student">
                                            <i class="oi me-1" data-icon="print" aria-hidden="true"/>Diploma
                                        </button>
                                        <button type="button" class="btn btn-sm btn-secondary" t-att-disabled="this.state.busy"
                                                t-on-click="() => this.printDocument(g, 'certificate')" t-att-aria-label="'Certificado de habilitações de ' + g.student">
                                            <i class="oi me-1" data-icon="print" aria-hidden="true"/>Certificado
                                        </button>
                                        <span t-if="g.verified and !g.signed and !this.state.isManager" class="small text-muted">
                                            A direcção assina.
                                        </span>
                                    </t>
                                    <span class="flex-grow-1"/>
                                    <button type="button" class="btn btn-sm btn-link" t-on-click="() => this.openForm(g)"
                                            t-att-aria-label="'Abrir a conclusão de ' + g.student" title="Abrir a conclusão">
                                        <i class="oi" data-icon="edit" aria-hidden="true"/>
                                    </button>
                                </footer>
                            </article>
                        </div>
                    </t>

                    <!-- Registar conclusões -->
                    <t t-else="">
                        <div class="o_edu_gr_bar">
                            <button type="button" class="btn btn-secondary" t-on-click="() => this.backToList()">
                                <i class="oi me-1" data-icon="arrow_back" aria-hidden="true"/>Diplomas
                            </button>
                            <h2 class="o_edu_gr_h2">Registar conclusões</h2>
                            <select class="form-select o_edu_gr_select" aria-label="Ano lectivo" t-on-change="(ev) => this.onRegYearChange(ev)">
                                <option t-foreach="this.state.years" t-as="y" t-key="y.id" t-att-value="y.id"
                                        t-att-selected="y.id === this.state.regYearId">
                                    <t t-out="y.name"/><t t-if="y.is_current"> (em curso)</t>
                                </option>
                            </select>
                        </div>
                        <p class="o_edu_gr_summary">
                            Os alunos da classe final a quem o conselho de turma deu a conclusão do curso. Ao registar, o aluno
                            passa para os diplomas, com a classificação final calculada.
                        </p>

                        <div class="o_edu_gr_layout">
                            <aside class="o_edu_gr_panel" aria-label="Turmas da classe final">
                                <p t-if="!this.state.classes.length" class="small text-muted">Não há turmas da classe final neste ano lectivo.</p>
                                <section t-foreach="this.classGroups" t-as="cg" t-key="cg.course">
                                    <h6 class="o_edu_gr_panel_head" t-out="cg.course"/>
                                    <button t-foreach="cg.classes" t-as="c" t-key="c.id" type="button" class="o_edu_gr_panel_item"
                                            t-att-class="{ o_active: c.id === this.state.classId }" t-att-aria-pressed="c.id === this.state.classId"
                                            t-on-click="() => this.selectRegClass(c.id)">
                                        <span class="text-truncate" t-out="c.name"/>
                                    </button>
                                </section>
                            </aside>

                            <section class="o_edu_gr_main">
                                <div t-if="!this.state.classId" class="o_edu_gr_empty">Escolha a turma à esquerda para ver quem tem a conclusão do curso.</div>
                                <div t-elif="!this.state.finishers.length" class="o_edu_gr_empty">
                                    Nenhum aluno da <t t-out="this.selectedRegClass.name"/> tem ainda a conclusão do curso.
                                    Aparecem aqui quando o conselho de turma a decidir.
                                </div>
                                <div t-else="" class="o_edu_gr_card">
                                    <div class="o_edu_gr_card_head">
                                        <p class="mb-0 flex-grow-1">
                                            <strong t-out="this.selectedRegClass.name"/>:
                                            <t t-out="this.finishersText"/>
                                        </p>
                                        <button t-if="this.pendingFinishers.length > 1" type="button" class="btn btn-primary"
                                                t-att-disabled="this.state.busy" t-on-click="() => this.register(this.pendingFinishers)">
                                            Registar os <t t-out="this.pendingFinishers.length"/>
                                        </button>
                                    </div>
                                    <ul class="o_edu_gr_list">
                                        <li t-foreach="this.state.finishers" t-as="f" t-key="f.result_id">
                                            <span class="o_edu_gr_num" t-out="f.number"/>
                                            <div class="flex-grow-1">
                                                <div t-out="f.student"/>
                                                <div class="small text-muted">Média final <t t-out="this.fmtAverage(f.average)"/></div>
                                            </div>
                                            <span t-if="f.cancelled" class="badge text-bg-light">Conclusão anulada</span>
                                            <span t-elif="f.registered" class="badge text-bg-success">Registado</span>
                                            <span t-elif="f.average === null" class="small text-muted" title="O conselho de turma não apurou a média final deste aluno.">sem média</span>
                                            <button t-else="" type="button" class="btn btn-sm btn-secondary" t-att-disabled="this.state.busy"
                                                    t-on-click="() => this.register([f])" t-att-aria-label="'Registar a conclusão de ' + f.student">Registar</button>
                                        </li>
                                    </ul>
                                </div>
                            </section>
                        </div>
                    </t>
                </div>
            </Layout>
        </div>
    </t>

</templates>
