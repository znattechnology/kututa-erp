<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="edu_documents.StudentPanel">
        <aside class="o_edu_sp" aria-label="Escolher o aluno">
            <div class="o_edu_sp_top">
                <select class="form-select form-select-sm" aria-label="Ano lectivo" t-on-change="(ev) => this.onYearChange(ev)">
                    <option t-foreach="this.state.years" t-as="y" t-key="y.id" t-att-value="y.id"
                            t-att-selected="y.id === this.state.yearId">
                        <t t-out="y.name"/><t t-if="y.is_current"> (em curso)</t>
                    </option>
                </select>
                <input type="search" class="form-control form-control-sm" placeholder="Nome ou n.º de processo…"
                       aria-label="Procurar o aluno" t-att-value="this.state.query" t-on-input="(ev) => this.onQuery(ev)"/>
            </div>

            <!-- Pesquisa pelo nome, no ano lectivo -->
            <t t-if="this.searchMode">
                <h6 class="o_edu_sp_head">Alunos encontrados</h6>
                <p t-if="!this.state.results.length and !this.state.searching" class="small text-muted">
                    Nenhum aluno com esse nome neste ano lectivo. Quem já saiu encontra-se no último ano em que esteve
                    matriculado.
                </p>
                <button t-foreach="this.state.results" t-as="s" t-key="s.enrollment_id" type="button"
                        class="o_edu_sp_item" t-att-class="{ o_active: s.student_id === this.props.studentId }"
                        t-att-aria-pressed="s.student_id === this.props.studentId" t-on-click="() => this.pick(s)">
                    <span class="o_edu_sp_text">
                        <span class="text-truncate" t-out="s.name"/>
                        <span class="small text-muted text-truncate"><t t-out="s.class"/><t t-if="s.gone">, <t t-out="s.state"/></t></span>
                    </span>
                </button>
            </t>

            <!-- Os alunos da turma, pelo número -->
            <t t-elif="this.selectedClass">
                <button type="button" class="btn btn-link btn-sm px-0" t-on-click="() => this.backToClasses()">
                    <i class="oi oi-chevron-left me-1" aria-hidden="true"/>Turmas
                </button>
                <h6 class="o_edu_sp_head">
                    <t t-out="this.selectedClass.name"/>
                    <span class="fw-normal text-muted">
                        · <t t-out="this.state.students.length === 1 ? '1 aluno' : this.state.students.length + ' alunos'"/>
                    </span>
                </h6>
                <p t-if="!this.state.students.length" class="small text-muted">A turma não tem alunos matriculados.</p>
                <button t-foreach="this.state.students" t-as="s" t-key="s.enrollment_id" type="button"
                        class="o_edu_sp_item" t-att-class="{ o_active: s.student_id === this.props.studentId, o_gone: s.gone }"
                        t-att-aria-pressed="s.student_id === this.props.studentId" t-on-click="() => this.pick(s)">
                    <span class="o_edu_sp_num" t-out="s.number"/>
                    <span class="o_edu_sp_text">
                        <span class="text-truncate" t-out="s.name"/>
                        <span t-if="s.gone" class="small text-muted" t-out="s.state"/>
                    </span>
                </button>
            </t>

            <!-- As turmas do ano, por curso -->
            <t t-else="">
                <input type="search" class="form-control form-control-sm mt-2" placeholder="Procurar a turma…"
                       aria-label="Procurar a turma" t-att-value="this.state.filter"
                       t-on-input="(ev) => this.state.filter = ev.target.value"/>
                <p t-if="!this.classGroups.length" class="small text-muted mt-2">
                    <t t-out="this.state.classes.length ? 'Nenhuma turma.' : 'Não há turmas neste ano lectivo.'"/>
                </p>
                <section t-foreach="this.classGroups" t-as="g" t-key="g.course">
                    <h6 class="o_edu_sp_head" t-out="g.course"/>
                    <button t-foreach="g.classes" t-as="c" t-key="c.id" type="button" class="o_edu_sp_item"
                            t-on-click="() => this.selectClass(c.id)">
                        <span class="text-truncate flex-grow-1" t-out="c.name"/>
                        <span class="small text-muted text-nowrap" t-out="c.students"/>
                    </button>
                </section>
            </t>
        </aside>
    </t>

</templates>
