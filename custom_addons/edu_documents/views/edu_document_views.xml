<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_document_list" model="ir.ui.view">
        <field name="name">edu.document.list</field>
        <field name="model">edu.document</field>
        <field name="arch" type="xml">
            <list string="Documentos emitidos" decoration-muted="state == 'cancelled'" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="date"/>
                <field name="document_type"/>
                <field name="student_id"/>
                <field name="academic_year_id" optional="show"/>
                <field name="purpose" optional="hide"/>
                <field name="print_count" optional="show"/>
                <field name="issued_by_id" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'issued'"/>
            </list>
        </field>
    </record>
    <record id="edu_document_form" model="ir.ui.view">
        <field name="name">edu.document.form</field>
        <field name="model">edu.document</field>
        <field name="arch" type="xml">
            <form string="Documento">
                <header>
                    <button name="action_issue" type="object" string="Emitir" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print" type="object" string="Imprimir" class="btn-primary" invisible="state != 'issued'"/>
                    <button name="action_preview" type="object" string="Visualizar" invisible="state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Anular" invisible="state != 'issued'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="document_type" readonly="state != 'draft'"/>
                            <field name="student_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="enrollment_id" options="{'no_create': True}" readonly="state != 'draft'"
                                   invisible="document_type in ('transfer_guide', 'certificate', 'diploma')"/>
                            <field name="transfer_id" options="{'no_create': True}" readonly="state != 'draft'"
                                   invisible="document_type != 'transfer_guide'"/>
                            <field name="graduation_id" options="{'no_create': True}" readonly="state != 'draft'"
                                   invisible="document_type not in ('certificate', 'diploma')"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="purpose"/>
                            <field name="issued_by_id" invisible="not issued_by_id"/>
                            <field name="print_count"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Observações"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="edu_document_search" model="ir.ui.view">
        <field name="name">edu.document.search</field>
        <field name="model">edu.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <filter name="issued" string="Emitidos" domain="[('state', '=', 'issued')]"/>
                <group>
                    <filter name="group_type" string="Documento" context="{'group_by': 'document_type'}"/>
                    <filter name="group_month" string="Mês" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_edu_document" model="ir.actions.act_window">
        <field name="name">Documentos emitidos</field>
        <field name="res_model">edu.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="edu_student_form_documents" model="ir.ui.view">
        <field name="name">edu.student.form.documents</field>
        <field name="model">edu.student</field>
        <field name="inherit_id" ref="edu_people.edu_student_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_new_document" type="object" string="Emitir documento"/>
            </header>
            <field name="birthplace" position="after">
                <field name="birth_municipality"/>
            </field>
        </field>
    </record>

    <record id="edu_course_form_documents" model="ir.ui.view">
        <field name="name">edu.course.form.documents</field>
        <field name="model">edu.course</field>
        <field name="inherit_id" ref="edu_core.edu_course_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_print_curriculum" type="object" string="Visualizar o plano curricular"
                        icon="visibility" invisible="not curriculum_id"/>
            </header>
        </field>
    </record>

    <record id="edu_curriculum_form_documents" model="ir.ui.view">
        <field name="name">edu.curriculum.form.documents</field>
        <field name="model">edu.curriculum</field>
        <field name="inherit_id" ref="edu_core.edu_curriculum_form"/>
        <field name="arch" type="xml">
            <sheet position="before">
                <header>
                    <button name="action_print_curriculum" type="object" string="Visualizar e imprimir" icon="visibility"/>
                </header>
            </sheet>
        </field>
    </record>

    <record id="edu_transfer_form_documents" model="ir.ui.view">
        <field name="name">edu.transfer.form.documents</field>
        <field name="model">edu.transfer</field>
        <field name="inherit_id" ref="edu_enrollment.edu_transfer_form"/>
        <field name="arch" type="xml">
            <button name="action_cancel" position="before">
                <button name="action_print_transfer_guide" type="object" string="Guia de transferência" icon="print"
                        invisible="state != 'completed' or transfer_type != 'external'"/>
                <button name="action_print_transfer_declaration" type="object" string="Declaração com notas" icon="print"
                        invisible="state != 'completed' or transfer_type != 'external'"/>
            </button>
        </field>
    </record>

    <record id="edu_application_list_print" model="ir.ui.view">
        <field name="name">edu.application.list.print</field>
        <field name="model">edu.application</field>
        <field name="inherit_id" ref="edu_enrollment.edu_application_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='name']" position="before">
                <header>
                    <button name="action_print_listing" type="object" string="Imprimir" icon="print" display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="edu_enrollment_list_print" model="ir.ui.view">
        <field name="name">edu.enrollment.list.print</field>
        <field name="model">edu.enrollment</field>
        <field name="inherit_id" ref="edu_enrollment.edu_enrollment_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='class_id']" position="before">
                <header>
                    <button name="action_print_listing" type="object" string="Imprimir" icon="print" display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="edu_transfer_list_print" model="ir.ui.view">
        <field name="name">edu.transfer.list.print</field>
        <field name="model">edu.transfer</field>
        <field name="inherit_id" ref="edu_enrollment.edu_transfer_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='display_name']" position="before">
                <header>
                    <button name="action_print_listing" type="object" string="Imprimir" icon="print" display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="edu_student_list_print" model="ir.ui.view">
        <field name="name">edu.student.list.print</field>
        <field name="model">edu.student</field>
        <field name="inherit_id" ref="edu_people.edu_student_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='matricula_number']" position="before">
                <header>
                    <button name="action_print_listing" type="object" string="Imprimir" icon="print" display="always"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="edu_application_form_print" model="ir.ui.view">
        <field name="name">edu.application.form.print</field>
        <field name="model">edu.application</field>
        <field name="inherit_id" ref="edu_enrollment.edu_application_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_receipt" type="object" string="Comprovativo" icon="print" invisible="state == 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="edu_enrollment_confirmation_form_print" model="ir.ui.view">
        <field name="name">edu.enrollment.confirmation.form.print</field>
        <field name="model">edu.enrollment.confirmation</field>
        <field name="inherit_id" ref="edu_evaluation.edu_enrollment_confirmation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_print_listing" type="object" string="Imprimir" icon="print" invisible="state == 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="edu_class_form_documents" model="ir.ui.view">
        <field name="name">edu.class.form.documents</field>
        <field name="model">edu.class</field>
        <field name="inherit_id" ref="edu_enrollment.edu_class_form_enrollment"/>
        <field name="arch" type="xml">
            <button name="action_renumber_alphabetical" position="after">
                <button name="action_print_pautas" type="object" string="Imprimir pautas"/>
                <button name="action_print_class_list" type="object" string="Relação nominal"/>
                <button name="action_print_schedule" type="object" string="Horário"/>
            </button>
        </field>
    </record>

    <record id="view_company_form_edu_documents" model="ir.ui.view">
        <field name="name">res.company.form.edu.documents</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="edu_core.view_company_form_edu"/>
        <field name="arch" type="xml">
            <field name="edu_pedagogical_director_name" position="after">
                <field name="edu_director_title"/>
                <field name="edu_director_gender"/>
                <field name="edu_pedagogical_director_gender"/>
                <field name="edu_secretary_name"/>
            </field>
            <field name="edu_student_capacity" position="after">
                <field name="edu_document_city"/>
                <field name="edu_official_line"/>
                <field name="edu_licence_text"/>
                <field name="edu_supervisor_school"/>
                <field name="edu_supervisor_director"/>
            </field>
        </field>
    </record>

    <menuitem id="menu_edu_document" action="action_edu_document" parent="edu_records.menu_edu_records" sequence="5"/>
    <menuitem id="menu_edu_pauta_print" action="action_edu_pauta_print" parent="edu_evaluation.menu_edu_evaluation" sequence="35"/>
</odoo>
