<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Certificado de habilitações: técnico (Despacho 60/08, Anexo IV) ou ensino geral (classificações por classe) -->
    <template id="report_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="student" t-value="o.student_id"/>
                    <t t-set="g" t-value="o.graduation_id"/>
                    <t t-set="results" t-value="g.final_result_ids"/>
                    <t t-set="technical" t-value="g.level_id.subsystem == 'technical'"/>
                    <t t-call="edu_documents.styles"/>
                    <div class="page edu-doc">
                        <t t-call="edu_documents.header" official="True"/>
                        <div class="edu-title">CERTIFICADO</div>
                        <t t-if="technical">
                            <p>
                                <t t-out="h.by_gender(company.edu_director_gender, 'O Director', 'A Directora')"/> do <t t-out="company.name"/>,
                                <t t-out="company.edu_director_name"/>, e <t t-out="h.by_gender(company.edu_pedagogical_director_gender, 'o Subdirector Pedagógico', 'a Subdirectora Pedagógica')"/>,
                                <t t-out="company.edu_pedagogical_director_name"/>, certificam de acordo com os artigos 25.º e 27.º do estatuto do
                                Subsistema do Ensino Técnico Profissional, aprovado pelo Decreto n.º 90/04, de 3 de Dezembro, que
                                <t t-call="edu_documents.identity"/>, concluiu, em regime <t t-out="h.regime(g.enrollment_id)"/>, no ano
                                lectivo <t t-out="g.academic_year_id.name"/> o curso de <t t-out="g.course_id.name"/><t t-if="g.course_id.training_area">,
                                da Área de Formação de <t t-out="g.course_id.training_area"/></t>, tendo obtido as seguintes classificações,
                                conforme consta do processo individual n.º <t t-if="student.process_number" t-out="student.process_number"/><t t-else=""><t t-set="width" t-value="60"/><t t-call="edu_documents.blank"/></t>
                                e da folha n.º <t t-if="g.page_number" t-out="g.page_number"/><t t-else=""><t t-set="width" t-value="50"/><t t-call="edu_documents.blank"/></t> do Livro de
                                Termos n.º <t t-if="g.book_number" t-out="g.book_number"/><t t-else=""><t t-set="width" t-value="50"/><t t-call="edu_documents.blank"/></t>.
                            </p>
                            <t t-foreach="h.components(results)" t-as="group">
                                <p style="margin: 8px 0 2px 0;"><strong t-out="group[0] + ':'"/></p>
                                <table style="width: 100%;">
                                    <tr t-foreach="group[1]" t-as="r">
                                        <td style="width: 60%;" class="edu-dots" t-out="r.subject_id.name"/>
                                        <td style="text-align: right;" t-out="h.grade(r.cfd or r.final, 'title')"/>
                                    </tr>
                                </table>
                            </t>
                            <table style="width: 100%; margin-top: 10px;">
                                <tr><td class="edu-dots">Classificação final do Plano Curricular (PC)</td><td style="text-align: right;" t-out="h.grade(g.plan_average, 'title')"/></tr>
                                <tr t-if="g.internship_id"><td class="edu-dots">Classificação do Estágio Curricular (EC)</td><td style="text-align: right;" t-out="h.grade(g.internship_id.grade, 'title')"/></tr>
                                <tr t-if="g.final_project_id"><td class="edu-dots">Classificação da Prova de Aptidão Profissional (PAP)</td><td style="text-align: right;" t-out="h.grade(g.final_project_id.grade, 'title')"/></tr>
                                <t t-set="formula" t-value="'(4 × PC + EC + PAP) / 6' if g.year_result_id._policy().course_formula == 'internship' else '(2 × PC + PAP) / 3'"/>
                                <tr><td class="edu-dots"><strong>Classificação final do curso = <t t-out="formula"/></strong></td><td style="text-align: right;"><strong t-out="h.grade(g.final_grade, 'title')"/></td></tr>
                            </table>
                            <p style="margin-top: 12px;">
                                Pelo que, para efeitos legais e de harmonia com a legislação em vigor, lhe mandámos passar o presente
                                Certificado, que vai por nós assinado e autenticado pelo selo branco em uso nesta Escola.
                            </p>
                        </t>
                        <t t-else="">
                            <t t-set="enrollments" t-value="student.enrollment_ids.filtered(lambda e: e.course_id == g.course_id and e.state != 'draft').sorted('class_number')"/>
                            <t t-set="classes" t-value="sorted(set(enrollments.mapped('class_number')))"/>
                            <p>
                                <t t-out="company.edu_director_name"/>, <t t-out="h.by_gender(company.edu_director_gender, 'Director', 'Directora')"/> do
                                <t t-out="company.name"/>, certifica que <t t-call="edu_documents.identity"/>, concluiu no ano lectivo
                                <t t-out="g.academic_year_id.name"/> o <t t-out="g.level_id.name"/>, sob o processo nº
                                <t t-out="student.process_number or '—'"/>, com a Média Final de <t t-out="h.num(g.plan_average)"/> valores
                                obtida nas seguintes classificações por disciplinas:
                            </p>
                            <table class="edu-table o_ignore_layout_styling">
                                <thead>
                                    <tr>
                                        <th>Disciplinas</th>
                                        <th t-foreach="classes" t-as="number"><t t-out="number"/>.ª Classe</th>
                                        <th>Média Final</th>
                                        <th>Média por Extenso</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="h.ordered(results)" t-as="r">
                                        <td t-out="r.subject_id.name"/>
                                        <t t-foreach="classes" t-as="number">
                                            <t t-set="cell" t-value="enrollments.subject_result_ids.filtered(lambda x: x.subject_id == r.subject_id and x.class_id.class_number == number)[:1]"/>
                                            <td class="text-center" t-out="h.num(cell.final, bool(cell))"/>
                                        </t>
                                        <t t-set="value" t-value="r.cfd or r.final"/>
                                        <td class="text-center" t-out="h.num(value)"/>
                                        <td t-out="h.words(value).capitalize()"/>
                                    </tr>
                                </tbody>
                            </table>
                            <p><strong>OBS: O presente Certificado destina-se para <t t-out="o.purpose"/>.</strong></p>
                            <p>
                                Por ser verdade e me ter sido solicitado e assim constar nos documentos que ficam arquivados na secretaria,
                                mandei passar o presente Certificado que é assinado por mim e autenticado com o carimbo a óleo em uso neste
                                estabelecimento de ensino.
                            </p>
                        </t>
                        <p class="edu-date"><t t-out="h.city()"/>, <t t-out="h.date(o.date)"/></p>
                        <t t-call="edu_documents.signatures" left_role="h.pedagogical_title()" left_name="company.edu_pedagogical_director_name" right_role="h.director_title()" right_name="company.edu_director_name"/>
                        <div class="edu-ref" t-out="o.name if o.state != 'draft' else 'RASCUNHO: o número é atribuído ao emitir'"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Diploma (Despacho 60/08, Anexo III) -->
    <template id="report_diploma">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="student" t-value="o.student_id"/>
                    <t t-set="g" t-value="o.graduation_id"/>
                    <t t-call="edu_documents.styles"/>
                    <div class="page edu-doc" style="border: 6px double #1F4E79; padding: 28px;">
                        <t t-call="edu_documents.header" official="True"/>
                        <div class="edu-title" style="font-size: 34px;">Diploma</div>
                        <div class="edu-subtitle" t-out="'Formação Média Técnica' if g.level_id.subsystem == 'technical' else g.level_id.name"/>
                        <p>
                            <t t-out="company.edu_director_name"/> (<t t-out="h.by_gender(company.edu_director_gender, 'Director', 'Directora')"/>) e
                            <t t-out="company.edu_pedagogical_director_name"/> (<t t-out="h.by_gender(company.edu_pedagogical_director_gender, 'Subdirector Pedagógico', 'Subdirectora Pedagógica')"/>)
                            do <t t-out="company.name"/>, fazem saber que <t t-call="edu_documents.identity"/>, concluiu, em regime
                            <t t-out="h.regime(g.enrollment_id)"/>, no ano lectivo <t t-out="g.academic_year_id.name"/> o curso de
                            <t t-out="g.course_id.name"/><t t-if="g.course_id.training_area">, da Área de Formação <t t-out="g.course_id.training_area"/></t>,
                            com a classificação final de <strong t-out="h.grade(g.final_grade, 'title').replace('Valores', 'valores')"/>, conforme
                            consta do processo individual n.º <t t-if="student.process_number" t-out="student.process_number"/><t t-else=""><t t-set="width" t-value="60"/><t t-call="edu_documents.blank"/></t>
                            e da folha n.º <t t-if="g.page_number" t-out="g.page_number"/><t t-else=""><t t-set="width" t-value="50"/><t t-call="edu_documents.blank"/></t> do Livro de Termos
                            n.º <t t-if="g.book_number" t-out="g.book_number"/><t t-else=""><t t-set="width" t-value="50"/><t t-call="edu_documents.blank"/></t>.
                        </p>
                        <p t-if="g.level_id.subsystem == 'technical'">
                            Este curso da formação média técnica corresponde ao 2.º ciclo do Ensino Secundário, nos termos da Lei de Bases do
                            Sistema de Educação e Ensino.
                        </p>
                        <p>
                            Pelo que, para efeitos legais e de harmonia com a legislação em vigor, lhe mandámos passar o presente Diploma, que
                            vai por nós assinado e autenticado pelo selo branco em uso nesta Escola.
                        </p>
                        <p class="edu-date"><t t-out="h.city()"/>, a <t t-out="h.date(g.date)"/></p>
                        <t t-call="edu_documents.signatures" left_role="h.pedagogical_title()" left_name="company.edu_pedagogical_director_name" right_role="h.director_title()" right_name="company.edu_director_name"/>
                        <div class="edu-ref">Diploma n.º <t t-out="g.diploma_number"/><span t-if="o.print_count &gt; 1" class="edu-copy">2.ª VIA</span></div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Termo de frequência e aproveitamento (todas as classes do curso) -->
    <template id="report_term">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="student" t-value="o.student_id"/>
                    <t t-set="data" t-value="terms[o.id]"/>
                    <t t-set="technical" t-value="o.enrollment_id.class_id.level_id.subsystem == 'technical'"/>
                    <t t-set="cols" t-value="technical and ['CT1', 'CT2', 'CT3', 'PG', 'CA', 'REC', 'CFD'] or ['MT1', 'MT2', 'MT3', 'MFD', 'N.E', 'REC', 'MF']"/>
                    <t t-call="edu_documents.styles"/>
                    <div class="page edu-doc">
                        <div style="float: right; font-size: 11px;">PROCESSO N.º <t t-out="student.process_number or '____'"/></div>
                        <t t-call="edu_documents.header" official="False"/>
                        <t t-set="course" t-value="o.enrollment_id.course_id"/>
                        <div class="edu-subtitle">TERMO DE FREQUÊNCIA E APROVEITAMENTO<t t-if="course"> DO CURSO<t t-if="technical"> TÉCNICO</t> DE <t t-out="course.name.upper()"/></t></div>
                        <p style="font-size: 11px; text-align: center; margin: 0;">
                            REGIME: <t t-out="h.regime(o.enrollment_id).upper()"/><t t-if="course.training_area"> · ÁREA DE FORMAÇÃO: <t t-out="course.training_area.upper()"/></t>
                        </p>
                        <p style="font-size: 11px; line-height: 1.4;">
                            NOME: <strong t-out="student.name.upper()"/> · FILHO(A) DE <t t-out="(student.father_name or '—').upper()"/> E DE
                            <t t-out="(student.mother_name or '—').upper()"/> · NASCIDO(A) A <t t-out="h.date(student.birth_date, True)"/> ·
                            NATURAL DE <t t-out="(student.birthplace or '—').upper()"/> · B.I. N.º <t t-out="student.id_number or '—'"/> ·
                            ENCARREGADO DE EDUCAÇÃO: <t t-out="(student.primary_guardian_id.name or '—').upper()"/>
                        </p>
                        <table class="edu-grid o_ignore_layout_styling">
                            <thead>
                                <tr>
                                    <th rowspan="2">DISCIPLINAS</th>
                                    <th t-foreach="data['enrollments']" t-as="e" t-att-colspan="len(cols)">
                                        <t t-out="e.class_number"/>.ª CLASSE · <t t-out="e.academic_year_id.name"/> · TURMA <t t-out="e.class_id.name"/> · N.º <t t-out="e.order_number"/>
                                    </th>
                                </tr>
                                <tr>
                                    <t t-foreach="data['enrollments']" t-as="e">
                                        <th t-foreach="cols" t-as="col" t-out="col"/>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['subjects']" t-as="subject">
                                    <td class="edu-name" t-out="subject.name"/>
                                    <t t-foreach="data['enrollments']" t-as="e">
                                        <t t-set="r" t-value="data['cells'].get((e.id, subject.id))"/>
                                        <t t-if="r">
                                            <t t-set="values" t-value="technical and (r._trimester_classifications() + [None, None, None])[:3] + [r.pg if r.has_pg else None, r.annual, r.special_exam if r.has_special_exam else None, r.cfd if r.terminal_subject else None] or (r.trimesters_graded and [r.mt1, r.mt2, r.mt3] or [None, None, None]) + [r.cf, r.national if r.has_national else None, r.special_exam if r.has_special_exam else None, r.final]"/>
                                            <td t-foreach="values" t-as="v" t-att-class="v is not None and h.color(v, r.pass_grade) or ''" t-out="h.num(v, v is not None and bool(v or r.complete))"/>
                                        </t>
                                        <t t-else=""><td t-foreach="cols" t-as="col"/></t>
                                    </t>
                                </tr>
                                <tr>
                                    <td class="edu-name"><strong>SITUAÇÃO NO FIM DO ANO</strong></td>
                                    <td t-foreach="data['enrollments']" t-as="e" t-att-colspan="len(cols)" t-out="h.status(e.year_result_id.status) or e.state == 'transferred' and 'TRANSFERIDO(A)' or e.state == 'dropped' and 'ANULOU A MATRÍCULA' or ''"/>
                                </tr>
                                <tr style="height: 18px;">
                                    <td class="edu-name"><strong>COMPORTAMENTO</strong></td>
                                    <td t-foreach="data['enrollments']" t-as="e" t-att-colspan="len(cols)"/>
                                </tr>
                            </tbody>
                        </table>
                        <p style="font-size: 10px; margin-top: 4px;" t-if="technical">CT: Classificação do Trimestre · PG: Prova Global · CA: Classificação Anual = 60% CF + 40% PG · REC: Recurso · CFD: Classificação Final da Disciplina</p>
                        <p style="font-size: 10px; margin-top: 4px;" t-else="">MT: Média do Trimestre = (MAC + NPT)/2 · MFD: Média Final da Disciplina · N.E: Exame Nacional · REC: Recurso · MF: Média Final</p>
                        <t t-set="g" t-value="student.graduation_ids.filtered(lambda x: x.state == 'issued' and x.course_id == course)[:1]"/>
                        <p t-if="technical" style="font-size: 11px; margin-top: 6px;">
                            Classificação do plano curricular (PC): <t t-if="g" t-out="h.num(g.plan_average)"/><t t-else=""><t t-set="width" t-value="40"/><t t-call="edu_documents.blank"/></t> (média das CFD) ·
                            Estágio curricular (EC): <t t-if="g and g.internship_id" t-out="h.num(g.internship_id.grade)"/><t t-else=""><t t-set="width" t-value="40"/><t t-call="edu_documents.blank"/></t> ·
                            Prova de Aptidão Profissional (PAP): <t t-if="g and g.final_project_id" t-out="h.num(g.final_project_id.grade)"/><t t-else=""><t t-set="width" t-value="40"/><t t-call="edu_documents.blank"/></t>
                        </p>
                        <table class="edu-signatures o_ignore_layout_styling">
                            <tr>
                                <td><div class="edu-role">O(A) Coordenador(a) de Turma</div><div class="edu-line">&#160;</div></td>
                                <td><div class="edu-role" t-out="h.pedagogical_title()"/><div class="edu-line" t-out="company.edu_pedagogical_director_name and ('//%s//' % company.edu_pedagogical_director_name.upper()) or ''"/></td>
                                <td><div class="edu-role" t-out="h.director_title()"/><div class="edu-line" t-out="company.edu_director_name and ('//%s//' % company.edu_director_name.upper()) or ''"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <!-- Termo do ano (registo académico do ano), como no secPed (termo-document.tsx): sem número. -->
    <template id="report_year_term">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="y">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="y.company_id"/>
                    <t t-set="student" t-value="y.student_id"/>
                    <t t-set="e" t-value="y.enrollment_id"/>
                    <t t-set="technical" t-value="e.class_id.level_id.subsystem == 'technical'"/>
                    <t t-call="edu_documents.styles"/>
                    <div class="page edu-doc">
                        <t t-call="edu_documents.header" official="True"/>
                        <div class="edu-title" style="font-size: 18px;" t-out="'TERMO DE FREQUÊNCIA E APROVEITAMENTO' if e.class_number == 9 else 'REGISTO ACADÉMICO DO ANO'"/>
                        <table class="edu-table o_ignore_layout_styling" style="font-size: 12px;">
                            <tr><td style="width: 18%;"><strong>Aluno</strong></td><td t-out="student.name"/><td style="width: 12%;"><strong>Nº</strong></td><td style="width: 12%;" t-out="e.order_number"/></tr>
                            <tr><td><strong>Classe / turma</strong></td><td><t t-out="e.class_number"/>.ª · <t t-out="e.class_id.name"/></td><td><strong>Ano lectivo</strong></td><td t-out="e.academic_year_id.name"/></tr>
                            <tr><td><strong>Curso</strong></td><td t-out="e.course_id.name or '—'"/><td><strong>Regime</strong></td><td t-out="h.regime(e)"/></tr>
                            <tr><td><strong>Área de formação</strong></td><td t-out="e.course_id.training_area or '—'"/><td><strong>Assiduidade</strong></td><td><t t-if="y.attendance_rate"><t t-out="round(y.attendance_rate * 100)"/>%</t><t t-else="">—</t></td></tr>
                        </table>
                        <table class="edu-table o_ignore_layout_styling">
                            <thead>
                                <tr>
                                    <th style="text-align: left;">Disciplina</th>
                                    <th t-out="'CF' if technical else 'MFD'"/>
                                    <th t-if="technical">PG</th>
                                    <th>CFD</th>
                                    <th>F. J.</th>
                                    <th>F. I.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="y._year_term_rows()" t-as="row">
                                    <t t-set="r" t-value="row['result']"/>
                                    <td t-out="r.subject_id.name"/>
                                    <t t-set="first" t-value="r.cf if technical else r.final"/>
                                    <td class="text-center" t-att-class="r.complete and h.color(first, r.pass_grade) or ''" t-out="h.num(first, r.complete)"/>
                                    <td t-if="technical" class="text-center" t-out="h.num(r.pg, r.has_pg)"/>
                                    <td class="text-center" t-att-class="r.complete and r.terminal_subject and h.color(r.cfd, r.pass_grade) or ''" t-out="h.num(r.cfd, r.complete and r.terminal_subject) or '→'"/>
                                    <td class="text-center" t-out="row['excused'] or '·'"/>
                                    <td class="text-center" t-out="row['absent'] or '·'"/>
                                </tr>
                            </tbody>
                        </table>
                        <p><strong>Média final:</strong> <t t-out="h.num(y.average) if y.average else '—'"/> · <strong>Resultado final:</strong> <t t-out="h.status(y.status) or '—'"/></p>
                        <table class="edu-signatures o_ignore_layout_styling">
                            <tr><td><div class="edu-role">O(A) Director(a) de Turma</div><div class="edu-line" t-out="e.class_id.director_id.name or '&#160;'"/></td></tr>
                        </table>
                        <p class="edu-annex">CF — Classificação de Frequência · PG — Prova Global · CFD — Classificação Final da Disciplina (do ciclo) · F.J./F.I. — Faltas justificadas/injustificadas.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
