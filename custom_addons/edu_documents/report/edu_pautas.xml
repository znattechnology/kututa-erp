<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mini-pauta, como a do secPed-Express (mini-pauta-document.tsx): mapa de aproveitamento condensado do
         trimestre da turma, em A4 horizontal. Uma letra por disciplina, a classificação do trimestre (CT/MT; no
         último trimestre a CF) com as faltas FJ/FI, e a média do aluno. Dados: edu.pauta.print._mini_pauta_data. -->
    <template id="report_mini_pauta">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="c" t-value="o.class_id"/>
                    <t t-set="m" t-value="o._mini_pauta_data()"/>
                    <style>
                        .mp { font-family: Arial, "Liberation Sans", Helvetica, sans-serif; color: #000; line-height: 1.3; }
                        table.mp-grid { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; }
                        table.mp-grid th, table.mp-grid td { border-right: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; text-align: center; padding: 0; line-height: 1.15; }
                        table.mp-grid tr > :first-child { border-left: 1px solid #c8c8c8; }
                        table.mp-grid thead tr:first-child th { border-top: 1px solid #969696; }
                        table.mp-grid th { border-color: #969696; vertical-align: middle; background: #fff; color: #141414; }
                        table.mp-grid td { vertical-align: middle; }
                        table.mp-grid .mp-group { font-weight: bold; text-transform: uppercase; line-height: 1.15; word-wrap: break-word; padding: 1px 1px; }
                        table.mp-grid .mp-subhead { font-weight: 600; font-size: 10.5px; }
                        table.mp-grid td.mp-name { text-align: left; padding: 1px 4px; line-height: 1.15; word-wrap: break-word; }
                        table.mp-grid td.mp-value { font-weight: 600; }
                        table.mp-grid td.mp-neg { color: #c42b2b; }
                        .mp-note { font-size: 11.5px; margin: 5px 0 0; }
                        .mp .ep-signatures { height: 58px; margin-top: 12px; }
                        .mp .ep-generated { margin-top: 2px; }
                        /* A 2.ª folha continua as linhas da 1.ª (sem repetir o cabeçalho da tabela). */
                        table.mp-grid thead { display: table-row-group; }
                        table.mp-grid tr { page-break-inside: avoid; }
                    </style>
                    <t t-call="edu_documents.pauta_styles"/>
                    <t t-set="size" t-value="'10.5px' if m['tight'] else '11.5px'"/>
                    <div class="page mp ep">
                        <t t-call="edu_documents.pauta_head" visto="True" title="m['title']" context="m['context']"/>
                        <table class="mp-grid o_ignore_layout_styling" t-att-style="'font-size: %s' % size">
                            <colgroup>
                                <col style="width: 2.2%"/>
                                <col t-att-style="'width: ' + str(m['name_pct']) + '%'"/>
                                <t t-foreach="m['subjects']" t-as="s">
                                    <col t-att-style="'width: ' + str(m['subject_pct'] * 0.4) + '%'"/>
                                    <col t-att-style="'width: ' + str(m['subject_pct'] * 0.3) + '%'"/>
                                    <col t-att-style="'width: ' + str(m['subject_pct'] * 0.3) + '%'"/>
                                </t>
                                <col style="width: 3.2%"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th rowspan="3" class="mp-group">Nº</th>
                                    <th rowspan="3" class="mp-group" style="text-align: left;">Nome completo</th>
                                    <th t-foreach="m['subjects']" t-as="s" colspan="3" class="mp-group"><t t-out="m['letters'][s_index] if s_index &lt; 26 else '?'"/>)</th>
                                    <th rowspan="3" class="mp-group">Méd.</th>
                                </tr>
                                <tr>
                                    <th t-foreach="m['subjects']" t-as="s" colspan="3" class="mp-group" t-att-style="'font-size: 9px; text-transform: none;' if m['tight'] else 'font-size: 11px;'" t-out="s.name"/>
                                </tr>
                                <tr>
                                    <t t-foreach="m['subjects']" t-as="s">
                                        <th class="mp-subhead" t-out="m['label']"/>
                                        <th class="mp-subhead">FJ</th>
                                        <th class="mp-subhead">FI</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="m['rows']" t-as="r">
                                    <td t-out="r['number']"/>
                                    <td class="mp-name" t-out="r['name']"/>
                                    <t t-foreach="m['subjects']" t-as="s">
                                        <t t-set="cell" t-value="r['cells'][s.id]"/>
                                        <td t-att-class="'mp-value mp-neg' if cell[1] else 'mp-value'" t-out="cell[0]"/>
                                        <td t-out="cell[2]"/>
                                        <td t-out="cell[3]"/>
                                    </t>
                                    <td class="mp-value" t-out="r['average']"/>
                                </tr>
                            </tbody>
                        </table>
                        <p class="mp-note" t-out="m['note']"/>
                        <t t-call="edu_documents.pauta_signatures" left_role="h.role_case(h.employee_role(c.director_id, 'O DIRECTOR DE TURMA', 'A DIRECTORA DE TURMA', 'O(A) DIRECTOR(A) DE TURMA'))" left_name="c.director_id.name" right_role="h.role_case(h.pedagogical_title())" right_name="company.edu_pedagogical_director_name"/>
                        <div class="ep-generated">Gerado em <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y, %H:%M')"/></div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Pauta da turma (mapa de aproveitamento final) -->
    <!-- Pauta da turma (mapa de aproveitamento), com a estrutura do secPed-Express: disciplinas em colunas, alunos
         em linhas, divididas por folhas A3; o cabeçalho, a legenda e as assinaturas na 1.ª folha. Os dados vêm de
         edu.pauta.print._pauta_data (o HTML da visualização e o PDF são o mesmo). -->
    <template id="pauta_styles">
        <style>
            .ep { font-family: Arial, "Liberation Sans", Helvetica, sans-serif; color: #000; }
            .ep-head { position: relative; text-align: center; min-height: 112px; margin-bottom: 8px; }
            .ep-state { font-size: 15px; line-height: 1.25; }
            .ep-state strong { font-size: 16px; }
            .ep-visto { position: absolute; right: 70px; top: 0; width: 200px; text-align: center; font-size: 12px; }
            .ep-visto .ep-line { border-top: 1px solid #000; margin-top: 26px; padding-top: 2px; }
            .ep-school { font-size: 17px; font-weight: bold; margin-top: 10px; text-transform: uppercase; }
            .ep-title { font-size: 15px; font-weight: bold; margin-top: 4px; }
            .ep-context { font-size: 12px; margin-top: 3px; }
            table.ep-grid { border-collapse: separate; border-spacing: 0; font-size: 9.5px; }
            table.ep-grid th, table.ep-grid td {
                border-right: 1px solid #c8c8c8; border-bottom: 1px solid #c8c8c8; padding: 1px 3px;
                height: 16px; text-align: center; vertical-align: middle; white-space: nowrap;
            }
            table.ep-grid tr > :first-child { border-left: 1px solid #c8c8c8; }
            table.ep-grid thead tr:first-child th { border-top: 1px solid #969696; }
            table.ep-grid th { font-weight: bold; border-color: #969696; vertical-align: middle; }
            table.ep-grid .ep-name { text-align: left; min-width: 170px; max-width: 200px; overflow: hidden; }
            table.ep-grid th.ep-subject { white-space: normal; line-height: 1.15; }
            table.ep-grid .ep-teachers td { background: #e9ecf3; font-weight: bold; white-space: normal; }
            table.ep-grid .ep-teachers .ep-right { text-align: right; }
            .ep-pos { color: #1f4fb0; font-weight: bold; }
            .ep-neg { color: #c42b2b; font-weight: bold; }
            .ep-green { color: #1a7f37; font-weight: bold; }
            .ep-legend { font-size: 10px; color: #282828; margin-top: 14px; max-width: 1400px; white-space: normal; }
            .ep-scale { font-size: 9.5px; color: #6e6e6e; margin-top: 3px; }
            .ep-signatures { position: relative; height: 70px; margin-top: 22px; font-size: 12px; }
            .ep-signatures > div { position: absolute; top: 0; width: 240px; text-align: center; }
            .ep-signatures .ep-line { border-top: 1px solid #000; margin-top: 26px; padding-top: 2px; }
            .ep-generated { font-size: 9px; color: #969696; margin-top: 10px; }
            .ep-scroll { overflow-x: auto; max-width: 100%; padding-bottom: 6px; }
        </style>
    </template>

    <!-- Cabeçalho e assinaturas comuns à pauta, à mini-pauta e ao horário. -->
    <template id="pauta_head">
        <div class="ep-head" t-att-style="None if visto else 'min-height: 0;'">
            <div class="ep-visto" t-if="visto">
                <strong>Visto</strong>
                <div t-out="h.role_case(h.director_title())"/>
                <div class="ep-line" t-out="company.edu_director_name or '&#160;'"/>
            </div>
            <div class="ep-state"><strong>REPÚBLICA DE ANGOLA</strong><br/>Ministério da Educação</div>
            <div class="ep-school" t-out="company.name"/>
            <div class="ep-title" t-out="title"/>
            <div class="ep-context" t-out="context"/>
        </div>
    </template>

    <template id="pauta_signatures">
        <div class="ep-signatures">
            <div style="left: 0;">
                <div t-out="left_role"/>
                <div class="ep-line" t-out="left_name or '&#160;'"/>
            </div>
            <div style="right: 70px; width: 200px;">
                <div t-out="right_role"/>
                <div class="ep-line" t-out="right_name or '&#160;'"/>
            </div>
        </div>
    </template>

    <template id="report_pauta">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="c" t-value="o.class_id"/>
                    <t t-set="d" t-value="o._pauta_data()"/>
                    <t t-set="class_director_role" t-value="h.role_case(h.employee_role(c.director_id, 'O DIRECTOR DE TURMA', 'A DIRECTORA DE TURMA', 'O(A) DIRECTOR(A) DE TURMA'))"/>
                    <t t-set="pedagogical_role" t-value="h.role_case(h.pedagogical_title())"/>
                    <t t-call="edu_documents.pauta_styles"/>
                    <!-- PDF: as disciplinas dividem-se por folhas A3 (como no secPed). Visualização: uma só tabela, numa
                         linha, com scroll horizontal. -->
                    <t t-set="pdf" t-value="report_type == 'pdf'"/>
                    <t t-foreach="d['chunks'] if pdf else [d['subjects']]" t-as="chunk">
                        <div class="page ep" t-att-style="'' if chunk_last else 'page-break-after: always;'">
                            <t t-if="chunk_first" t-call="edu_documents.pauta_head" visto="True" title="d['title']" context="d['context']"/>
                            <div t-else="" class="ep-head" style="min-height: 0;"/>
                            <div t-att-class="None if pdf else 'ep-scroll'">
                            <table class="ep-grid o_ignore_layout_styling" t-att-style="'width: 100%;' if pdf and not chunk_last else None">
                                <thead>
                                    <tr>
                                        <t t-if="chunk_first">
                                            <th rowspan="2">Nº</th>
                                            <th rowspan="2" class="ep-name">Aluno</th>
                                        </t>
                                        <th t-foreach="chunk" t-as="s" class="ep-subject" t-att-colspan="d['span']" t-out="s.name"/>
                                        <t t-if="chunk_last and d['final']">
                                            <th rowspan="2">Neg.</th>
                                            <th rowspan="2">Resultado</th>
                                        </t>
                                    </tr>
                                    <tr>
                                        <t t-foreach="chunk" t-as="s">
                                            <th t-foreach="d['labels']" t-as="label" t-out="label"/>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="d['rows']" t-as="r">
                                        <t t-if="chunk_first">
                                            <td t-out="r['number']"/>
                                            <td class="ep-name" t-out="r['name']"/>
                                        </t>
                                        <t t-foreach="chunk" t-as="s">
                                            <td t-foreach="r['cells'][s.id]" t-as="cell" t-att-class="cell[1] and 'ep-' + cell[1] or None" t-out="cell[0]"/>
                                        </t>
                                        <t t-if="chunk_last and d['final']">
                                            <td t-out="r['negatives']"/>
                                            <td t-att-class="r['verdict'][1] and 'ep-' + r['verdict'][1] or None" t-out="r['verdict'][0]"/>
                                        </t>
                                    </tr>
                                    <tr class="ep-teachers">
                                        <td t-if="chunk_first" colspan="2" class="ep-right">Professor</td>
                                        <td t-foreach="chunk" t-as="s" t-att-colspan="d['span']" t-out="d['teachers'][s.id]"/>
                                        <t t-if="chunk_last and d['final']"><td/><td/></t>
                                    </tr>
                                </tbody>
                            </table>
                            </div>
                            <t t-if="chunk_first">
                                <div class="ep-legend" t-out="d['legend']"/>
                                <div class="ep-scale" t-out="d['scale']"/>
                                <t t-call="edu_documents.pauta_signatures" left_role="class_director_role" left_name="c.director_id.name" right_role="pedagogical_role" right_name="company.edu_pedagogical_director_name"/>
                            </t>
                            <div class="ep-generated">Gerado em <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y, %H:%M')"/><t t-if="pdf"> · Folha <t t-out="chunk_index + 1"/>/<t t-out="len(d['chunks'])"/></t></div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <!-- Relação nominal da turma -->
    <template id="report_class_list">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="c">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="c.company_id"/>
                    <t t-call="edu_documents.styles"/>
                    <div class="page edu-doc">
                        <t t-call="edu_documents.header" official="False"/>
                        <div class="edu-subtitle">RELAÇÃO NOMINAL DOS ALUNOS DA <t t-out="c.class_number"/>ª CLASSE · ANO LECTIVO <t t-out="c.academic_year_id.name"/></div>
                        <p style="text-align: center;">TURMA: <t t-out="c.name"/><t t-if="c.room_id"> · SALA: <t t-out="c.room_id.display_name"/></t><t t-if="c.course_id"> · CURSO: <t t-out="c.course_id.name.upper()"/></t><t t-if="c.shift_id"> · PERÍODO: <t t-out="c.shift_id.name.upper()"/></t></p>
                        <table class="edu-table o_ignore_layout_styling">
                            <thead><tr><th>Nº</th><th>NOME COMPLETO</th><th>IDADE</th><th>SEXO</th><th>N.º DE MATRÍCULA</th><th>OBS.</th></tr></thead>
                            <tbody>
                                <tr t-foreach="c.enrollment_ids.filtered(lambda e: e.state != 'draft').sorted('order_number')" t-as="e">
                                    <td class="text-center" t-out="e.order_number"/>
                                    <td t-out="e.student_id.name"/>
                                    <td class="text-center" t-out="e.student_id.age and ('%s Anos' % e.student_id.age) or ''"/>
                                    <td class="text-center" t-out="dict(e.student_id._fields['gender'].selection).get(e.student_id.gender, '').upper()"/>
                                    <td class="text-center" t-out="e.student_id.matricula_number or ''"/>
                                    <td t-out="e.state == 'transferred' and 'Transferido(a)' or e.state == 'dropped' and 'Desistente' or ''"/>
                                </tr>
                            </tbody>
                        </table>
                        <p class="edu-date"><t t-out="h.city().upper()"/>, AOS <t t-out="h.date(today, True)"/></p>
                        <t t-call="edu_documents.signatures" left_role="h.director_title()" left_name="company.edu_director_name" right_role="h.pedagogical_title()" right_name="company.edu_pedagogical_director_name"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Horário da turma -->
    <!-- Horário da turma, como a folha do secPed (schedule-export.ts): A4 horizontal, cabeçalho oficial com o timbre
         e uma régua curta na cor da escola, grelha Hora × dias nas cores da escola, assinaturas do Director
         Pedagógico e do Director Geral. Dados: edu.class._schedule_doc. -->
    <template id="report_class_schedule">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="c">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="c.company_id"/>
                    <t t-set="d" t-value="c._schedule_doc()"/>
                    <t t-call="edu_documents.pauta_styles"/>
                    <style>
                        table.ep-grid.ep-week { width: 100%; table-layout: fixed; font-size: 10.5px; }
                        table.ep-grid.ep-week td { height: 46px; white-space: normal; line-height: 1.3; padding: 3px 5px; }
                        table.ep-grid.ep-week th { height: 24px; }
                    </style>
                    <div class="page ep">
                        <t t-call="edu_documents.pauta_head" visto="False" title="d['title']" context="d['context']"/>
                        <table class="ep-grid ep-week o_ignore_layout_styling">
                            <colgroup>
                                <col style="width: 8%"/>
                                <col t-foreach="d['days']" t-as="day" t-att-style="'width: ' + str(d['day_width']) + '%'"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Hora</th>
                                    <th t-foreach="d['days']" t-as="day" t-out="day"/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="d['rows']" t-as="r">
                                    <th><t t-out="r['hours'][0]"/><br/><t t-out="r['hours'][1]"/></th>
                                    <t t-foreach="r['cells']" t-as="cell">
                                        <td t-if="cell"><strong t-out="cell[0]"/><t t-foreach="cell[1:]" t-as="text"><br/><t t-out="text"/></t></td>
                                        <td t-else=""/>
                                    </t>
                                </tr>
                            </tbody>
                        </table>
                        <t t-call="edu_documents.pauta_signatures" left_role="h.role_case(h.pedagogical_title())" left_name="company.edu_pedagogical_director_name" right_role="h.role_case(h.director_title())" right_name="company.edu_director_name"/>
                        <div class="ep-generated">Gerado em <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y, %H:%M')"/></div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Plano curricular: a matriz do plano (componentes, disciplinas e tempos por classe) com o cabeçalho e as
         assinaturas da pauta. -->
    <template id="report_curriculum">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-call="edu_documents.pauta_styles"/>
                    <style>
                        .ep-plan table.o_edu_plan_matrix { font-size: 11px !important; }
                        .ep-plan table.o_edu_plan_matrix th, .ep-plan table.o_edu_plan_matrix td { padding-top: 2px !important; padding-bottom: 2px !important; }
                        .ep-plan table.o_edu_plan_matrix tr { page-break-inside: avoid; }
                    </style>
                    <div class="page ep">
                        <t t-call="edu_documents.pauta_head" visto="False" title="'PLANO CURRICULAR'" context="o._curriculum_context()"/>
                        <div class="ep-plan" t-out="o.plan_matrix"/>
                        <t t-call="edu_documents.pauta_signatures" left_role="h.role_case(h.pedagogical_title())" left_name="company.edu_pedagogical_director_name" right_role="h.role_case(h.director_title())" right_name="company.edu_director_name"/>
                        <div class="ep-generated">Gerado em <t t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y, %H:%M')"/></div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Cartão de estudante (CR80, 85,6 × 54 mm) -->
    <template id="report_student_card">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-call="edu_documents.styles"/>
                <div class="page">
                    <t t-foreach="docs" t-as="s">
                        <t t-set="company" t-value="s.company_id"/>
                        <t t-set="e" t-value="s.current_enrollment_id"/>
                        <div style="display: inline-block; width: 85.6mm; height: 54mm; border: 1px solid #1F4E79; border-radius: 3mm; margin: 2mm; overflow: hidden; font-family: Arial, sans-serif; font-size: 8px; vertical-align: top;">
                            <div style="background: #1F4E79; color: #fff; padding: 2mm; font-weight: bold; font-size: 9px;">
                                <img t-if="company.logo and not company.uses_default_logo" t-att-src="image_data_uri(company.logo)" style="height: 7mm; vertical-align: middle; margin-right: 2mm;"/>
                                <t t-out="company.name"/>
                            </div>
                            <div style="padding: 2mm; display: flex;">
                                <img t-if="s.image_128" t-att-src="image_data_uri(s.image_128)" style="width: 18mm; height: 22mm; object-fit: cover; margin-right: 2mm;"/>
                                <div>
                                    <div style="font-weight: bold; font-size: 10px;" t-out="s.name"/>
                                    <div>Matrícula n.º <strong t-out="s.matricula_number or '—'"/></div>
                                    <div t-if="e.course_id">Curso: <t t-out="e.course_id.name"/></div>
                                    <div t-if="e">Turma: <t t-out="e.class_id.display_name"/></div>
                                    <div t-if="s.birth_date">Nascimento: <t t-out="s.birth_date.strftime('%d/%m/%Y')"/></div>
                                    <div t-if="e">Válido até: <t t-out="e.academic_year_id.date_end.strftime('%d/%m/%Y')"/></div>
                                </div>
                            </div>
                            <div style="padding: 0 2mm; font-size: 6px; color: #555;">Pessoal e intransmissível. Em caso de perda, comunique à escola.</div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
