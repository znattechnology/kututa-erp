<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_l10n_ao_edi" model="ir.ui.view">
        <field name="name">account.payment.form.l10n_ao_edi</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <button name="action_draft" position="attributes">
                <attribute name="invisible" add="l10n_ao_edi_state in ('to_send', 'sent', 'valid')" separator=" or "/>
            </button>
            <header position="inside">
                <field name="l10n_ao_edi_required" invisible="1"/>
                <button name="action_l10n_ao_edi_issue_receipt" type="object" string="Emitir recibo AGT"
                        invisible="not l10n_ao_edi_required or l10n_ao_edi_document_no or state in ('draft', 'canceled')"/>
                <button name="action_l10n_ao_edi_send_now" type="object" string="Enviar à AGT"
                        invisible="l10n_ao_edi_state != 'to_send'"/>
            </header>
            <header position="after">
                <div class="alert alert-danger mb-0" role="alert" invisible="l10n_ao_edi_state != 'invalid'">
                    <strong>Recibo rejeitado pela AGT.</strong>
                    <field name="l10n_ao_edi_error" class="d-block mt-1"/>
                </div>
            </header>
            <group name="group2" position="inside">
                <field name="l10n_ao_edi_document_no" invisible="not l10n_ao_edi_document_no"/>
                <field name="l10n_ao_edi_state" invisible="not l10n_ao_edi_state" widget="badge"
                       decoration-success="l10n_ao_edi_state == 'valid'"
                       decoration-info="l10n_ao_edi_state in ('to_send', 'sent')"
                       decoration-danger="l10n_ao_edi_state == 'invalid'"/>
                <field name="l10n_ao_edi_contingency" invisible="not l10n_ao_edi_contingency"/>
            </group>
        </field>
    </record>
</odoo>
