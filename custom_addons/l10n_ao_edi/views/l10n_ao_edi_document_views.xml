<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_ao_edi_document_view_list" model="ir.ui.view">
        <field name="name">l10n_ao_edi.document.list</field>
        <field name="model">l10n_ao_edi.document</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'error'" decoration-info="state == 'sent'">
                <field name="create_date" string="Data"/>
                <field name="request_id"/>
                <field name="move_ids" widget="many2many_tags"/>
                <field name="payment_ids" widget="many2many_tags" optional="show"/>
                <field name="result_code"/>
                <field name="poll_count" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-info="state == 'sent'" decoration-danger="state == 'error'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="l10n_ao_edi_document_view_form" model="ir.ui.view">
        <field name="name">l10n_ao_edi.document.form</field>
        <field name="model">l10n_ao_edi.document</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="request_id"/>
                            <field name="submission_uuid"/>
                            <field name="result_code"/>
                        </group>
                        <group>
                            <field name="create_date" string="Enviado em"/>
                            <field name="next_poll"/>
                            <field name="poll_count"/>
                        </group>
                    </group>
                    <field name="move_ids" widget="many2many_tags"/>
                    <field name="payment_ids" widget="many2many_tags" invisible="not payment_ids"/>
                    <notebook>
                        <page string="Erros" name="errors" invisible="not error_message">
                            <field name="error_message"/>
                        </page>
                        <page string="Pedido (JSON)" name="payload">
                            <field name="payload" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                        <page string="Resposta (JSON)" name="response">
                            <field name="response" widget="code" options="{'mode': 'javascript'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_ao_edi_document_action" model="ir.actions.act_window">
        <field name="name">Comunicações AGT</field>
        <field name="res_model">l10n_ao_edi.document</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_l10n_ao_edi_document" action="l10n_ao_edi_document_action"
              parent="l10n_ao.menu_l10n_ao_config" sequence="2"/>
</odoo>
