<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_ao_edi" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ao_edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <button name="button_draft" position="attributes">
                <attribute name="invisible" add="l10n_ao_edi_state in ('to_send', 'sent', 'valid')" separator=" or "/>
            </button>
            <header position="inside">
                <button name="action_l10n_ao_edi_send_now" type="object" string="Enviar à AGT"
                        invisible="l10n_ao_edi_state != 'to_send'" groups="account.group_account_invoice"/>
                <button name="action_l10n_ao_edi_vendor_confirm" type="object" string="Confirmar na AGT"
                        invisible="move_type not in ('in_invoice', 'in_refund') or state != 'posted' or l10n_ao_edi_vendor_state or country_code != 'AO'"
                        groups="account.group_account_invoice"/>
                <button name="action_l10n_ao_edi_vendor_reject" type="object" string="Rejeitar na AGT"
                        invisible="move_type not in ('in_invoice', 'in_refund') or state != 'posted' or l10n_ao_edi_vendor_state or country_code != 'AO'"
                        confirm="Rejeitar este documento do fornecedor na AGT?"
                        groups="account.group_account_invoice"/>
            </header>
            <header position="after">
                <field name="l10n_ao_edi_required" invisible="1"/>
                <div class="alert alert-danger mb-0" role="alert" invisible="l10n_ao_edi_state != 'invalid'">
                    <strong>Documento rejeitado pela AGT: para efeitos fiscais não existe.</strong>
                    Corrija-o (voltar a rascunho e confirmar) para emitir o documento de correcção.
                    <field name="l10n_ao_edi_error" class="d-block mt-1"/>
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not l10n_ao_edi_contingency or l10n_ao_edi_state == 'valid'">
                    Emitido em contingência, pendente de autorização da AGT.
                </div>
                <div class="alert alert-info mb-0" role="alert" invisible="l10n_ao_edi_state not in ('to_send', 'sent')">
                    <field name="l10n_ao_edi_state" readonly="1" class="fw-bold"/>
                </div>
            </header>
            <field name="ref" position="after">
                <field name="l10n_ao_edi_vendor_document_no"
                       invisible="move_type not in ('in_invoice', 'in_refund') or country_code != 'AO'"/>
                <field name="l10n_ao_edi_vendor_state" invisible="not l10n_ao_edi_vendor_state"/>
            </field>
            <page name="other_info" position="inside">
                <group string="Facturação electrónica (AGT)" name="l10n_ao_edi" invisible="not l10n_ao_edi_required">
                    <group>
                        <field name="l10n_ao_document_type" readonly="state != 'draft' or move_type == 'out_refund'"/>
                        <field name="l10n_ao_edi_series_id"/>
                        <field name="l10n_ao_edi_reason" invisible="move_type != 'out_refund' and not debit_origin_id"
                               readonly="state != 'draft'"/>
                        <field name="l10n_ao_edi_state" widget="badge"
                               decoration-success="l10n_ao_edi_state == 'valid'"
                               decoration-info="l10n_ao_edi_state in ('to_send', 'sent')"
                               decoration-danger="l10n_ao_edi_state == 'invalid'"/>
                    </group>
                    <group>
                        <field name="l10n_ao_edi_system_entry_date"/>
                        <field name="l10n_ao_edi_rejected_document_no" invisible="not l10n_ao_edi_rejected_document_no"/>
                        <field name="l10n_ao_edi_document_ids" widget="many2many_tags"/>
                    </group>
                </group>
            </page>
        </field>
    </record>
</odoo>
