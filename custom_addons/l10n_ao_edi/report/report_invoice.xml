<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_l10n_ao_edi" inherit_id="account.report_invoice_document">
        <!-- Documentos AGT: o título é o tipo de documento (não há «pró-forma» de um documento emitido). -->
        <xpath expr="//t[@t-set='layout_document_title']" position="after">
            <t t-if="o.l10n_ao_edi_series_id" t-set="layout_document_title">
                <span t-out="o._l10n_ao_edi_document_title()">Factura</span>
                <span t-field="o.name">FT FT26S1/1</span>
            </t>
        </xpath>
        <xpath expr="//div[@name='invoice_date']" position="attributes">
            <attribute name="t-if">o.invoice_date and not o.l10n_ao_edi_series_id</attribute>
        </xpath>
        <xpath expr="//div[@name='invoice_date']" position="before">
            <div class="col" t-if="o.invoice_date and o.l10n_ao_edi_series_id" name="l10n_ao_edi_invoice_date">
                <strong>Data de emissão</strong>
                <div t-field="o.invoice_date">2026-10-20</div>
            </div>
        </xpath>
        <xpath expr="//div[@id='qrcode']" position="before">
            <div id="l10n_ao_edi_qrcode" class="d-flex mb-3 avoid-page-break-inside" t-if="o.l10n_ao_edi_qr_url">
                <div class="me-3">
                    <img t-att-src="'/report/barcode/?barcode_type=QR&amp;barLevel=M&amp;width=140&amp;height=140&amp;value=%s' % quote_plus(o.l10n_ao_edi_qr_url)"
                         style="width: 35mm; height: 35mm;" alt="QR Code AGT"/>
                </div>
                <div class="d-inline text-muted lh-sm small">
                    <p class="mb-1">Documento consultável no Portal da AGT.</p>
                    <p class="mb-1" t-if="o.company_id.l10n_ao_edi_software_validation_number">
                        Processado por programa validado n.º
                        <span t-field="o.company_id.l10n_ao_edi_software_validation_number"/>/AGT
                    </p>
                    <p class="mb-0" t-if="o.l10n_ao_edi_rejected_document_no">
                        Corrige o documento <span t-field="o.l10n_ao_edi_rejected_document_no"/>
                    </p>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
