<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_fee_payment_form" model="ir.ui.view">
        <field name="name">edu.fee.payment.form</field>
        <field name="model">edu.fee.payment</field>
        <field name="arch" type="xml">
            <form string="Receber pagamento">
                <group>
                    <group>
                        <field name="student_id" readonly="1"/>
                        <field name="open_amount"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="date"/>
                        <field name="reference"/>
                    </group>
                </group>
                <field name="invoice_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="invoice_date_due"/>
                        <field name="invoice_line_ids" widget="many2many_tags" optional="hide"/>
                        <field name="amount_total"/>
                        <field name="amount_residual"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <div class="text-muted">O valor é imputado às facturas mais antigas; o excedente fica como crédito para as próximas.</div>
                <footer>
                    <button name="action_confirm" type="object" string="Registar o pagamento" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="edu_fee_service_form" model="ir.ui.view">
        <field name="name">edu.fee.service.form</field>
        <field name="model">edu.fee.service</field>
        <field name="arch" type="xml">
            <form string="Cobrar serviço">
                <group>
                    <field name="student_id" readonly="1"/>
                    <field name="enrollment_id" options="{'no_create': True}"/>
                    <field name="academic_year_id" invisible="1"/>
                    <field name="fee_line_id" options="{'no_create': True}"/>
                    <field name="quantity"/>
                    <field name="reference"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Facturar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="edu_student_card_revoke_form" model="ir.ui.view">
        <field name="name">edu.student.card.revoke.form</field>
        <field name="model">edu.student.card.revoke</field>
        <field name="arch" type="xml">
            <form string="Revogar o cartão">
                <p class="text-muted">O cartão deixa de valer. Para uma 2.ª via, o aluno paga de novo a taxa na tesouraria e
                a secretaria emite o cartão novo.</p>
                <group>
                    <field name="student_id" readonly="1"/>
                    <field name="reason" placeholder="Perda, roubo, dados errados…"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Revogar" class="btn-danger"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
