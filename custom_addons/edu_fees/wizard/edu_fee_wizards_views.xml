<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_fee_payment_form" model="ir.ui.view">
        <field name="name">edu.fee.payment.form</field>
        <field name="model">edu.fee.payment</field>
        <field name="arch" type="xml">
            <form string="Receber pagamento">
                <group>
                    <group>
                        <field name="student_id" readonly="1"/>
                        <field name="open_amount"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="date"/>
                        <field name="reference"/>
                    </group>
                </group>
                <field name="invoice_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="invoice_date_due"/>
                        <field name="invoice_line_ids" widget="many2many_tags" optional="hide"/>
                        <field name="amount_total"/>
                        <field name="amount_residual"/>
                        <field name="currency_id" column_invisible="1"/>
                    </list>
                </field>
                <group invisible="not selected_invoice_ids">
                    <field name="selected_invoice_ids" widget="many2many_tags" readonly="1" string="Pagar primeiro"/>
                </group>
                <div class="text-muted" invisible="selected_invoice_ids">O valor é imputado às facturas mais antigas; o excedente fica como crédito para as próximas.</div>
                <div class="text-muted" invisible="not selected_invoice_ids">O valor vai primeiro para as facturas escolhidas e depois para as mais antigas; o excedente fica como crédito para as próximas.</div>
                <footer>
                    <button name="action_confirm" type="object" string="Registar o pagamento" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="edu_fee_service_form" model="ir.ui.view">
        <field name="name">edu.fee.service.form</field>
        <field name="model">edu.fee.service</field>
        <field name="arch" type="xml">
            <form string="Cobrar serviço">
                <group>
                    <field name="student_id" readonly="1"/>
                    <field name="enrollment_id" options="{'no_create': True}"/>
                    <field name="academic_year_id" invisible="1"/>
                    <field name="fee_line_id" options="{'no_create': True}"/>
                    <field name="quantity"/>
                    <field name="reference"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Facturar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="edu_student_card_revoke_form" model="ir.ui.view">
        <field name="name">edu.student.card.revoke.form</field>
        <field name="model">edu.student.card.revoke</field>
        <field name="arch" type="xml">
            <form string="Revogar o cartão">
                <p class="text-muted">O cartão deixa de valer. Para uma 2.ª via, o aluno paga de novo a taxa na tesouraria e
                a secretaria emite o cartão novo.</p>
                <group>
                    <field name="student_id" readonly="1"/>
                    <field name="reason" placeholder="Perda, roubo, dados errados…"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Revogar" class="btn-danger"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="edu_fee_generate_form" model="ir.ui.view">
        <field name="name">edu.fee.generate.form</field>
        <field name="model">edu.fee.generate</field>
        <field name="arch" type="xml">
            <form string="Gerar as propinas">
                <div class="alert alert-warning" role="alert" invisible="not issue">
                    <field name="issue" readonly="1"/>
                </div>
                <group>
                    <group>
                        <field name="plan_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="date"/>
                        <field name="company_id" invisible="1"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="student_count"/>
                        <field name="invoice_count"/>
                        <field name="amount_total"/>
                    </group>
                </group>
                <field name="summary" nolabel="1" invisible="not summary"/>
                <div class="text-muted" invisible="summary">Não há propinas em falta: está tudo facturado até este mês.</div>
                <div class="text-muted mt-2">
                    As facturas saem já emitidas e certificadas (AGT), com a data de hoje, e não se apagam: um erro só
                    se corrige com nota de crédito. Os meses antes do «Cobrar a partir de» do plano nunca se facturam.
                </div>
                <footer>
                    <button name="action_generate" type="object" string="Emitir as facturas" class="btn-primary"
                            invisible="issue or not invoice_count"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_edu_fee_generate" model="ir.actions.act_window">
        <field name="name">Gerar as propinas</field>
        <field name="res_model">edu.fee.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_edu_fee_plan"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('edu_fees.group_edu_finance'))]"/>
    </record>
</odoo>
