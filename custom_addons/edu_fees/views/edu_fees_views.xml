<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_student_form_fees" model="ir.ui.view">
        <field name="name">edu.student.form.fees</field>
        <field name="model">edu.student</field>
        <field name="inherit_id" ref="edu_people.edu_student_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_receive_payment" type="object" string="Receber pagamento" class="btn-primary"/>
                <button name="action_charge_service" type="object" string="Cobrar serviço"/>
            </header>
            <div name="button_box" position="inside">
                <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-money">
                    <div class="o_stat_info">
                        <field name="edu_open_amount" widget="monetary" class="o_stat_value"/>
                        <span class="o_stat_text">Em aberto</span>
                    </div>
                </button>
            </div>
            <sheet position="before">
                <div class="alert alert-danger mb-0" role="alert" invisible="not edu_in_debt">
                    Dívida vencida: <field name="edu_overdue_amount" widget="monetary"/>
                    <span invisible="not edu_gate_exempt"> (isento do bloqueio)</span>
                    <field name="edu_in_debt" invisible="1"/>
                    <field name="edu_gate_exempt" invisible="1"/>
                    <field name="edu_currency_id" invisible="1"/>
                </div>
            </sheet>
        </field>
    </record>

    <record id="edu_student_debtors_list" model="ir.ui.view">
        <field name="name">edu.student.debtors.list</field>
        <field name="model">edu.student</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Devedores" create="0">
                <field name="matricula_number"/>
                <field name="name"/>
                <field name="current_class_id"/>
                <field name="primary_guardian_id"/>
                <field name="edu_overdue_amount" sum="Total"/>
                <field name="edu_open_amount" optional="show"/>
                <field name="edu_gate_exempt" optional="show"/>
                <field name="edu_currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_edu_debtors" model="ir.actions.act_window">
        <field name="name">Devedores</field>
        <field name="res_model">edu.student</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="edu_student_debtors_list"/>
        <field name="domain">[('edu_in_debt', '=', True)]</field>
    </record>

    <record id="action_edu_invoices" model="ir.actions.act_window">
        <field name="name">Facturas escolares</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('edu_student_id', '!=', False), ('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>

    <record id="view_move_form_edu" model="ir.ui.view">
        <field name="name">account.move.form.edu</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="edu_student_id" invisible="not edu_student_id" readonly="1"/>
                <field name="edu_category" invisible="not edu_category" readonly="1"/>
                <field name="edu_discount" invisible="not edu_discount" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
