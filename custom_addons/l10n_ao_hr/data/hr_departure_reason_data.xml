<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Modalidades de cessação da LGT (arts. 276.º a 310.º). -->
    <record id="departure_ao_trial" model="hr.departure.reason">
        <field name="name">Cessação no período experimental (art. 18.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">1</field>
    </record>
    <record id="departure_ao_non_renewal" model="hr.departure.reason">
        <field name="name">Caducidade do contrato a termo (art. 17.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">2</field>
    </record>
    <record id="departure_ao_expiry" model="hr.departure.reason">
        <field name="name">Caducidade por facto do empregador (art. 307.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">3</field>
    </record>
    <record id="departure_ao_mutual" model="hr.departure.reason">
        <field name="name">Mútuo acordo (art. 280.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">4</field>
    </record>
    <record id="departure_ao_disciplinary" model="hr.departure.reason">
        <field name="name">Despedimento disciplinar com justa causa (art. 281.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">5</field>
    </record>
    <record id="departure_ao_objective" model="hr.departure.reason">
        <field name="name">Despedimento individual por causas objectivas (art. 284.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">6</field>
    </record>
    <record id="departure_ao_collective" model="hr.departure.reason">
        <field name="name">Despedimento colectivo (art. 290.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">7</field>
    </record>
    <record id="departure_ao_unlawful" model="hr.departure.reason">
        <field name="name">Despedimento ilícito sem reintegração (art. 309.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">8</field>
    </record>
    <record id="departure_ao_constructive" model="hr.departure.reason">
        <field name="name">Rescisão com justa causa pelo trabalhador (art. 303.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">9</field>
    </record>
    <record id="departure_ao_resignation" model="hr.departure.reason">
        <field name="name">Denúncia pelo trabalhador (art. 305.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">10</field>
    </record>
    <record id="departure_ao_abandonment" model="hr.departure.reason">
        <field name="name">Abandono do trabalho (art. 306.º)</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">11</field>
    </record>
    <record id="departure_ao_retirement" model="hr.departure.reason">
        <field name="name">Reforma</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">12</field>
    </record>
    <record id="departure_ao_death" model="hr.departure.reason">
        <field name="name">Morte do trabalhador</field>
        <field name="country_id" ref="base.ao"/>
        <field name="sequence">13</field>
    </record>
</odoo>
