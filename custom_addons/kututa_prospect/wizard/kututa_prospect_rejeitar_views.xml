<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kututa_prospect_rejeitar_view_form" model="ir.ui.view">
        <field name="name">kututa.prospect.rejeitar.form</field>
        <field name="model">kututa.prospect.rejeitar</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="lead_ids" widget="many2many_tags" readonly="1"/>
                    <field name="motivo" placeholder="Ex.: escola pública, sem orçamento próprio"/>
                    <field name="excluir"/>
                </group>
                <footer>
                    <button name="action_rejeitar" string="Rejeitar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
