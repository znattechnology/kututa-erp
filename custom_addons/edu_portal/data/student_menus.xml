<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A Área do Estudante, como a do professor: um painel e as páginas do secPed, cada uma uma acção cliente. -->
    <record id="action_student_home" model="ir.actions.client">
        <field name="name">Painel</field>
        <field name="tag">edu_portal.student_home</field>
    </record>
    <record id="action_student_grades" model="ir.actions.client">
        <field name="name">Minhas notas</field>
        <field name="tag">edu_portal.student_grades</field>
    </record>
    <record id="action_student_schedule" model="ir.actions.client">
        <field name="name">Horário</field>
        <field name="tag">edu_portal.student_schedule</field>
    </record>
    <record id="action_student_exams" model="ir.actions.client">
        <field name="name">Provas</field>
        <field name="tag">edu_portal.student_exams</field>
    </record>
    <record id="action_student_absences" model="ir.actions.client">
        <field name="name">Faltas</field>
        <field name="tag">edu_portal.student_absences</field>
    </record>
    <record id="action_student_internship" model="ir.actions.client">
        <field name="name">O Meu Estágio</field>
        <field name="tag">edu_portal.student_internship</field>
    </record>
    <record id="action_student_project" model="ir.actions.client">
        <field name="name">A Minha PAP</field>
        <field name="tag">edu_portal.student_project</field>
    </record>
    <record id="action_student_fees" model="ir.actions.client">
        <field name="name">Propinas</field>
        <field name="tag">edu_portal.student_fees</field>
    </record>
    <record id="action_student_profile" model="ir.actions.client">
        <field name="name">Meu perfil</field>
        <field name="tag">edu_portal.student_profile</field>
    </record>

    <menuitem id="menu_student_root" name="Área do Estudante" sequence="1" groups="group_edu_student"
              action="action_student_home" web_icon="edu_portal,static/description/icon_student.png"/>
    <menuitem id="menu_student_home" name="Painel" action="action_student_home" parent="menu_student_root" sequence="1"/>
    <menuitem id="menu_student_academic" name="Académico" parent="menu_student_root" sequence="10"/>
    <menuitem id="menu_student_grades" name="Minhas notas" action="action_student_grades" parent="menu_student_academic" sequence="10"/>
    <menuitem id="menu_student_schedule" name="Horário" action="action_student_schedule" parent="menu_student_academic" sequence="20"/>
    <menuitem id="menu_student_exams" name="Provas" action="action_student_exams" parent="menu_student_academic" sequence="30"/>
    <menuitem id="menu_student_absences" name="Faltas" action="action_student_absences" parent="menu_student_academic" sequence="40"/>
    <!-- A formação técnica só aparece aos alunos do ensino técnico (ir.ui.menu._load_menus_blacklist). -->
    <menuitem id="menu_student_training" name="Formação Técnica" parent="menu_student_root" sequence="15"/>
    <menuitem id="menu_student_internship" name="O Meu Estágio" action="action_student_internship" parent="menu_student_training" sequence="10"/>
    <menuitem id="menu_student_project" name="A Minha PAP" action="action_student_project" parent="menu_student_training" sequence="20"/>
    <menuitem id="menu_student_finance" name="Finanças" parent="menu_student_root" sequence="20"/>
    <menuitem id="menu_student_fees" name="Propinas" action="action_student_fees" parent="menu_student_finance" sequence="10"/>
    <menuitem id="menu_student_account" name="Conta" parent="menu_student_root" sequence="30"/>
    <menuitem id="menu_student_profile" name="Meu perfil" action="action_student_profile" parent="menu_student_account" sequence="10"/>
</odoo>
