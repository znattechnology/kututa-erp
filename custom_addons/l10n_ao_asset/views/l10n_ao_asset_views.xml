<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fichas de imobilizado -->
    <record id="l10n_ao_asset_asset_list" model="ir.ui.view">
        <field name="name">l10n_ao_asset.asset.list</field>
        <field name="model">l10n_ao_asset.asset</field>
        <field name="arch" type="xml">
            <list string="Imobilizado" decoration-muted="state in ('close', 'disposed')" decoration-info="state == 'draft'">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="start_date"/>
                <field name="rate" string="Taxa %"/>
                <field name="original_value" sum="Total"/>
                <field name="depreciated_amount" sum="Total"/>
                <field name="book_value" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="l10n_ao_asset_asset_form" model="ir.ui.view">
        <field name="name">l10n_ao_asset.asset.form</field>
        <field name="model">l10n_ao_asset.asset</field>
        <field name="arch" type="xml">
            <form string="Ficha de imobilizado">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_compute_board" type="object" string="Calcular plano" invisible="state != 'draft'"/>
                    <button name="action_post_depreciation" type="object" string="Lançar quotas vencidas" invisible="state != 'open'"/>
                    <button name="action_dispose" type="object" string="Alienar / abater" invisible="state not in ('open', 'close')"/>
                    <button name="action_reset_draft" type="object" string="Voltar a rascunho" invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,close"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_moves" type="object" class="oe_stat_button" icon="fa-bars" string="Lançamentos"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'" placeholder="ex.: Viatura Toyota Hilux LD-12-34"/></h1>
                    </div>
                    <group>
                        <group string="Bem">
                            <field name="code"/>
                            <field name="category_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="invoice_id" invisible="not invoice_id"/>
                            <field name="acquisition_date" readonly="state != 'draft'"/>
                            <field name="start_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Amortização">
                            <field name="rate_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="rate" readonly="state != 'draft'"/>
                            <field name="method_period" readonly="state != 'draft'"/>
                            <field name="low_value" readonly="state != 'draft'"/>
                            <field name="original_value" readonly="state != 'draft'"/>
                            <field name="salvage_value" readonly="state != 'draft'"/>
                            <field name="opening_depreciation" readonly="state != 'draft'"/>
                            <field name="opening_date" readonly="state != 'draft'" invisible="not opening_depreciation"/>
                            <field name="depreciated_amount"/>
                            <field name="book_value"/>
                            <field name="disposal_date" invisible="not disposal_date"/>
                            <field name="disposal_move_id" invisible="not disposal_move_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plano de amortização" name="board">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="depreciated"/>
                                    <field name="remaining"/>
                                    <field name="move_id"/>
                                    <field name="move_state" widget="badge"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_ao_asset_asset_search" model="ir.ui.view">
        <field name="name">l10n_ao_asset.asset.search</field>
        <field name="model">l10n_ao_asset.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <filter name="draft" string="Rascunho" domain="[('state', '=', 'draft')]"/>
                <filter name="running" string="Em uso" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Amortizados / alienados" domain="[('state', 'in', ('close', 'disposed'))]"/>
                <group>
                    <filter name="group_category" string="Categoria" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_ao_asset_asset" model="ir.actions.act_window">
        <field name="name">Imobilizado</field>
        <field name="res_model">l10n_ao_asset.asset</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_running': 1, 'search_default_draft': 1}</field>
    </record>

    <!-- Categorias -->
    <record id="l10n_ao_asset_category_list" model="ir.ui.view">
        <field name="name">l10n_ao_asset.category.list</field>
        <field name="model">l10n_ao_asset.category</field>
        <field name="arch" type="xml">
            <list string="Categorias de imobilizado">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="rate_id"/>
                <field name="rate"/>
                <field name="method_period"/>
                <field name="account_asset_id"/>
                <field name="account_depreciation_id"/>
                <field name="account_expense_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="l10n_ao_asset_category_form" model="ir.ui.view">
        <field name="name">l10n_ao_asset.category.form</field>
        <field name="model">l10n_ao_asset.category</field>
        <field name="arch" type="xml">
            <form string="Categoria de imobilizado">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Amortização">
                            <field name="rate_id" options="{'no_create': True}"/>
                            <field name="rate"/>
                            <field name="method_period"/>
                            <field name="vehicle_limit"/>
                        </group>
                        <group string="Contabilidade">
                            <field name="account_asset_id"/>
                            <field name="account_depreciation_id"/>
                            <field name="account_expense_id"/>
                            <field name="journal_id"/>
                            <field name="auto_create"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ao_asset_category" model="ir.actions.act_window">
        <field name="name">Categorias de imobilizado</field>
        <field name="res_model">l10n_ao_asset.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Taxas legais -->
    <record id="l10n_ao_asset_rate_list" model="ir.ui.view">
        <field name="name">l10n_ao_asset.rate.list</field>
        <field name="model">l10n_ao_asset.rate</field>
        <field name="arch" type="xml">
            <list string="Taxas legais (DP 207/15)">
                <field name="code"/>
                <field name="group"/>
                <field name="name"/>
                <field name="rate"/>
                <field name="life_years"/>
            </list>
        </field>
    </record>

    <record id="l10n_ao_asset_rate_search" model="ir.ui.view">
        <field name="name">l10n_ao_asset.rate.search</field>
        <field name="model">l10n_ao_asset.rate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('group', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_ao_asset_rate" model="ir.actions.act_window">
        <field name="name">Taxas legais de amortização</field>
        <field name="res_model">l10n_ao_asset.rate</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Assistentes -->
    <record id="l10n_ao_asset_disposal_form" model="ir.ui.view">
        <field name="name">l10n_ao_asset.disposal.form</field>
        <field name="model">l10n_ao_asset.disposal</field>
        <field name="arch" type="xml">
            <form string="Alienação / abate">
                <group>
                    <field name="asset_id" readonly="1"/>
                    <field name="disposal_type" widget="radio"/>
                    <field name="date"/>
                    <field name="loss_account_id"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <div class="text-muted">
                    As quotas vão até ao mês (ou ano) anterior ao da alienação ou abate (CII, art. 29.º, n.º 4).
                    Numa venda, emita a factura ao comprador com o proveito em 68.3 (Ganhos em imobilizações).
                </div>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="l10n_ao_asset_report_form" model="ir.ui.view">
        <field name="name">l10n_ao_asset.report.form</field>
        <field name="model">l10n_ao_asset.report</field>
        <field name="arch" type="xml">
            <form string="Mapa de reintegrações e amortizações">
                <group>
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    <field name="year" options="{'format': false}"/>
                </group>
                <footer>
                    <button name="action_print_pdf" type="object" string="PDF" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Excel"/>
                    <button special="cancel" string="Fechar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ao_asset_report" model="ir.actions.act_window">
        <field name="name">Mapa de reintegrações e amortizações</field>
        <field name="res_model">l10n_ao_asset.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Factura de fornecedor: botão para as fichas criadas -->
    <record id="view_move_form_l10n_ao_asset" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ao_asset</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_l10n_ao_assets" type="object" class="oe_stat_button" icon="fa-cubes"
                        invisible="not l10n_ao_asset_count">
                    <field name="l10n_ao_asset_count" widget="statinfo" string="Imobilizado"/>
                </button>
            </div>
        </field>
    </record>

    <!-- Limites fiscais na empresa -->
    <record id="view_company_form_l10n_ao_asset" model="ir.ui.view">
        <field name="name">res.company.form.l10n_ao_asset</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Imobilizado (Angola)" name="l10n_ao_asset" invisible="country_code != 'AO'">
                    <group>
                        <field name="l10n_ao_asset_low_value_limit"/>
                        <field name="l10n_ao_asset_vehicle_limit"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <menuitem id="menu_l10n_ao_asset" name="Imobilizado" parent="account.menu_finance_entries" sequence="60">
        <menuitem id="menu_l10n_ao_asset_asset" action="action_l10n_ao_asset_asset" sequence="10"/>
    </menuitem>
    <menuitem id="menu_l10n_ao_asset_report" action="action_l10n_ao_asset_report" parent="l10n_ao_reports.menu_l10n_ao_reports" sequence="30"/>
    <menuitem id="menu_l10n_ao_asset_config" name="Imobilizado" parent="account.menu_finance_configuration" sequence="40" groups="account.group_account_manager">
        <menuitem id="menu_l10n_ao_asset_category" action="action_l10n_ao_asset_category" sequence="10"/>
        <menuitem id="menu_l10n_ao_asset_rate" action="action_l10n_ao_asset_rate" sequence="20"/>
    </menuitem>
</odoo>
