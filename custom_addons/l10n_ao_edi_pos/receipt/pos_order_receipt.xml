<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_order_receipt_header_l10n_ao_edi" inherit_id="point_of_sale.pos_order_receipt_header">
        <xpath expr="//div[@name='ticket_reference']" position="attributes">
            <attribute name="t-if">not conditions.get('l10n_ao_edi')</attribute>
        </xpath>
        <xpath expr="//div[@name='ticket_reference']" position="before">
            <t t-if="conditions.get('l10n_ao_edi')">
                <div name="l10n_ao_edi_document" t-if="order.get('l10n_ao_edi_receipt_number')" class="text-bold text-large">
                    <t t-out="order['l10n_ao_edi_receipt_title']"/> <t t-out="order['l10n_ao_edi_receipt_number']"/>
                </div>
                <div name="l10n_ao_edi_copy_label" t-if="order.get('l10n_ao_edi_receipt_number')">
                    <t t-out="extra_data.get('l10n_ao_edi_copy_label')"/>
                </div>
                <div name="l10n_ao_edi_provisional" t-if="conditions.get('l10n_ao_edi_provisional')" class="text-bold">
                    DOCUMENTO PROVISÓRIO: NÃO SERVE DE FACTURA
                </div>
                <div class="text-small">Ref. interna <t t-out="order['pos_reference']"/></div>
            </t>
        </xpath>
        <xpath expr="//div[@name='partner_info']" position="after">
            <div name="l10n_ao_edi_consumer" class="w-100 text-center"
                 t-if="conditions.get('l10n_ao_edi') and not partner">
                Consumidor final
            </div>
        </xpath>
    </template>

    <template id="pos_order_receipt_l10n_ao_edi" inherit_id="point_of_sale.pos_order_receipt">
        <xpath expr="//div[@name='before-footer']" position="after">
            <div name="l10n_ao_edi_footer" t-if="conditions.get('l10n_ao_edi')" class="w-100 text-center mt-2 mb-2">
                <t t-if="order.get('l10n_ao_edi_receipt_number')">
                    <div t-if="order.get('l10n_ao_edi_receipt_reference')" class="mb-2">
                        Referente a <t t-out="order['l10n_ao_edi_receipt_reference']"/>
                    </div>
                    <img t-if="image.get('l10n_ao_edi_qr_code')" t-att-src="image['l10n_ao_edi_qr_code']"
                         alt="QR Code AGT" class="mw-50"/>
                    <div class="text-small mt-1">Documento consultável no Portal da AGT</div>
                    <div class="text-bold mt-1" t-if="order.get('l10n_ao_edi_receipt_contingency')">
                        Emitido em contingência, pendente de autorização
                    </div>
                    <div class="text-small mt-1" t-if="company.get('l10n_ao_edi_software_validation_number')">
                        Processado por programa validado n.º <t t-out="company['l10n_ao_edi_software_validation_number']"/>/AGT
                    </div>
                </t>
                <div t-if="conditions.get('l10n_ao_edi_provisional')" class="text-small">
                    Sem ligação ao servidor. O documento fiscal será emitido logo que a ligação seja restabelecida
                    e pode ser pedido na loja.
                </div>
            </div>
        </xpath>
    </template>
</odoo>
