<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edu_enrollment_list" model="ir.ui.view">
        <field name="name">edu.enrollment.list</field>
        <field name="model">edu.enrollment</field>
        <field name="arch" type="xml">
            <list string="Matrículas" decoration-muted="state in ('dropped', 'transferred')" decoration-warning="state == 'irregular'" decoration-info="state == 'draft'">
                <field name="academic_year_id" optional="show"/>
                <field name="class_id"/>
                <field name="order_number"/>
                <field name="student_id"/>
                <field name="enrollment_type" optional="show"/>
                <field name="date" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'irregular'" decoration-danger="state == 'dropped'"/>
            </list>
        </field>
    </record>

    <record id="edu_enrollment_form" model="ir.ui.view">
        <field name="name">edu.enrollment.form</field>
        <field name="model">edu.enrollment</field>
        <field name="arch" type="xml">
            <form string="Matrícula">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar a matrícula" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_irregular" type="object" string="Marcar irregular" invisible="state != 'active'"/>
                    <button name="action_mark_regular" type="object" string="Regularizar" invisible="state != 'irregular'"/>
                    <button name="action_drop_subject" type="object" string="Anular uma disciplina"
                            invisible="state not in ('active', 'irregular') or level_subsystem != 'technical'"/>
                    <button name="action_drop" type="object" string="Anular a matrícula" invisible="state not in ('draft', 'active', 'irregular')"/>
                    <button name="action_reactivate" type="object" string="Reactivar" invisible="state not in ('dropped', 'transferred')"
                            confirm="Reactivar a matrícula? Voltam a aplicar-se as regras da matrícula (vagas, retenções, dívida); a saída anterior fica no histórico."/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed,retained"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not warning"><field name="warning" nolabel="1"/></div>
                    <div class="oe_title"><h1><field name="display_name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="student_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="matricula_number"/>
                            <field name="class_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="academic_year_id"/>
                            <field name="order_number"/>
                        </group>
                        <group>
                            <field name="enrollment_type" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="late_reason" invisible="enrollment_type not in ('new', 'transfer_in')"
                                   readonly="state != 'draft'"/>
                            <field name="previous_enrollment_id" invisible="not previous_enrollment_id"/>
                            <field name="application_id" invisible="not application_id"/>
                            <field name="drop_date" invisible="not drop_date"/>
                            <field name="drop_reason_code" invisible="not drop_reason_code"/>
                            <field name="drop_requested_by" invisible="not drop_requested_by"/>
                            <field name="drop_justified" invisible="state != 'dropped'"/>
                            <field name="drop_exam_right" invisible="not drop_exam_right"/>
                            <field name="drop_reason" invisible="not drop_reason"/>
                            <field name="company_id" invisible="1"/>
                            <field name="level_subsystem" invisible="1"/>
                            <field name="level_class_from" invisible="1"/>
                            <field name="class_number" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="not documents_overdue or documents_complete">
                        Processo de matrícula incompleto há mais de 60 dias (DP 162/23, art. 24.º, n.º 10): falta
                        <field name="documents_missing" class="d-inline"/>. A direcção pode anular a matrícula (anulação
                        oficiosa por processo incompleto).
                    </div>
                    <notebook>
                        <page string="Documentos" name="documents" invisible="not document_ids">
                            <field name="document_ids">
                                <list editable="bottom" create="false" delete="false" decoration-muted="delivered">
                                    <field name="type_id" readonly="1"/>
                                    <field name="delivered"/>
                                    <field name="delivered_date"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <group>
                                <field name="documents_complete"/>
                                <field name="documents_deadline" invisible="documents_complete"/>
                                <field name="documents_overdue" invisible="1"/>
                            </group>
                        </page>
                        <page string="Disciplinas anuladas" name="subject_drops" invisible="not subject_drop_ids">
                            <field name="subject_drop_ids" readonly="1">
                                <list>
                                    <field name="subject_id"/>
                                    <field name="date"/>
                                    <field name="reason"/>
                                </list>
                            </field>
                            <p class="text-muted small">A anulação produz efeitos só nessa disciplina; o aluno pode fazer
                            exame na época normal (Decreto Executivo n.º 60/08, arts. 11.º e 39.º).</p>
                        </page>
                        <page string="Disciplinas" name="subjects">
                            <field name="subject_ids" readonly="state not in ('draft', 'active', 'irregular')">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="component"/>
                                </list>
                            </field>
                        </page>
                        <page string="Na classe anterior" name="lower_subjects" invisible="level_subsystem != 'technical' or class_number &lt;= level_class_from">
                            <field name="lower_subject_ids" readonly="state not in ('active', 'irregular')">
                                <list editable="bottom">
                                    <field name="subject_id" options="{'no_create': True}"/>
                                    <field name="class_id" options="{'no_create': True}"/>
                                    <field name="reason"/>
                                    <field name="academic_year_id" column_invisible="1"/>
                                </list>
                            </field>
                            <p class="text-muted small">Disciplinas de continuação com 6 ou menos valores, ou trienais com
                            duas negativas seguidas, fazem-se numa turma da classe anterior, havendo vaga (Decreto
                            Executivo n.º 60/08, arts. 9.º e 10.º). As notas lançam-se nessa turma.</p>
                        </page>
                        <page string="Notas" name="note"><field name="note" nolabel="1"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="edu_enrollment_search" model="ir.ui.view">
        <field name="name">edu.enrollment.search</field>
        <field name="model">edu.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="matricula_number"/>
                <field name="class_id"/>
                <field name="course_id"/>
                <filter name="enrolled" string="Matriculados" domain="[('state', 'in', ('active', 'irregular', 'completed', 'retained'))]"/>
                <filter name="pending" string="Pendentes" domain="[('state', '=', 'draft')]"/>
                <filter name="irregular" string="Irregulares" domain="[('state', '=', 'irregular')]"/>
                <filter name="left" string="Anulados e transferidos" domain="[('state', 'in', ('dropped', 'transferred'))]"/>
                <separator/>
                <filter name="incomplete" string="Processo incompleto"
                        domain="[('enrollment_type', 'in', ('new', 'transfer_in')), ('documents_complete', '=', False), ('state', 'in', ('active', 'irregular'))]"/>
                <filter name="overdue" string="Processo incompleto há mais de 60 dias" domain="[('documents_overdue', '=', True), ('documents_complete', '=', False)]"/>
                <separator/>
                <filter name="current_year" string="Ano em curso" domain="[('academic_year_id.is_current', '=', True)]"/>
                <group>
                    <filter name="group_class" string="Turma" context="{'group_by': 'class_id'}"/>
                    <filter name="group_course" string="Curso" context="{'group_by': 'course_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_year" string="Ano lectivo" context="{'group_by': 'academic_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_edu_enrollment" model="ir.actions.act_window">
        <field name="name">Matrículas</field>
        <field name="res_model">edu.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current_year': 1, 'search_default_enrolled': 1}</field>
    </record>

    <menuitem id="menu_edu_enrollment" action="action_edu_enrollment" parent="edu_core.menu_edu_students" sequence="5"/>
    <menuitem id="menu_edu_enrollment_renewal" action="action_edu_enrollment_renewal" parent="edu_core.menu_edu_students" sequence="40"/>

    <record id="edu_enrollment_document_type_list" model="ir.ui.view">
        <field name="name">edu.enrollment.document.type.list</field>
        <field name="model">edu.enrollment.document.type</field>
        <field name="arch" type="xml">
            <list string="Documentos da matrícula" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="level_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_edu_enrollment_document_type" model="ir.actions.act_window">
        <field name="name">Documentos da matrícula</field>
        <field name="res_model">edu.enrollment.document.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Os documentos que se entregam na primeira matrícula (DP 162/23, art. 26.º). A confirmação de matrícula
            não exige documentos (art. 27.º, n.º 3).</p>
        </field>
    </record>
    <menuitem id="menu_edu_enrollment_document_type" action="action_edu_enrollment_document_type"
              parent="edu_core.menu_edu_config" sequence="40"/>

    <record id="edu_enrollment_subject_drop_form" model="ir.ui.view">
        <field name="name">edu.enrollment.subject.drop.form</field>
        <field name="model">edu.enrollment.subject.drop</field>
        <field name="arch" type="xml">
            <form string="Anular a matrícula a uma disciplina">
                <group>
                    <field name="enrollment_id" readonly="1"/>
                    <field name="enrollment_subject_ids" invisible="1"/>
                    <field name="subject_id" options="{'no_create': True}"/>
                    <field name="date"/>
                    <field name="reason"/>
                </group>
                <p class="text-muted small">Até ao 5.º dia útil do III trimestre, com efeito só nessa disciplina
                (Decreto Executivo n.º 60/08, art. 11.º); depois disso, só a direcção.</p>
                <footer>
                    <button string="Anular a disciplina" special="save" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
