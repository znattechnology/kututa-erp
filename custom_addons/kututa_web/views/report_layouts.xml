<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- O logótipo de exemplo do Odoo («Your logo») não sai nos documentos: sem logótipo próprio, fica só o nome. -->
    <template id="external_layout_standard" inherit_id="web.external_layout_standard">
        <xpath expr="//td[@t-if='company.logo']" position="attributes">
            <attribute name="t-if">company.logo and not company.uses_default_logo</attribute>
        </xpath>
    </template>
    <template id="external_layout_wave" inherit_id="web.external_layout_wave">
        <xpath expr="//img[@t-if='company.logo']" position="attributes">
            <attribute name="t-if">company.logo and not company.uses_default_logo</attribute>
        </xpath>
    </template>
